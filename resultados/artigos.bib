    url = {https://jurnal.uinsyahada.ac.id/index.php/EEJ/article/view/16563}

}

@article{roni2025enhancing,
    title = {Enhancing English Vocabulary Mastery through Social Media Exposure: A Quasi-Experimental Study of Generation Z Learners},
    author = {Roni and Sam Hermansyah},
    howpublished = {Available at https://e-journal.unimudasorong.ac.id/index.php/interactionjournal/article/download/4713/1831 (2025/12/05)},
    journal = {INTERACTION Jurnal Pendidikan Bahasa},
    year = {2025},
    abstract = {This study investigates the effectiveness of social media exposure in enhancing English vocabulary mastery among Generation Z learners. The rapid growth of digital technology has positioned social media platforms such as TikTok, Instagram, and YouTube as prominent sources of informal language input, particularly for digitally native students. Grounded in the theory of Comprehensible Input, this research examines whether structured exposure to English-language content on social media can significantly improve students’ vocabulary mastery. This study employed a quantitative approach using a quasi-experimental design with a one-group pre-test and post-test model. The participants consisted of 20 Generation Z students from the English Education Department at a regional university in Indonesia. Data were collected through a vocabulary test administered before and after a seven-day social media exposure program, as well as a questionnaire measuring students’ engagement with English-language content on social media. The data were analysed using paired sample t-test and simple linear regression with the assistance of SPSS. The findings revealed a statistically significant improvement in students’ vocabulary mastery after the treatment. The mean score increased from 50.75 in the pre-test to 82.25 in the post-test, with a significance value of 0.000 (p < 0.05). Furthermore, the regression analysis indicated that social media engagement had a significant positive effect on vocabulary mastery, explaining 37.8\% of the variance in post-test scores (R² = 0.378, p = 0.004). These results suggest that higher levels of engagement with English-language content on social media are associated with better vocabulary outcomes. social media exposure can serve as an effective supplementary tool for enhancing English vocabulary mastery among Generation Z learners. When used purposefully, social media provides authentic, multimodal, and contextual language input that aligns with learners’ digital habits and supports vocabulary acquisition beyond the traditional classroom setting.},
    keywords = {Applied psychology, Content analysis, Data collection, Digital media, Digital native, English as a foreign language, English language, English vocabulary, English vocabulary mastery, Generation Z students, Instagram, Linear regression, Mathematics education, Multimethodology, Psychology, Quantitative research, Regression analysis, Repeated measures design, Research design, Sample (material), Sample size determination, Simple linear regression, Social influence, Social media, Social psychology, Test (biology), TikTok, Variance (accounting), Vocabulary, Vocabulary development, YouTube, comprehensible input, digital native students, social media engagement, social media exposure, vocabulary acquisition},
    url = {https://e-journal.unimudasorong.ac.id/index.php/interactionjournal/article/download/4713/1831}

}

@article{deliaputrirahayu2025studi,
    title = {STUDI LITERATUR PEMAANFAATAN MEDIA SOSIAL SEBAGAI SARANA MENINGKATKAN MINAT SISWA SEKOLAH DASAR TERHADAP CERITA RAKYAT},
    author = {Delia Putri Rahayu and Dhea Adela},
    howpublished = {Available at https://jurnalstkipmelawi.ac.id/index.php/JPD/article/view/4537 (2025/12/04)},
    journal = {JURNAL PENDIDIKAN DASAR},
    doi = {10.46368/jpd.v13i2.4537},
    publisher = {Sekolah Tinggi Keguruan dan Ilmu Pendidikan (STKIP) Melawi},
    year = {2025},
    pages = {253–264},
    abstract = {Abstract:  The purpose of this study is to explore various studies that discuss the application of social media in the learning process, particularly as a tool to increase elementary school students' interest in folklore. The research method used was a literature review, analyzing several relevant journals, scientific articles, and research reports from 2021 to 2023. The results of this study indicate that social media can be used as an interactive and engaging learning tool to introduce folklore to elementary school students. Through platforms such as YouTube, Instagram, and TikTok, educators can upload short videos, animations, or digital performances about folklore. This can stimulate curiosity and increase student engagement in cultural literacy activities. It can also be used as a means to increase elementary school students' interest in folklore, given the relatively high level of social media use among elementary school students. Keywords: Social media, Student interest, Folklore Abstrak: Tujuan dari penelitian ini adalah untuk mengeksplorasi berbagai hasil kajian yang membahas penerapan media sosial dalam proses belajar, terutama sebagai alat untuk meningkatkan minat siswa SD terhadap cerita rakyat. Metode penelitian yang diterapkan adalah tinjauan Pustaka (Study Literature)  dengan menganalisis beberapa jurnal, artikel ilmiah, dan laporan penelitian yang relevan dalam rentang waktu 2021 hingga 2023. Hasil penelitian ini menunjukkan bahwa media sosial dapat digunakan sebagai alat pembelajaran yang interaktif dan menarik dalam memperkenalkan cerita rakyat kepada siswa SD. Melalui platform seperti YouTube, Instagram, dan TikTok, para pendidik bisa mengunggah video singkat, animasi, atau pertunjukan digital tentang cerita rakyat yang dapat merangsang rasa ingin tahu dan meningkatkan keterlibatan siswa dalam aktivitas literasi budaya, serta dapat digunakan sebagai sarana meningkatkan minat siswa sekolah dasar pada cerita rakyat, mengingat penggunaan media sosial di kalangan siswa sekolah dasar cukup tinggi. Kata Kunci: Media sosial, Minat siswa, Cerita rakyat},
    keywords = {Art, Curiosity, Digital literacy, Digital media, Folklore, Humanities, Instagram, Literacy, Media literacy, Pedagogy, Psychology, Social life, Social media, Sociology, TikTok, YouTube, cultural literacy, educational videos, elementary school students, folk tales, folklore, social media in education, student engagement, student interest},
    url = {https://jurnalstkipmelawi.ac.id/index.php/JPD/article/view/4537}

}

@article{soniamuhammadalmwalad2025an,
    title = {An Investigation of Social Media Use and Student Engagement in University Classrooms: A Study at Rockford University},
    author = {Sonia Muhammad Almwalad},
    howpublished = {Available at https://mrk.journals.ekb.eg/article_478792.html (2025/12/01)},
    journal = {Mağallaẗ Al-Qirā'aẗ wa Al-Maʿrifaẗ/Mağallaẗ Al-Qirā'aẗ wa Al-Maʿrifaẗ},
    doi = {10.21608/mrk.2025.478792},
    publisher = {Egyptian Knowledge Bank},
    year = {2025},
    pages = {0–0},
    abstract = {تهدف هذه الدراسة إلى فحص العلاقة بين استخدام طلاب المرحلة الجامعية لوسائل التواصل الاجتماعي لأغراض أكاديمية وشخصية ومستوى اندماجهم داخل الصف الدراسي في جامعة روكفورد. ويُفهم اندماج الطلاب بوصفه بُنية متعددة الأبعاد تشمل الاندماج السلوكي، والانفعالي، والمعرفي، في حين يمكن لاستخدام وسائل التواصل الاجتماعي أن يؤدي دورًا أكاديميًا داعمًا أو يمثل عامل تشتيت شخصي. اُستخدم المنهج الكمي الارتباطي في هذه الدراسة، حيث جُمعت البيانات من (46) طالبًا وطالبة من طلاب المرحلة الجامعية في جامعة روكفورد باستخدام منصة PsyToolkit، وذلك من خلال استبيانات التقرير الذاتي التي تقيس استخدام وسائل التواصل الاجتماعي ومستويات الاندماج السلوكي والانفعالي والمعرفي، بهدف دراسة العلاقات بين متغيرات البحث. وتم استخدام الإحصاءات الوصفية وتحليل معامل ارتباط بيرسون لفحص البيانات وتحديد اتجاه وقوة العلاقات بين المتغيرات.أظهرت النتائج أن الاستخدام الأكاديمي لوسائل التواصل الاجتماعي كان مرتبطًا ارتباطًا سلبيًا غير دال إحصائيًا بالاندماج، حيث بلغت قيمة معامل الارتباط r (43) = –.15,، وقيمة الدلالة p = 0.36. في المقابل، كان الاستخدام الشخصي لوسائل التواصل الاجتماعي مرتبطًا ارتباطًا إيجابيًا ودالًا إحصائيًا بالاندماج، حيث بلغت قيمة معامل الارتباط r (44) =.44, ، وقيمة الدلالة p = 0.001. كما أظهرت النتائج أن منصة إنستغرام كانت الأكثر استخدامًا (93.48\%)، تلتها تيك توك (84.78\%) ثم يوتيوب .(\%65.22)ختاما، تشير نتائج الدراسة إلى أن الاستخدام الشخصي لوسائل التواصل الاجتماعي ارتبط بمستويات أعلى من اندماج الطلاب، في حين لم يسهم الاستخدام الأكاديمي في زيادة الاندماج. وبناءً على ذلك، توصي الدراسة بأن يقدم المعلمون إرشادات واضحة للطلاب حول كيفية الاستخدام الأكاديمي الفعّال للتقنيات الرقمية، ومساعدتهم على تنمية مهارات ضبط الذات عند استخدام وسائل التواصل الاجتماعي داخل الصف الدراسي. This study examines the relationship between undergraduate students’ academic and personal use of social media and their classroom engagement at Rockford University. Student engagement is understood as a multidimensional construct that includes behavioral, emotional, and cognitive components, while social media use can function as either an academic tool or a personal distraction. A quantitative correlational study approach was used, with data collected from 46 undergraduate students from Rockford University, using PsyToolkit, utilizing self-report surveys investigating social media use and behavioral, emotional, and cognitive engagement to examine the relationships among the study variables. Descriptive statistics and Pearson correlation analysis were used to examine the data to determine the direction and degree of correlations between the variables. The results showed that academic social media use was negatively but not significantly related to engagement, r (44) = –.15, p = .36. Personal use was positively and significantly related to engagement, r (44) =.44, p = .001. Instagram was the most used platform (93.48\%), followed by TikTok (84.78\%) and YouTube (65.22\%). In conclusion, personal social media use was associated with higher engagement, whereas academic use did not increase engagement. It is recommended that educators provide students with clear instructions on how to use academic technology and help them develop self-control when engaging with social media in the classroom.},
    keywords = {Computer science, Context (archaeology), Customer engagement, Electronic learning, Engineering ethics, Higher education, Instagram, Knowledge management, Mathematics education, Media studies, Medical education, Pedagogy, Psychology, Public engagement, Public relations, Qualitative research, Social media, Sociology, Student activities, Student engagement, Student life, TikTok, Undergraduate student, YouTube, classroom engagement, social media in education, social media use, student engagement, university students},
    url = {https://mrk.journals.ekb.eg/article_478792.html}

}

