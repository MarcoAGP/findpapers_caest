@article{pinkysaxena2025international,
    title = {International Journal of Multi Research - Advancing Methodological Thinking},
    author = {Pinky Saxena},
    howpublished = {Available at https://www.allmultiresearchjournal.com/articles_search?search_key=Multi+%3A+2-1-3 (2025/01/01)},
    journal = {International Journal of Multi Research},
    doi = {10.54660/ijmr.2026.2.1.14-19},
    publisher = {Anfo Publication House},
    year = {2025},
    pages = {14–19},
    abstract = {The rapid growth of social media has significantly transformed the educational landscape, influencing the ways students and educators communicate, collaborate, and access information. Social media platforms such as Facebook, YouTube, WhatsApp, Instagram, and academic networking sites have emerged as powerful tools for learning, offering opportunities for knowledge sharing, interactive learning, and academic collaboration beyond traditional classroom boundaries. When used constructively, social media enhances student engagement, promotes collaborative learning, supports self-directed study, and provides quick access to educational resources. However, excessive and unregulated use of social media can negatively impact academic performance by causing distractions, reducing concentration, encouraging procrastination, and exposing students to misinformation and cyber-related risks. This dual nature raises an important question: Is social media a friend or a foe in education? This study examines both the positive and negative impacts of social media on the teaching–learning process, highlighting its role in academic development as well as the challenges it poses. The findings suggest that social media can be a valuable educational ally when used responsibly, with proper guidance, digital literacy, and institutional policies, but it may become detrimental if misused or overused. Therefore, a balanced and purposeful integration of social media into education is essential to maximize its benefits while minimizing its drawbacks.},
    keywords = {Academic Publication, Computer-mediated communication, Digital media, Dual (grammatical number), Educational technology, Face (sociological concept), Higher education, International Journal, Internet privacy, Media relations, Misinformation, Multi Research, Prahi Production, Psychology, Public relations, Research Methods, Social influence, Social media, Sociology, academic performance, cooperative learning, cybersecurity risks, digital literacy, distraction, misinformation, procrastination, self-directed learning, social media in education, student engagement, teaching-learning process},
    url = {https://www.allmultiresearchjournal.com/articles_search?search_key=Multi+%3A+2-1-3}

}

@article{norzaitolakmaabdulsamad2025learners,
    title = {Learners’ perceptions of vocabulary improvement through social media engagement with global issues},
    author = {Nor Zaitolakma Abdul Samad and Nuruladilah Mohamed and Nurhafizah Ali and Azman Che Mat},
    howpublished = {Available at https://ir.uitm.edu.my/id/eprint/136337/1/136337.pdf (2025/01/01)},
    journal = {UiTM Institutional Repositories (Universiti Teknologi MARA)},
    doi = {10.24191/cplt.v13i3.7494},
    year = {2025},
    abstract = {Social media has become a dominant platform of informal learning, where students’ engagement with global issues significantly influences vocabulary development. This study investigates learners’ perceptions of vocabulary improvement through their interaction with social media discussions of current issues. A quantitative survey was administered to 129 diploma students from three faculties at UiTM Dungun, Terengganu. The questionnaire examined students’ preferred social media platforms, their awareness of global issues, and their recognition of vocabulary items frequently encountered online. The findings indicate that Instagram, TikTok, and YouTube were the most commonly used platforms and that students reported high awareness of global issues such as the Israel–Palestine conflict. Vocabulary recognition patterns demonstrate not only incidental learning but also learners’ ability to contextualize new terms within global discourses, echoing findings that informal digital spaces significantly foster incidental vocabulary growth. The study concludes that social media can be integrated as an informal but valuable complement to classroom vocabulary learning, while it stresses the importance of pedagogical strategies to bridge informal and formal learning environments.},
    keywords = {Bridge (graph theory), Complement (music), Digital media, Digital native, English as a foreign language, English vocabulary, Formal learning, Globalization, Informal learning, Instagram, Israeli-Palestinian conflict, Pedagogy, Perception, Psychology, Social media, Social psychology, Social relation, TikTok, Vocabulary, Vocabulary development, YouTube, global challenges, incidental vocabulary learning, informal learning, learner perceptions, online discourse, social media, vocabulary acquisition, vocabulary recognition},
    url = {https://ir.uitm.edu.my/id/eprint/136337/1/136337.pdf}

}

@article{syafaruddinmarpaung2024engaging,
