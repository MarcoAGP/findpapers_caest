    howpublished = {Available at https://worldlyjournals.com/index.php/IJSR/article/view/13456 (2025/07/01)},
    journal = {International journal of scientific researchers ( IJSR ) INDEXING},
    year = {2025},
    abstract = {This study explores the impact of gamification on English language learning through the use of social media platforms. Drawing from current literature, it highlights how game-like elements such as points, badges, leaderboards, and interactive challenges can significantly increase student engagement, motivation, and participation in online language learning. Social media platforms like Instagram, Telegram, and YouTube provide flexible, interactive environments where learners can practice English in meaningful, enjoyable contexts. The discussion also addresses potential drawbacks, such as overemphasis on competition and distraction. Overall, the findings suggest that when thoughtfully applied, gamification can enhance the effectiveness of social media-based English language instruction and promote more autonomous, motivated learners.},
