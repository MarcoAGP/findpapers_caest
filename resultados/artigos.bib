@article{andreatsputrid2020advertising,
    title = {Advertising Development Process for International Education Fair (Australia) 2020 to Obtain Engagements of Artha Study (AS) Student Services},
    author = {Andrea Ts Putri D and S.Pd. Yohana Ika Harnita Sari},
    howpublished = {Available at http://etd.repository.ugm.ac.id/penelitian/detail/186990 (2020/01/01)},
    year = {2020},
    abstract = {Tugas akhir ini bertujuan untuk mendeskripsikan profil Artha Study (AS) Student Services dan proses pembuatan iklan untuk acara International Education Fair (Australia) 2020 untuk mendapatkan engagement dari audiens AS Student Services. Adapun metode penelitian yang digunakan adalah dengan metode penelitian kualitatif, yaitu studi lapangan dan studi pustaka. Studi lapangan dilakukan melalui observasi langsung pada saat masa magang dari 13 Januari sampai dengan 13 Maret 2020. Kemudian, melakukan wawancara dengan Christopher Gunawan sebagai Manajer AS Student Services Yogyakarta dan Revalia Noer Hanifah sebagai Marketing Officer AS Student Services. Untuk studi pustaka dilakukan dengan melakukan penelitian perpustakaan, yaitu membaca beberapa buku cetak, buku digital, jurnal, dan situs web. Tahapan proses pembuatan iklan untuk acara International Education Fair (Australia) 2020, yaitu merencanakan dan mensurvei platform media, menghubungi platform media yang ada pada daftar, menyusun dan memutuskan platform media yang dipilih, membuat konten iklan, dan mengevaluasi platform media iklan.  Platform media iklan yang digunakan adalah Prambors radio, iklan spanduk/baliho, poster, Instagram Ads, kolaborasi influencer, dan MyAds Telkomsel. Hasil dari engagement yang telah didapatkan AS Student Services melalui iklannya dapat dilihat melalui insight di Instagram karena dari data Google Form diketahui bahwa sebagian besar audiens mengetahui acara tersebut melalui Instagram Ads. AS Student Services telah berhasil memenuhi target dalam mendapatkan engagement dari siswa sekolah menengah. Engagement yang didapatkan mengalami kenaikan menjadi 1.448 engagements (267 Likes, 722 Profile Visits, and 459 Reach). This graduating paper aims to describe the profile of Artha Study (AS) Student Services and advertising development process for International Education Fair (Australia) 2020 to obtain engagements from AS Student Services targeted audience. The research method used was qualitative research method through field study and library study. The field study was carried out through direct observation during the internship period from January 13th until March 13th, 2020. Moreover, it was also carried out through direct interview with Christopher Gunawan as the Branch Manager of AS Student Services Yogyakarta and Revalia Noer Hanifah as the Marketing Officer of AS Student Services. For the library study, it was conducted by doing the library research such as reading some printed books, digital books, journals, and websites. The steps for the advertising development process for International Education Fair (Australia) 2020 are planning and surveying media platform, contacting the listed media platform, organizing and deciding the chosen media platform, creating the advertisement content, and evaluating the advertising media platform. The chosen media platform are Prambors radio, outdoor advertising, printed posters, Instagram Ads, influencer collaboration, and MyAds Telkomsel. The engagement results obtained by AS Student Services through the advertisements can be seen from the Instagram insights because the Google Form data showed that mostly the audience knew the event through the Instagram Ads. Finally, AS Student Services had succeeded in fulfilling the target of engagement from high school students as the targeted audience. The obtained engagement had increased to 1.448 engagements (267 Likes, 722 Profile Visits, and 459 Reach).},
    keywords = {AS Student Services, Advertisement, Advertising, Art, Business, Education Fair, Humanities, Instagram advertising, Political science, Social Media, Yogyakarta, advertising development, advertising evaluation, audience engagement, audience insights, event advertising, high school students, influencer collaboration, poster advertising},
    url = {http://etd.repository.ugm.ac.id/penelitian/detail/186990}

}

@article{jeremyadetayo2025university,
    title = {University Students’ Social Media Habits and Relationship Building},
    author = {Jeremy Adetayo and Racheal Olufunmilola Dada and Mufutau Ayobami Asiru},
    howpublished = {Available at https://www.ajol.info/index.php/iijikm/article/view/302682 (2025/08/06)},
    journal = {Information Impact: Journal of Information and Knowledge Management},
    doi = {10.4314/iijikm.v16i1.1},
    publisher = {African Journals Online (AJOL)},
    year = {2025},
    pages = {1–14},
    abstract = {This study examined the relationship between university students’ social media status update checking behaviors and the types of relationships they seek. A quantitative, cross-sectional survey design was employed to explore how different relationship preferences influence social media engagement. The population comprised all 3,457 students, out of which a sample of 691 students was selected using simple random sampling, representing 20\% of the population. Data were collected using a structured questionnaire developed through a literature review and expert validation. Data analysis was conducted using SPSS, where descriptive statistics summarized usage patterns, and multiple regression analysis identified predictors of social media checking frequency. WhatsApp was the most frequently checked platform, followed by TikTok and Instagram. Findings revealed that seeking friendships, dating, and intimate relationships significantly predicted increased status update checking behavior, whereas professional relationship seeking did not. The study concludes that personal relationship pursuits are key motivators for frequent social media engagement. It is recommended that student support services and educators consider the social motives behind media use when developing digital literacy or wellness programs.},
    keywords = {Advertising, Business, Instagram, Marketing, Psychology, TikTok, WhatsApp, dating, digital literacy, intimate relationships, professional relationships, relationship building, relationship preferences, social media engagement, social media use, student well-being, university students},
    url = {https://www.ajol.info/index.php/iijikm/article/view/302682}

}

@article{alhailmaryam2026from,
    title = {From following to caring and acting: analyzing social media's role in shaping mindsets and transforming habits for sustainable living},
    author = {Al-Hail, Maryam and Fekih Zguir, Mariem and Koç, Muammer},
    howpublished = {Available at https://www.frontiersin.org/journals/education/articles/10.3389/feduc.2026.1947733/full (2026/10/19)},
    journal = {Frontiers in Education},
    doi = {10.3389/feduc.2026.1947733},
    publisher = {Frontiers Media SA},
    year = {2026},
    pages = {1947733},
    abstract = {The urgency for sustainable consumption underscores the need to disseminate sustainability knowledge and promote environmentally responsible habits across societies. Due to its broad reach, social media has the potential to promote sustainable consumption by influencing habits and increasing environmental awareness. In this study, we investigate the role of social media through the design and strategic use of an Instagram account, WeSustainQtr, which aimed to disseminate sustainability knowledge and encourage sustainable consumption practices in Qatar and similar settings, through culturally relevant and solution-oriented content. Emphasizing a multi-theoretical framework through systematic and empirical qualitative research approach, we triangulated between secondary data from a scoping review and primary data of 420 initial survey and 415 post-course interaction survey responses. Baseline sustainability awareness was assessed through an initial survey, while the subsequent survey explored participants’ perceptions of sustainability and self-reported behaviors following their engagement with the account contents. Because responses could not be matched at the individual level, observed differences are interpreted as group-level patterns rather than evidence of individual behavioral change. Participants reported adopting a range of sustainable practices— from reducing single-use plastics and household energy consumption, to recycling — into the tapestry of their daily lives, with some reported influencing sustainability practices within their social circles. Findings suggest that social media can be used as a potential platform for sustainability education and user engagement by supporting knowledge sharing and collective participation. Reported engagement suggest that tailored implementations that introduced options for private participation and recognized culturally valuable themes may support followers’ engagement while also aligning with local norms towards privacy in the culturally sensitive context of Qatar and similar contexts. The findings also provide practical insights for integrating similar approaches into higher education curricula through structured learning activities that can encourage meaningful student engagement and behavioral change.},
    keywords = {Baseline (sea), Behavior change, Business, Consumption (sociology), Dissemination, Empirical evidence, Empirical research, Environmental resource management, Implementation, Instagram, Knowledge management, Knowledge sharing, Marketing, Perception, Political science, Psychology, Public engagement, Public relations, Qatar, Qualitative property, Qualitative research, Social engagement, Social media, Social practice, Social psychology, Social sustainability, Sociology, Survey data collection, Sustainability, Sustainability science, Sustainable consumption, Sustainable development, Sustainable living, behavior change, behavioral change, cultural relevance, environmental awareness, higher education curriculum, household energy consumption, privacy norms, recycling, single-use plastic reduction, social media, sustainability, sustainability education, sustainable consumption, sustainable habits, transformative learning},
    url = {https://www.frontiersin.org/journals/education/articles/10.3389/feduc.2026.1947733/full}

}

@article{marinagalioto2026from,
    title = {From classroom event to networked visibility: audience amplification and the limits of relational embedding in higher education},
    author = {Marina Galioto and Alberto Trobia and Antonella D’Amico and Stefano A. Ruggieri and Antonino Bianco},
    howpublished = {Available at https://www.frontiersin.org/journals/education/articles/10.3389/feduc.2026.1928804/full (2026/10/14)},
    journal = {Frontiers in Education},
    doi = {10.3389/feduc.2026.1928804},
    publisher = {Frontiers Media SA},
    year = {2026},
    pages = {1928804},
    abstract = {Students' engagement and sense of belonging are increasingly shaped in settings where classroom experience and digital interaction overlap – what Floridi calls the “onlife” condition, in which online and offline life form a single continuum. This article examines one such episode. A well-known Italian influencer took part in the closing session of a university course, and the Department then narrated the visit through its official Instagram and Facebook accounts. We ask whether the visibility that those posts generated and students’ relational participation in the Department's online community are the same outcome or two different ones. To answer, we analysed two kinds of data: the engagement statistics that the platform reports for the Department's account and for the post and reel published on the day of the visit, each with its observation window and baseline; and the network of accounts that commented on, replied to or mentioned one another in the Department's posts, which we mapped with the NodeXL software. The platform data show a large but short-lived increase in visibility: on the day of the event the account recorded 5,885 views against a baseline of 465, three quarters of them from accounts that did not follow the Department, and two thirds of the week's profile visits and net follower growth fell in the forty-eight hours of the visit. The network data show almost no corresponding movement. The guest's account is connected to only two other accounts, and its betweenness centrality – a measure of how often an account lies on the shortest paths between other accounts, and therefore of its bridging role – derives entirely from a single tie. Ten of the 232 recorded edges date from the day of the event, and the event posts drew comments from only two accounts besides the guest's. Audience amplification and relational embedding thus emerge as distinct outcomes of the same intervention. The study does not measure subjective belonging directly; it identifies behavioural and structural proxies of belonging-related engagement and proposes a replicable two-layer approach in which the divergence between the layers is itself informative.},
    keywords = {Ask price, Baseline (sea), Betweenness centrality, Centrality, Closing (real estate), Computer science, Embedding, Event (particle physics), Facebook, Higher education, Instagram, Internet privacy, Margin (machine learning), Mode (computer interface), Multimedia, Online and offline, Online community, Outcome (game theory), Psychology, Reading (process), Sense of community, Session (web analytics), Social network (sociolinguistics), Social network analysis, Test (biology), Visibility, Window (computing), World Wide Web, Zhàng, audience engagement, betweenness centrality, higher education, higher education communication, institutional social media, onlife, onlife perspective, platform analytics, prosumer, relational embedding, school belonging, social network analysis, student belonging, students' engagement, university social media},
    url = {https://www.frontiersin.org/journals/education/articles/10.3389/feduc.2026.1928804/full}

}

@misc{norrafidamohdseni2026digital,
    title = {DIGITAL DIALOGUES: STRENGTHENING ESL SPEAKING SKILLS THROUGH SOCIAL MEDIA INTERGRATION},
    author = {Nor Rafida Mohd Seni},
    howpublished = {Available at https://zenodo.org/records/23054428 (2026/09/30)},
    doi = {10.5281/zenodo.23054427},
    year = {2026},
    abstract = {This study aims to identify the social media platforms most frequently used by tertiary-level students and to examine their impact on English as a Second Language (ESL) speaking proficiency. As educators increasingly move beyond traditional teaching methods, the integration of social media into language instruction has emerged as a promising approach to enhance student engagement and participation. Using a quantitative design, a survey was administered to 88 students to explore their perceptions of social media in improving speaking skills. Findings reveal that platforms such as WhatsApp, Telegram, YouTube, Instagram, and Facebook are widely used and positively influence students’ speaking development. A majority of respondents reported that social media significantly supports their speaking development by encouraging interaction, improving confidence, and facilitating the exchange of ideas and information in English. Social media also provides access to real-time information and opportunities for meaningful interaction, which enhance language exposure and practice. In conclusion, this study highlights the potential of social media as an effective pedagogical tool in enhancing ESL speaking skills. Its integration into language learning can create more engaging, relevant, and communicative learning experiences that align with students’ digital lifestyles and support their overall language development.},
    keywords = {Computer science, Computer-mediated communication, Digital media, Digital native, Educational technology, English as a second language, English language, Facebook, Instagram, Language acquisition, Language education, Language proficiency, Learner autonomy, Mathematics education, On Language, Pedagogy, Perception, Psychology, Social media, Sociology, WhatsApp, YouTube, digital communication, social media in language learning, speaking proficiency, student engagement, student perceptions, telegrams, tertiary students},
    url = {https://zenodo.org/records/23054428}

}

@article{sudarmonosudarmono2026leveraging,
    title = {Leveraging Instagram Stories for EFL Learners’ Syntactic Acquisition: A Quasi-Experimental Study on Engagement and Learning Outcomes},
    author = {Sudarmono Sudarmono},
    howpublished = {Available at https://joecy.org/index.php/joecy/article/download/14661/11625 (2026/09/30)},
    journal = {Journal of Innovative and Creativity (Joecy)},
    doi = {10.31004/joecy.v6i2.14661},
    year = {2026},
    abstract = {This study aimed to investigate the effectiveness of Instagram Stories as a learning medium to enhance EFL learners’ syntactic competence. Employing a quasi-experimental mixed-methods design, this research involved 50 students from the Islamic Education Study Program at the Institute of Islamic Studies Nahdlatul Ulama Bangil. Participants were divided into an experimental group that received grammar instruction via Instagram Stories and a control group that received conventional instruction. Data were collected through pre-tests, post-tests, and semi-structured interviews. The quantitative results showed that the experimental group achieved a significantly higher improvement in post-test scores, from 55.3 to 78.6, compared to the control group, with a large effect size. The qualitative analysis revealed three main themes: student engagement, learning motivation, and usability. Participants reported that the visual and interactive features of Instagram Stories increased their interest in learning grammar, provided flexibility in accessing materials, and supported independent learning. The findings suggest that Instagram Stories can serve as an effective instructional medium for teaching basic grammar to digital-native EFL learners. The success of this medium aligns with Multimedia Learning Theory, Engagement Theory, and Dual Coding Theory. It is recommended that educators provide flexibility to learn independently by integrating familiar social media platforms into language instruction to create a more interactive and student-centered learning environment.},
    keywords = {Action research, Coding (social sciences), Computer science, Computer-Assisted Instruction, Control (management), Discourse analysis, EFL grammar instruction, Educational technology, English grammar, Flexibility (engineering), Grammar, Instagram Stories, Islam, Islamic education students, Language acquisition, Mathematics education, Multimedia, Pedagogy, Protocol analysis, Psychology, Qualitative analysis, Qualitative property, Qualitative research, Social media, Teaching method, Treatment and control groups, digital-native learners, dual coding theory, engagement theory, multimedia learning theory, self-directed learning, social media in language teaching, student engagement, student motivation, syntactic competence},
    url = {https://joecy.org/index.php/joecy/article/download/14661/11625}

}

@article{sapanapradhan2026the,
    title = {The Role of Social Media in Enhancing Learning Outcomes: A Case Study of Shree Tribhuvan Secondary School, Dailekh, Nepal},
    author = {Sapana Pradhan},
    howpublished = {Available at https://www.nepjol.info/index.php/jmc/article/view/99357 (2026/08/26)},
    journal = {Journal of Musikot Campus.},
    doi = {10.3126/jmc.v4i1.99357},
    publisher = {Nepal Journals Online (JOL)},
    year = {2026},
    pages = {213–224},
    abstract = {Social media is used increasingly by students all around the world, which is shifting the way they access information, contact with friends and join in academic activities. This research study is an attempt to examine the usage of social media in learning procedure of the students of Shree Tribhuvan Janata Secondary School, Dailekh district of Karnali Province, Nepal with special reference to its efficiency, educational advantages and issues. This study employed a mixed method research technique, standardized and structured questionnaires were used to collect quantitative as well as qualitative data from 100 secondary level students and 20 teachers of the school. Qualitative data were gathered through focus group interviews, discussions and recorded document analysis. The results show that the students of the school regularly use platforms such as YouTube, Facebook, Instagram, TikTok and WhatsApp for free time and leisure period, academic objectives; such as gaining information, cooperative learning and accessing educational resource and materials. Social media can improve students’ engagement, inspiration and self-directed education and learning, but there are challenges such as variation of access to tools, technology, distraction, misrepresentation and concerns about safety on the internet and its privacy. The study suggests that social media can be a positive educational tool, provided the suitable direction, digital literacy and institutional support. The research presents empirical evidence towards the function of social media in classroom learning especially in rural and resource limited educational scenarios.},
    keywords = {Data collection, Digital media, Educational Technology, Educational research, Educational resources, Educational technology, Empirical research, Engagement Collaboration, Focus group, Information and Communications Technology, Learning Digital Literacy, Learning Student, Literacy, Media literacy, Medical education, Misrepresentation, Multimethodology, New media, Online discussion, Pedagogy, Psychology, Public relations, Qualitative property, Qualitative research, Resource (disambiguation), Semi-structured interview, Social Media, Social media, Sociology, The Internet, access to technology, digital literacy, educational technology, high school students, learning outcomes, online privacy, online safety, rural education, self-directed learning, social media in education, student engagement},
    url = {https://www.nepjol.info/index.php/jmc/article/view/99357}

}

@article{sitiistiarinda2026pemanfaatan,
    title = {Pemanfaatan Media Sosial sebagai Media Pembelajaran Pendidikan Agama Islam Berbasis Literasi Digital: Studi di SMP Al-Muttaqin},
