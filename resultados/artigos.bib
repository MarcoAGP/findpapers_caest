@article{laranardibaroni2026undergraduate,
    title = {Undergraduate interest in vaccines: insights from the “Adopt a Bacterium” active learning methodology in the post-COVID-19 Period},
    author = {Lara Nardi Baroni and Nicole Gonçalves Picinin and Carolina Diorio Nastaro and Sandro R. Marana and Ana Carolina Ramos Moreno and Rita de Cássia Café Ferreira},
    howpublished = {Available at https://www.tandfonline.com/doi/full/10.1080/00219266.2026.2628790 (2026/01/01)},
    journal = {Journal of Biological Education},
    doi = {10.1080/00219266.2026.2628790},
    publisher = {Informa UK Limited},
    year = {2026},
    pages = {1036–1049},
    abstract = {Although vaccines gained visibility during the pandemic, student engagement has not persisted. Here, we explore how biomedical students engaged with vaccine content versus other microbiology topics using the ‘Adopt a Bacterium’ active learning methodology, which integrates social media-based science communication. Between 2022 and 2024, students worked in groups to ‘adopt’ either Mycobacterium tuberculosis or the Streptococcus genus, both relevant to immunisation programmes. They created posts on private Instagram, which were analysed using the Shannon Diversity Index, word cloud analysis, and semantic networks generated with KH Coder. Results revealed a decline in vaccine-related content in 2024 for the M. tuberculosis group and in 2023 for the Streptococcus group, despite stable engagement with traditional microbiology topics. This may reflect fatigue and the complexity of the vaccine topic. This decline highlights the need for focused vaccine education. Beyond fostering collaborative learning, the ‘Adopt a Bacterium’ methodology also proves effective as a diagnostic tool for tracking shifts in student interest, scientific perception, and engagement with socially relevant themes. By combining active learning with thematic analysis, this study offers a novel lens for monitoring educational engagement and reinforces the need for curricular strategies that frame vaccines as socially embedded scientific issues, not merely technical content.},
    keywords = {Active learning (machine learning), Authentic learning, Computer science, Educational research, Experiential learning, Higher education, Instagram, Mathematics education, Medical education, Mycobacterium tuberculosis, Pedagogy, Period (music), Problem-based learning, Psychology, Research methodology, Science education, Secondary education, Streptococcus, Teaching method, Vaccines, active learning, biomedical students, immunization programs, microbiology education, post-COVID-19, scientific discourse analysis, social media, student fatigue, undergraduate engagement, undergraduate student engagement, vaccine education},
    url = {https://www.tandfonline.com/doi/full/10.1080/00219266.2026.2628790}

}

@inbook{neetusinghsatsangi2026integrating,
    title = {Integrating Social Media in Business Education for Entrepreneurial Skill Development},
