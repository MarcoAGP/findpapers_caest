@article{bonettifederico2026engaging,
    title = {Engaging Teenagers in Cyberbullying Prevention: Insights from a Digital Toolkit},
    author = {Bonetti, Federico and Palmero Aprosio, Alessio and Piras, Enrico Maria and Tonelli, Sara},
    howpublished = {Available at https://link.springer.com/article/10.1007/s10758-026-10008-5 (2026/01/01)},
    journal = {Technology, Knowledge and Learning},
    doi = {10.1007/s10758-026-10008-5},
    publisher = {Springer Science and Business Media LLC},
    year = {2026},
    pages = {1–40},
    abstract = {Abstract Diverse and multi-faceted approaches are needed to combat cyberbullying, given the different platforms and applications used daily by teenagers, from image- and video-based social media to chat applications and video games. While existing contributions often employ social media-inspired applications to engage teenagers, they typically evaluate a single tool in isolation. This leaves a critical gap in understanding how different technological affordances uniquely impact adolescent engagement, motivation, and empathy. In this work, we present the evaluation of a novel digital platform that integrates three different tools, a chat-based role-playing activity, an Instagram-like application, and a 3D serious game, orchestrated via an educator dashboard. Evaluated with 244 students aged 11–17, the study assessed interest, perceived appropriateness, and intrinsic motivation against a baseline of self-reported empathy. Grounded in the theoretical frameworks of New Childhood Studies and Brave Spaces, our comparative analysis reveals that design mechanics inherently carry demographic and psychological biases. Notably, real-time, text-based role-playing acts as a pedagogical equaliser, effectively engaging teenagers regardless of age, gender, or baseline empathy. Conversely, engagement in image-based feeds and action-oriented games is heavily dependent on age and gender, respectively, and largely appeals to already empathetic individuals. Empirical findings are abstracted into 5 explicit, transferable design principles intended to guide developers and educators in creating inclusive, theoretically grounded digital environments for cyberbullying education.},
    keywords = {Awareness raising, Creativity and Arts Education, Cyberbullying, Digital tools, Educational Technology, Learning and Instruction, Role-play, Science Education, Serious games, User engagement},
    url = {https://link.springer.com/article/10.1007/s10758-026-10008-5}

}

@article{sukidin2026generational,
    title = {Generational cohort theory and tourism literacy: Understanding Gen-Z's role in sustainable village tourism development},
    author = {Sukidin and Na'im, Mohamad and Wulandari, Putri and Rachmawati, Sela and Putri, Chamelia and Safitri, Dhira Ervina},
    howpublished = {Available at https://journals.sagepub.com/doi/10.1177/13567667261483289 (2026/01/01)},
    journal = {JOURNAL OF VACATION MARKETING},
    doi = {10.1177/13567667261483289},
    publisher = {SAGE Publications},
    year = {2026},
    abstract = {The present study explores Generation Z's (Gen-Z’s) perceptions, motivations, and participation in village tourism, emphasizing the role of tourism literacy. Drawing on generational cohort theory and thematic analysis of interviews with 50 participants in Banyuwangi, Indonesia, the research examines how Gen-Z characteristics shape engagement in rural tourism. The findings reveal that digital nativeness, social connectivity, experiential learning preferences, and sustainability awareness encourage participation beyond tourism consumption toward active promotion, cultural preservation, and environmental stewardship. Participants use digital platforms such as Instagram, TikTok, YouTube, and Smart Kampung to promote destinations, while educational and institutional programs strengthen tourism literacy through interactive learning. Gen-Z also contributes to local festivals, tourism ambassador programs, and environmental initiatives. The study advances existing knowledge by demonstrating that tourism literacy serves as a key mechanism linking generational characteristics to meaningful participation in village tourism. It extends generational cohort theory by highlighting literacy-driven capacities that position Gen-Z as cocreators of sustainable tourism and community development.},
    keywords = {Gen-Z, generational cohort theory, thematic analysis, tourism literacy, village tourism},
    url = {https://journals.sagepub.com/doi/10.1177/13567667261483289}

}

@article{kurtidileren2026adaptation,
    title = {Adaptation of Parasocial Relationships in Social Media Scale: its association with loneliness, social media use and life satisfaction},
    author = {Kurt, Idil Eren and Bulut-Ateş, Fatoş and Doğanülkü, Hacı Arif},
    howpublished = {Available at https://www.frontiersin.org/journals/psychology/articles/10.3389/fpsyg.2026.1814389/full (2026/01/01)},
    journal = {FRONTIERS IN PSYCHOLOGY},
    doi = {10.3389/fpsyg.2026.1814389},
    publisher = {Frontiers Media SA},
    year = {2026},
    pages = {1814389},
    abstract = {The advancement of digital technologies, particularly social media, has significantly altered the dynamics of connection formation, making the study of parasocial relationships highly relevant. This study analyzed the psychometric properties of the Parasocial Relationships in Social Media Scale (PRISM-TR) within a Turkish sample group. The research involved two distinct sub-studies utilizing different samples. Study I ( N = 428 university students) employed comprehensive psychometric methods, including Confirmatory Factor Analysis (CFA), Item Response Theory (IRT), and reliability analyses, to support the scale’s four factor structure, internal consistency, and measurement invariance across gender. Study II ( N = 674 students) investigated the interplay between the variables by testing a serial mediation model. The findings revealed that loneliness significantly predicts parasocial relationships, a connection that is serially mediated by social media use and life satisfaction. Collectively, these results validate the PRISM-TR scale’s effectiveness for evaluating parasocial relationships in this context while simultaneously highlighting the complex sequential influence of digital media engagement and life satisfaction factors in shaping these modern bonds. The findings carry important implications for psychological counseling and digital literacy programs targeting young adults.},
    keywords = {PRISM-TR, life satisfaction, loneliness, parasocial relationships, social media, social media use},
    url = {https://www.frontiersin.org/journals/psychology/articles/10.3389/fpsyg.2026.1814389/full}

}

@article{whiteclaire2026uk,
    title = {UK farmers opinions and challenges regarding fitness for transport and emergency slaughter},
    author = {White, Claire and Murdoch, Jenna and Napier, Erin and Garcia-Ara, Amelia},
    howpublished = {Available at https://www.frontiersin.org/journals/animal-science/articles/10.3389/fanim.2026.1827413/full (2026/01/01)},
    journal = {FRONTIERS IN ANIMAL SCIENCE},
    doi = {10.3389/fanim.2026.1827413},
    publisher = {Frontiers Media SA},
    year = {2026},
    pages = {1827413},
    abstract = {Background Fitness for transport decisions are essential for safeguarding livestock welfare, yet the UK’s current legislation leaves room for subjective judgement. Previous studies indicate that farmers often lack confidence when assessing borderline cases, and although emergency slaughter provides an option for animals unfit for transport, eligibility is narrow and access is limited. This study explores UK farmers’ experiences, challenges, and preferences regarding fitness for transport assessments for poultry, pigs, cattle and sheep, and emergency slaughter of domestic ungulates. Methods An online questionnaire was created (Jisc, 2019) containing twenty-eight questions to collect qualitative and quantitative data from UK commercial livestock farmers. It was distributed online and through in-person events during July and August 2023. The survey was advertised publicly through a variety of routes including social media (Instagram, Facebook), livestock markets, agricultural shows, veterinary practices, University of Nottingham staff and student emails, NFU website, national boards, and specialist veterinary groups. Results Lameness was identified as the most challenging condition to assess (79\%), followed by pregnancy stage and body condition. While 86\% reported familiarity with legislation, 39\% lacked confidence in their transport decisions. Private veterinarians were the preferred source of advice, with gender differences observed in reliance on previous education and peer networks. Barriers to emergency slaughter included cost, location, and limited veterinary capacity. Over half of respondents wanted clearer guidance or more training, and 76\% supported broadening eligibility for emergency slaughter to include older, aggressive, or chronically lame animals. Free-text responses raised concerns about long travel distances, the decline of small abattoirs, and interest in mobile abattoirs. Limitations Convenience sampling and a small number of responses (51) could influence the results of this study. Conclusions Despite high reported familiarity with regulations, farmers experience uncertainty in fitness for transport assessments. Clearer guidance, targeted training, and a review of emergency slaughter criteria may support better, more consistent decision-making and improve animal welfare outcomes.},
    keywords = {animal welfare, emergency slaughter, fitness for transport, guidance, opinions, training},
    url = {https://www.frontiersin.org/journals/animal-science/articles/10.3389/fanim.2026.1827413/full}

}

@article{shirinalodwan2026the,
    title = {The Impact of Social Media on Mental Clutter Among Students at Al Ain University-A Field Study},
    author = {Shirin AlOdwan and Hatem Alqudah and Hussein Al-Srehan and Dua’a Aladwan},
    howpublished = {Available at https://www.mdpi.com/2227-7102/16/9/1461 (2026/01/01)},
    journal = {EDUCATION SCIENCES},
    doi = {10.3390/educsci16091461},
    publisher = {MDPI AG},
    year = {2026},
    pages = {1461},
    abstract = {This study aimed to look into the correlation between the use of Instagram and TikTok and mental clutter among students of Al Ain University. The descriptive-correlational design was used, and the data were gathered by questionnaire from 70 students. The results indicated that students used Instagram and TikTok moderately and that they perceived moderate influence on their concentration, academic focus and mental clarity. The research calls for university policies on digital wellness, awareness workshops, limiting the use of phones during studies and student support programs to mitigate the negative impact of overuse of social media on academic and psychological performance. The data were collected using a questionnaire consisting of two sections: the first deals with personal variables, and the second contains 15 items distributed over three main axes. The results showed that the degree of students’ use of social media programs was average, as students used these applications on a daily basis but moderately. The effect of excessive use of social media software on distraction was moderate, as students found it difficult to focus on their assignments due to excessive use of these applications. Regarding the suggestions to minimize negative impacts, students pointed out the importance of setting certain times to stay away from these applications while studying. The study concluded that students should be aware of the negative effects of excessive use of social media programs and provide strategies to reduce these effects. Quantitatively, the overall Instagram and TikTok use score was M = 2.21 (SD = 0.897), the perceived mental-clutter score was M = 2.28 (SD = 0.891), and the strategy score was M = 2.29 (SD = 0.831); the full questionnaire showed good internal consistency (Cronbach’s alpha = 0.85). One-sample tests against the three-point scale midpoint of 2.00 showed that perceived mental clutter, t(69) = 2.63, p = 0.011, and support for self-regulation strategies, t(69) = 2.92, p = 0.005, were significantly above the midpoint, whereas the social-media-use mean was marginal, t(69) = 1.96, p = 0.054.},
    keywords = {mental clutter, social media, students},
    url = {https://www.mdpi.com/2227-7102/16/9/1461}

}

