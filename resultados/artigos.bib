@article{diantahasrinataliusbarus2023how,
    title = {How Social Media Marketing Affecting Brand Equity And Student Engagement in Higher Education Marketing},
    author = {Dianta Hasri Natalius Barus},
    howpublished = {Available at https://ojs.sgsci.org/journals/emi/article/view/82 (2023/06/19)},
    journal = {Economics \&amp; Management Information},
    doi = {10.58195/emi.v2i2.82},
    publisher = {Global Science Publishing Pte. Ltd.},
    year = {2023},
    pages = {1–11},
    abstract = {The utilization of social media enables interpersonal communication and user engagement, thereby altering conventional hierarchical communication methods and introducing an unpredictable element into the decision-making process of consumers. Social media marketing is an essential component for organizations seeking to maintain competitiveness, despite being viewed as a part of online marketing. The efficacy of social media promotion is contingent upon the existence of novel products, the market responsiveness of organizations, and the establishment of robust online platforms. Social networking sites such as Twitter, Instagram, and Facebook have become essential instruments for marketers. These platforms are extraordinarily valuable for the promotion of brands and services because they facilitate interactive communication. Social networking sites play a crucial role in the dissemination of information about higher education institutions, serving as effective mechanisms for attracting potential students. The influence of the material disseminated on these online platforms on the cognitive processes of potential students in making decisions is yet to be established. The crucial non-financial advantage of institutions' utilization of social media platforms is the recognition of user engagement. A comprehensive understanding of user involvement across diverse platforms can augment our comprehension of its impact on brand perception. The visual-centric attributes, along with elevated engagement rates among a diverse, young, and international population, have made Instagram a powerful platform for institutions of higher education. The article emphasizes the significance of brand equity within the marketing approach of higher education establishments. The concept of brand equity is subject to the influence of various factors, including but not limited to brand personality, social credibility, and market position. Ensuring the provision of superior amenities and services is imperative for academic institutions. However, the establishment of a proficient communication mechanism is equally vital for enhancing the university's brand positioning and managing the value of its brand efficiently. The notion of 'brand soul' serves as the foundation for this, denoting how the academic institution's faculty and staff personify the brand.},
    keywords = {Brand equity, Business, Customer engagement, Instagram, Law, Marketing, Political science, Public relations, Social media, brand equity, brand personality, engagement, higher education, higher education marketing, social credibility, social media, social media marketing, social networking sites, student decision-making, student engagement, university recruitment},
    url = {https://ojs.sgsci.org/journals/emi/article/view/82}

}

@article{nataliepang2019assessing,
    title = {Assessing Perceptions of Barriers to Healthy Eating Among Represented and Underrepresented Students at UC Davis (OR13-06-19)},
    author = {Natalie Pang and Anna Marie Jones and Rachel Erin Scherr},
    howpublished = {Available at https://linkinghub.elsevier.com/retrieve/pii/S2475299123157696 (2019/06/01)},
    journal = {Current Developments in Nutrition},
    doi = {10.1093/cdn/nzz050.or13-06-19},
    publisher = {Elsevier BV},
    year = {2019},
    pages = {nzz050.OR13-06-19},
    abstract = {The primary objective was to develop a needs assessment questionnaire that assesses perceptions that may serve as barriers to healthy eating behavior, and to assess the differences in perceptions between traditionally underrepresented (US) and represented (RS) students. This study also explored the most commonly used social media platforms used among UC Davis Students. The needs assessment was distributed through available listservs using a modified Dillman approach and through the “MyUCDavis” Homepage, a UC Davis marketing channel. Ten \$25 Gift Cards were raffled to interested students as an incentive. Likert scale questions were developed for each of the measured perceptions and were then grouped to create composite variables of convenience, finances, cooking skill self-efficacy, interest in improving cooking skill, and cultural background (measured as “healthy options” and “food preferences”). Internal consistency for each composite variable was assessed using Cronbach’s alpha. Mann Whitney U-Tests were used to analyze the differences in the composite variables between US and RS groups. Most of the composite variables had at least moderate internal consistency (Cronbach’s alpha = 0.7 - 0.85, while two had low internal consistency. The US group scored higher in the perceived barriers of convenience (P = 0.001) and finances (P < 0.005), demonstrated lower cooking skill self-efficacy (P < 0.005), and preferred more familiar food choices (P < 0.005). There were no differences between groups in the perceptions of healthy options (P < 0.114). The most popular social media platforms included Facebook, Instagram, and YouTube. US were affected more by the perceived barriers as they scored higher in the convenience, finances, and food preferences composite variables, and had lower cooking skill self-efficacy than RS counterparts. Future studies can examine the effects of addressing the perceived barriers via a targeted social media marketing strategy using Facebook, Instagram, and YouTube. Funding and resources were provided by the UCOP Global Food Initiative, the Center for Student Affairs and Assessment, the Student Affairs Marketing and Communications department, the Aggie Compass Basic Needs Center, as well as the Scherr lab group.},
    keywords = {Clinical psychology, Computer science, Consistency (knowledge bases), Cronbach's alpha, Developmental psychology, Geometry, Internal consistency, Likert scale, Mathematics, Medical education, Medicine, Neuroscience, Perception, Psychology, Psychometrics, Social media, Social psychology, World Wide Web, barriers to healthy eating, convenience, cultural background, food costs, food preferences, social media marketing, social media use, student nutrition, student perceptions, underrepresented students},
    url = {https://linkinghub.elsevier.com/retrieve/pii/S2475299123157696}

}

@article{marshandaazahrayasir2026instagrambased,
    title = {Instagram-based Social Media Marketing Activities and Prospective Students’ Behavioral Engagement: A PLS-SEM Study in a Private University},
    author = {Marshanda Azahra Yasir and Grandys Frieska Prassida},
    howpublished = {Available at https://journals.researchsynergypress.com/index.php/ijmadic/article/view/4303 (2026/09/28)},
    journal = {International Journal of Marketing and Digital Creative},
    doi = {10.31098/ijmadic.v4i2.4303},
    publisher = {Research Synergy Foundation},
    year = {2026},
    pages = {60–78},
    abstract = {This study examines the relationship between Instagram social media marketing activities (SMMA) and prospective students’ behavioral engagement at a private higher education institution. Previous studies on SMMA have predominantly focused on commercial sectors, while limited research has explored how brand awareness and brand image simultaneously mediate the relationship between SMMA and behavioral engagement in higher education settings. This study addresses this gap by investigating the mediating roles of brand awareness and brand image in the relationship between Instagram-based SMMA and behavioral engagement among prospective students of Semen Indonesia International University (UISI), Indonesia. A cross-sectional survey design was employed using purposive sampling. Data were collected through an online questionnaire distributed to senior high school and vocational school students who followed or interacted with the university’s Instagram account (@pmbuisi). Of the 161 responses collected, 133 valid responses were analyzed using Partial Least Squares Structural Equation Modeling (PLS-SEM). The findings indicate that Instagram SMMA is positively associated with brand awareness and brand image. In turn, both brand awareness and brand image are positively associated with prospective students’ behavioral engagement. However, the direct relationship between SMMA and behavioral engagement was not significant. The mediation analysis demonstrates that brand awareness and brand image fully mediate the relationship between Instagram SMMA and behavioral engagement. These findings suggest that Instagram marketing activities in higher education are more effective in fostering engagement when they first strengthen prospective students’ cognitive and emotional perceptions of the university brand. This study contributes to the higher education marketing literature by providing empirical evidence on the mediating mechanisms linking Instagram SMMA and behavioral engagement within a single private university context. The findings also offer practical insights for higher education institutions in designing brand-oriented Instagram communication strategies to enhance prospective student engagement.},
    keywords = {Advertising, Behavioral Engagement, Brand Awareness, Brand Image, Brand awareness, Brand engagement, Brand equity, Brand experience, Brand image, Brand management, Brand relationship, Cognition, Computer-assisted web interviewing, Confirmatory factor analysis, Corporate branding, Empirical research, Higher education, Instagram, Instagram marketing, Integrated marketing communications, Likert scale, Marketing, Marketing communication, Marketing research, Mediation, PLS-SEM, Perception, Prospective Students, Psychology, Scale (ratio), Social Media Marketing Activities, Social marketing, Social media, Social media marketing, Social psychology, Structural equation modeling, behavioral engagement, brand awareness, brand image, higher education marketing, mediating effect, private universities, prospective students, social media marketing, university brand, university recruitment},
    url = {https://journals.researchsynergypress.com/index.php/ijmadic/article/view/4303}

}

