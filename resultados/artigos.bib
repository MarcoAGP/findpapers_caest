@inbook{allaymounm2024business,
    title = {Business Intelligence to Enhance Segmentation and Targeting Results for Training Courses in Educational Institutions Using Social Media Data},
    author = {Allaymoun M.},
    howpublished = {Available at https://link.springer.com/chapter/10.1007/978-3-031-70399-7_54 (2024/01/01)},
    doi = {10.1007/978-3-031-70399-7_54},
    publisher = {Springer Nature Switzerland},
    year = {2024},
    pages = {707-716},
    abstract = {In today's digital age, educational institutions face the challenge of effectively reaching and engaging with their target audience amidst a sea of information and competing content. This research paper delves into the intersection of business intelligence and social media data to enhance segmentation and targeting outcomes for training courses within educational institutions. Through a comprehensive methodology involving data collection, analysis, and model design, this study examines the efficacy of leveraging social media data to inform decision-making processes. Over a six-month period, social media data from platforms such as Facebook and Instagram were meticulously analyzed to uncover valuable insights into follower behavior, preferences, and engagement patterns. The findings shed light on the most effective strategies for segmenting and targeting followers, enabling educational institutions to tailor their course offerings to specific demographics and interests. Graphical analyses further illuminate the effectiveness of different advertising platforms and workshop types, providing decision-makers with actionable insights to refine their targeting efforts. From workshops emphasizing analytical skills to those catering to specific age groups and educational levels, institutions can now better understand what resonates most with their target audience. By harnessing the power of business intelligence and social media data, educational institutions can refine their segmentation and targeting strategies, ultimately delivering more relevant and impactful training courses. This research paper serves as a roadmap for institutions seeking to leverage data-driven approaches to optimize their educational offerings and enhance student engagement and satisfaction.},
    keywords = {Advertising strategies, Artificial intelligence, Business, Business intelligence, Computer science, Data analysis, Data science, Decision-making, Educational institutions, Facebook, Instagram, Knowledge management, Medical education, Medicine, Segmentation, Social media, Targeting, World Wide Web, advertising platforms, audience segmentation, audience targeting, business intelligence, data-driven decision making, educational institutions, follower engagement, social media data, student engagement, training courses},
    url = {https://link.springer.com/chapter/10.1007/978-3-031-70399-7_54}

}

@article{radinaanggunnurisma2024implementing,
    title = {Implementing Double-Entry Journal Assisted with Instagram to Foster Engagement in EFL Writing},
    author = {Radina Anggun Nurisma and Wahyu Indah Mala Rohmana and Titik Lina Widyaningsih and Bambang Yudi Cahyono},
    howpublished = {Available at https://jurnal.usk.ac.id/SiELE/article/view/30425 (2024/01/01)},
    journal = {Studies in English Language and Education},
    doi = {10.24815/siele.v11i1.30425},
    publisher = {LPPM Universitas Syiah Kuala},
    year = {2024},
    pages = {76-94},
    abstract = {Student engagement has critical impacts on students to excel academically. Integrating social media in a classroom can potentially affect students’ engagement. The present study aims to examine student engagement in EFL writing using Double-Entry Journal (DEJ) on Instagram, to examine the correlation between cognitive engagement and achievement, and to reveal the challenges in implementing DEJ. The researchers employed a mixed-method design, involving 42 undergraduate students from the English Department of one of the state universities in Indonesia, and obtained the data through questionnaires, writing portfolios, and Instagram documentation. The close-ended and open-ended questionnaires were distributed to the students, whereas writing portfolios and Instagram documentation were observed to examine the students’ writing performance. The collected data were managed, classified, and analyzed. The findings reveal that the students are behaviorally, cognitively, and affectively engaged by DEJ assisted with Instagram.’ There was a positive correlation between cognitive engagement and writing achievement. Yet, challenges had been found, including lack of interaction, student anxiety, and insufficient knowledge during the learning process. The challenges are lessened when teachers and peers offer support with DEJ. The results provide pedagogical implications for teachers to employ instructional strategies that promote engagement in all three dimensions, behaviorally, cognitively, and affectively to attain the students’ outcomes.},
    keywords = {EFL writing, Instagram, Psychology, Sociology, behavioral engagement, cognitive engagement, emotional engagement, peer support, social media in language teaching, student anxiety, student engagement, writing performance, writing portfolios},
    url = {https://jurnal.usk.ac.id/SiELE/article/view/30425}

}

