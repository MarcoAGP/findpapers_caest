@phdthesis{meganmholland2014social,
    title = {Social networking to support student learning in the seventh grade science curriculum},
    author = {Megan M. Holland},
    howpublished = {Available at http://hdl.handle.net/10211.3/121808 (2014/01/01)},
    year = {2014},
    abstract = {This thesis examined how social networking for academic purposes can be utilized to support students' science learning at the seven-grade level.As part of the study on social networking three factors were measured: a) academic achievement, b) motivation, and c) engagement.One hundred seventh grade students in a science class were the participants for this study.Fifty-seven percent of the students participated in social networking (47 percent through Instagram and 10 percent through Facebook) and 43 percent did not participate in social networking.Through social networking assignment updates, reviews and discussions were held.The social networking was introduced in the third quarter of the academic year.A comparison between the students who participated in social networking and those who did not participate in social networking was conducted.Additionally, a comparison between student performance before social networking use and during social networking use was conducted.Data were collected through a survey, interview, overall performance in the class, and performance on a collective exam.Study results indicate that academic achievement increased with the use of social networking.Also, student engagement and motivation increased with the use of social networking.},
    keywords = {Computer science, Curriculum, Facebook, Instagram, Mathematics education, Pedagogy, Psychology, Sociology, academic performance, educational technology, science education, seventh grade students, social media in the classroom, social networking, student engagement, student motivation},
    url = {http://hdl.handle.net/10211.3/121808}

}

@article{chrishankarjanathanan2026heis,
    title = {HEI's as Lifestyle Brands - A Review of Social Media Posts With Pierre Bourdieu’s Cultural Capital Theory; A Case Study of Sri Lankan Non-State HEI},
    author = {Chrishankar Janathanan},
    howpublished = {Available at https://kjms.sljol.info/articles/10.4038/kjms.v8i1.181 (2026/07/01)},
    journal = {KDU Journal of Multidisciplinary Studies},
    doi = {10.4038/kjms.v8i1.181},
    publisher = {Sri Lanka Journals Online},
    year = {2026},
    pages = {1–11},
    abstract = {Purpose: The research focuses on lifestyle brands set out to identify the different financial displays of social class and status associated with them. Lifestyle brands that are focused on are important for the choices made. Pierre Bourdieu's Cultural Capital Theory illustrates how social inequalities are represented beyond money. Bourdieu argued that capital isn't just economic (money, property). It also comes in cultural, social, and symbolic forms. These forms can be converted into one another. Cultural capital is the knowledge, skills, tastes, and credentials that confer higher status in society.Methodology: This study employs a qualitative, theory-driven methodology grounded in Pierre Bourdieu’s Cultural Capital Theory. Forty-eight (48) higher education institutions were purposively selected to maximise variation along Bourdieusian axes: institutional age (older vs newer), regional vs global orientation, and dominant objectified capital style (heritage architecture vs modern premium amenities). A total of 1200 posts were collected from their public Facebook and Instagram pages (25 per institution).Findings: Institutions deploy objectified cultural capital (premium amenities, campus aesthetics) and appeal to habitus (regional language use, alumni success narratives) across visual platforms like Instagram. Regional content shared dispositions, while objectified displays presuppose middle-class ease. Alumni and graduation ceremonies showcase institutionalised capital, filled with traditions, festivities, student life, institutional legacy and affiliation, and economic success. Engagement reflects habitus matching rather than neutral interest, revealing how lifestyle branding reproduces class distinctions.Originality: Higher education has increasingly functioned as a lifestyle brand – a brand that is part of CV, reference group and peers. The phenomenon that Bourdieu’s concept of cultural capital helps to serves as a mechanism of social distinction. This study examines how branding higher education as a lifestyle construct creates a unique advocacy.},
    keywords = {Appeal, Capital (architecture), Class (philosophy), Cultural capital, Economic capital, Facebook, Gender studies, Graduation (instrument), Grounded theory, Habitus, Highbrow, Higher education, Human capital, Individual capital, Inequality, Instagram, Media studies, New media, Participant observation, Pierre Bourdieu, Public relations, Set (abstract data type), Social capital, Social class, Social inequality, Social media, Social mobility, Social reproduction, Social science, Social status, Sociology, Style (visual arts), Symbolic capital, cultural capital, habitus, higher education institutions, institutional branding, lifestyle branding, non-state higher education, objectified cultural capital, social class, social inequality},
    url = {https://kjms.sljol.info/articles/10.4038/kjms.v8i1.181}

}

@article{drkanchanakshaydrshaktiawasthidrpriyasengupta2026impact,
    title = {Impact of Social Media Presence of Higher Education Institutions on Students’ Admission Decision: An Empirical Study},
    author = {Dr Kanchan Akshay, Dr Shakti Awasthi, Dr Priya Sengupta},
    howpublished = {Available at https://www.unicredit-capitalia.eu/article/impact-of-social-media-presence-of-higher-education-institutions-on-students-admission-decision-an-empirical-study-268/ (2026/06/19)},
    journal = {Journal of European Economic History},
    doi = {10.61336/jeeh/26-2-43},
    publisher = {Vital Signs Press},
    year = {2026},
    pages = {559–570},
    abstract = {This study examines the influence of social media presence of Higher Education Institutions (HEIs) on students’ admission decisions. With increasing digital engagement, institutional branding through platforms such as Instagram, YouTube, and Google has become a critical touchpoint in the student decision journey. Primary data was collected from 210 responses for robust statistical analysis. The study employs descriptive statistics, correlation analysis, and hypothesis testing to assess the relationship between social media engagement and admission decisions. Findings reveal that social media significantly enhances institutional awareness, credibility, and perceived value, thereby influencing student choice. Content related to placements, student life, and testimonials emerged as key drivers. The study offers strategic recommendations for HEIs to optimize digital engagement and highlights limitations and future research directions.},
    keywords = {Business, Content analysis, Decision making, Descriptive research, Descriptive statistics, Digital Marketing, Digital media, Empirical evidence, Empirical research, HEI’s, Higher education, Instagram, Key (lock), Marketing, Medical education, Multimethodology, Perception, Political science, Positive correlation, Psychology, Public relations, Qualitative research, Social Media, Social capital, Social impact, Social influence, Social media, Social psychology, Sociology, Statistical analysis, Test (biology), YouTube, digital engagement, higher education institutions, institutional awareness, institutional branding, perceived value, social media presence, student choice, university recruitment},
    url = {https://www.unicredit-capitalia.eu/article/impact-of-social-media-presence-of-higher-education-institutions-on-students-admission-decision-an-empirical-study-268/}

}

@misc{lukaparikh2025bridging,
    title = {Bridging Belonging: Analyzing Student Perceptions of Inclusivity at Queen’s University: A Comprehensive Observational Study on Student Experiences Through an EDIAA Lens},
    author = {Luka Parikh and Keshvi Vithlani and Shayan Raeisi Dehkordi and Roshni Perera},
    howpublished = {Available at https://ojs.library.queensu.ca/index.php/inquiryatqueens/article/view/19028 (2025/08/28)},
    doi = {10.24908/iqurcp19028},
    publisher = {Queen's University Library},
    year = {2025},
    abstract = {Background: With a rapidly evolving demographic in the student body at Queen’s University, this study explores the ways students conceptualize inclusivity, both positively and negatively, and examines its implications in their academic and social experiences. This study was developed using the EDIIA framework defining inclusivity as the degree individuals from diverse backgrounds feel welcomed, respected, and supported within the Queen’s community. Methodology: A survey-based observational study was completed, sampling 50+ students from the Queen’s University community from all degree programs and years of study. The survey was shared online using Instagram and in-person at the TEDxQueensu Conference and Student Life Centre. Students were asked to anonymously complete the survey using Microsoft Forms. The survey consisted of 16 questions both qualitative and quantitative, incorporating Likert Scales and open-ended responses. The survey was designed to assess student demographic factors as well as their sense of inclusivity within Queen’s university. Results: Preliminary analysis indicated mean participant age was 19 years, with a modal age of 18 years. The most represented faculties were Health Sciences, and Arts and Science, with a notable proportion of respondents identifying as second-generation university students. Anticipated themes include faculty-based variations in inclusivity perceptions, cultural background influences on social belonging, and disparities in academic engagement. Responses will be analyzed to assess frequency and impact of experiences with microaggressions, exclusionary behaviors, and barriers to cross-cultural interactions on campus inclusivity. Significance: By identifying both systemic strengths and areas of exclusion related to inclusivity at Queen’s, we hope our findings will serve as a catalyst for driving meaningful change that bridges existing gaps within the campus community. Beyond highlighting student  perspectives, this research has the potential to inform targeted EDIIA initiatives, reshape institutional policies, and drive cultural transformation in the Queen’s community, ultimately fostering a more supportive and safe environment for all students.},
    keywords = {Biology, Bridging (networking), Computer network, Computer science, Hymenoptera, Mathematics education, Neuroscience, Pedagogy, Perception, Psychology, Queen (butterfly), Queen's University, Sociology, Zoology, academic engagement, campus diversity, cross-cultural interaction, inclusivity, microaggressions, second-generation students, social belonging, student perceptions},
    url = {https://ojs.library.queensu.ca/index.php/inquiryatqueens/article/view/19028}

}

@article{rohitbhushan2025the,
    title = {The Impact of Social Media on School and University Student Life},
    author = {Rohit Bhushan},
    howpublished = {Available at https://www.ijraset.com/best-journal/the-impact-of-social-media-on-school-and-university-student-life (2025/05/31)},
    journal = {International Journal for Research in Applied Science and Engineering Technology},
    doi = {10.22214/ijraset.2025.71823},
    publisher = {International Journal for Research in Applied Science and Engineering Technology},
    year = {2025},
    pages = {6890–6901},
    abstract = {This research examines how social media affects the academic performance, mental health, and social behavior of students in both schools and universities. With the rise of platforms like Instagram, Facebook, TikTok, and YouTube, students are more connected than ever, but this digital engagement brings both opportunities and challenges. On one hand, social media can support learning, provide emotional comfort, and offer spaces for self- expression and peer interaction. It is especially helpful for students dealing with loneliness or anxiety by creating online communities where they can share experiences. On the other hand, constant exposure to social media can lead to negative outcomes such as reduced concentration on studies, emotional distress, online harassment, and addictive behavior. Issues like cyberbullying, unrealistic comparisons, and exposure to misleading information contribute to these problems. This study also highlights research showing that individuals with existing mental health conditions may be particularly sensitive to both the benefits and harms of social media use. The findings suggest that while social media can enhance student life in many ways, it must be used thoughtfully and with proper guidance. Promoting digital literacy, encouraging healthy online habits, and providing institutional support are essential steps toward helping students navigate the online world safely and effectively.},
    keywords = {Computer science, Law, Library science, Mathematics education, Political science, Psychology, Social life, Social media, Social science, Sociology, Student life, academic performance, cyberbullying, digital literacy, misleading information, online communities, online harassment, school students, social behavior, social comparison, social media, social media addiction, student mental health, university students},
    url = {https://www.ijraset.com/best-journal/the-impact-of-social-media-on-school-and-university-student-life}

}

@misc{oscarli2023engagement,
    title = {Engagement With a Medical Student Life Instagram Account},
    author = {Oscar Li and Tia Cheunkarndee and Andreas Kyrvasilis and Katherine Chang Chretien},
    howpublished = {Available at https://academic.oup.com/academicmedicine/article/98/Supplement_3/S180/8345008 (2023/10/16)},
    doi = {10.1097/acm.0000000000005398},
    publisher = {Oxford University Press (OUP)},
    year = {2023},
    pages = {S180–S180},
    abstract = {Purpose: The COVID-19 pandemic highlighted a need for using social media to communicate, share information, and build community.1 This is highlighted in the dramatic rise of Instagram accounts by residency programs to build community and connect with potential future residents.2,3 While several studies have explored Instagram use in graduate medical education and recruitment, there is a paucity of literature on Instagram use for undergraduate medical education and medical student life. The objective of this study is to explore and analyze engagement with an undergraduate medical student life Instagram account at a single institution. Approach: We completed a descriptive analysis of our institution’s medical student life Instagram account over a 1-year period (November 2021–November 2022), including analytics available on the Instagram platform. We coded posts into 1 of 5 categories: (1) student/class spotlight, (2) curricular activities, (3) student groups, (4) extracurricular activities, and (5) other. Metrics for each post captured included number of likes, comments, shares, saves, and total accounts reached subdivided by followers and nonfollowers. Outcomes: The account had 1,630 followers and was following 60 accounts at the time of analysis. Overall, 95 posts were made. Of all the posts, 21 were single images, 65 were carousels (multiple images), and 9 were reels (videos). Reels received the most engagement across all analytics: average numbers of likes (161), comments (7), shares (30), saves (10), and accounts reached (4,233). Of the 5 categories, posts about curricular activities received the highest average numbers of likes (192), shares (20), saves (9), and accounts reached (3,114). Posts on student/class spotlights received the highest average number of comments per post (6). Significance: Posts in the form of a reel (video) were most popular in terms of user engagement across all metrics compared to individual or multiple image posts. Regarding content of posts, those made on curricular activities were most popular, followed by those that highlighted students/classes. These findings suggest that viewers may be more interested in the academic student life at medical schools and find greater significance and importance in curricular-focused content. In addition, viewers may be curious about posts that highlight profiles of individual students to gain a better sense of current student community constituents. A greater proportion of accounts reached were nonfollowers compared to followers, indicating the potential to have strong outreach to users who may not have seen our account. Instagram is a powerful social media tool that can be used within the undergraduate medical education community to showcase curricular and student highlights of a single institution and engage with followers.},
    keywords = {COVID-19 pandemic, Computer science, Instagram, Instagram Reels, Instagram posts, Law, Library science, MEDLINE, Medical education, Medicine, Political science, Psychology, Student engagement, Student life, follower engagement, medical school outreach, medical school recruitment, social media analytics, social media engagement, student community, undergraduate medical education},
    url = {https://academic.oup.com/academicmedicine/article/98/Supplement_3/S180/8345008}

}

