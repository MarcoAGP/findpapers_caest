@article{podwornysusanne2026integrating,
    title = {Integrating data literacy and climate science: creating multidisciplinary, data-driven social media posts in grade 10 on human-induced climate change},
    author = {Podworny, Susanne},
    howpublished = {Available at https://link.springer.com/article/10.1007/s11858-026-01811-6 (2026/11/01)},
    journal = {ZDM – Mathematics Education},
    doi = {10.1007/s11858-026-01811-6},
    publisher = {Springer Science and Business Media LLC},
    year = {2026},
    pages = {1269-1283},
    abstract = {Abstract This study reports on a 15-hour multidisciplinary teaching unit that integrates data literacy and climate change education for grade 10 students. Grounded in social-constructivist and civic statistics principles, the unit engages learners with real datasets (global temperature, temperature and CO2 data from Vostok ice cores, and Mauna Loa CO2 data) using CODAP for visualization and piecewise trend analysis. Students create Instagram-like posts that are intended to help students integrate different disciplinary learning experiences related to climate change as a formative learning journal to communicate their data-based findings. Two classes produced 131 posts, 35 contained data-based arguments and were analyzed with qualitative content analysis against the scaffolding Statistical Communication Framework for Social Media Posts (SCFSMP). Most data-oriented posts included visualizations and described trends and patterns. Only a few to none addressed the data source, reliability of the data, or limitations of the data. Mathematical reasoning centered on linear trends and slope with some posts offering predictions. Findings indicate that combining real data sets with structured communicative tasks may foster students’ data literacy, climate understanding, and motivation. The Instagram format supported narrative engagement through comment threads. The study contributes a teaching unit, the SCFSMP for data-based social media posts in mathematics education, and evidence that data-centered inquiry can connect scientific understanding of human-induced climate change with civic aims. Positioning climate change as a data problem may help students practice reasoning with evidence and may prepare them to participate in debates.},
    keywords = {CODAP, Civic statistics, Climate change education, Data literacy, Data science education, Instagram, Mathematics, Mathematics Education, general},
    url = {https://link.springer.com/article/10.1007/s11858-026-01811-6}

}

@article{heriyanto2026information,
    title = {Information experiences of first-time voters on Instagram: navigating algorithms, emotions and political meaning},
    author = {Heriyanto and Faris Naufal Prastian and Ika Nur Azizah and Mohamad Noorman Masrek},
    howpublished = {Available at https://www.emerald.com/jd/article/doi/10.1108/JD-01-2026-0001/1385273/Information-experiences-of-first-time-voters-on (2026/01/01)},
    journal = {JOURNAL OF DOCUMENTATION},
    doi = {10.1108/JD-01-2026-0001},
    publisher = {Emerald},
    year = {2026},
    pages = {1-18},
    abstract = {Purpose This study explores how first-time voters in Indonesia experience and engage with political information on Instagram during a regional gubernatorial election in Indonesia, using an information experience perspective. Design/methodology/approach The study adopts a qualitative approach based on semi-structured interviews with 16 undergraduate Library and Information Science students at a public university in Indonesia. Data were analysed thematically to identify patterns in how participants encountered, evaluated, interpreted and managed political information in algorithmically mediated social media environments. Findings Five interrelated themes were identified: modes of encounter, information evaluation, emotional engagement, sense-making and interpretation, and information practices. The findings show that students navigate algorithmically curated feeds, visual political cues and peer-influence discourse while actively assessing credibility, regulating emotional responses and curating their information environments. Information experience in this context emerges as a dynamic process shaped by the interaction of algorithms, emotions and individual agency. Originality/value This study extends Information Experience research beyond educational and professional settings into the context of digital citizenship. By foregrounding algorithmic mediation and emotional engagement in political information environments, it contributes to theoretical discussions on information experience and information practices in contemporary social media contexts, particularly within developing country settings.},
    keywords = {Algorithmic mediation, Digital citizenship, First-time voters, Information experience, Information practices, Social media},
    url = {https://www.emerald.com/jd/article/doi/10.1108/JD-01-2026-0001/1385273/Information-experiences-of-first-time-voters-on}

}

@article{wendyvenyeteh2026reaching,
    title = {Reaching Malaysian ESL students through Instagram stories - perceived effectiveness, language exposure and learner engagement: A structural equation modelling analysis},
    author = {Wendy Ven Ye Teh and Lei Mee Thien},
    howpublished = {Available at https://journals.sagepub.com/doi/10.1177/20427530241256136 (2026/07/01)},
    journal = {E-LEARNING AND DIGITAL MEDIA},
    doi = {10.1177/20427530241256136},
    publisher = {SAGE Publications},
    year = {2026},
    pages = {539-558},
    abstract = {Students often find discontinuation between classroom learning and out-of-school practice. As Generation Z and millennials are avid users of Instagram and Instagram Stories, this research aims to study the perceived effectiveness of social media on language exposure and learner engagement, with a learner’s perceived proficiency as a moderating effect. A total of 202 Malaysian Chinese Independent Secondary School Senior 2 and Senior 3 students took part in the Google Form survey. This quantitative study employed partial least squares structural equation modelling for data analysis. The results showed that Instagram Stories are perceived to be effective and useful as it contributes to language exposure and learner engagement agentically, cognitively, and emotionally. However, a learner’s perceived proficiency was not found to be a significant moderator. Future studies point towards exploring English learning outside of the classroom context using other engaging social media tools such as TikTok and more.},
    keywords = {Instagram stories, language exposure, learner engagement, partial least squares structural equation modelling, perceived effectiveness, social media},
    url = {https://journals.sagepub.com/doi/10.1177/20427530241256136}

}

@article{aylinalbamandakarjona2026time,
    title = {Time spent on the internet and online risk behaviors among young people in Spain and Argentina},
    author = {Aylin Alba Mandak Arjona and Gianluigi Moscato and Irene Soledad Estrada Moreno and Luis Gómez Jacinto},
    howpublished = {Available at https://revistaprismasocial.es/ps/article/view/6048 (2026/07/01)},
    journal = {Revista Prisma Social},
    doi = {10.65598/rps.6048},
    publisher = {Prisma Social Ediciones SL},
    year = {2026},
    pages = {324-346},
    abstract = {El uso intensivo de internet se ha consolidado como un elemento estructural en la vida juvenil, incrementando la exposición a diversas conductas de riesgo online. Este estudio analizó la relación entre el tiempo diario de conexión y cinco tipos de riesgos digitales (contenidos de riesgo, riesgo relacional, ciberestafas, riesgos indirectos y participación en retos virales “challenges”) considerando el sexo, la edad y las diferencias culturales entre España y Argentina. La muestra estuvo compuesta por 466 jóvenes (244 argentinos y 222 españoles) de entre 18 y 30 años, mayoritariamente estudiantes y usuarios frecuentes de redes sociales, especialmente Instagram y TikTok. Se utilizó un diseño transversal y correlacional mediante cuestionarios online validados. Se realizaron regresiones múltiples con modelos de moderación para examinar los efectos de interacción del sexo y la edad en la relación entre horas de conexión y riesgos digitales. En España, la asociación entre tiempo de conexión y contenidos de riesgo y retos virales estuvo condicionada por la interacción con sexo y edad; los riesgos relacionales fueron más relevantes en mujeres de edad intermedia. En ciberestafas y riesgos indirectos, la edad y el sexo tuvieron mayor peso que las horas de conexión. En Argentina, más tiempo online se vinculó con mayor exposición a contenidos de riesgo y riesgos indirectos, especialmente en varones jóvenes, mientras que los retos virales dependieron de la combinación de edad y sexo. En ambos países, los patrones variaron según factores sociodemográficos y culturales, evidenciando la necesidad de estrategias preventivas diferenciadas y adaptadas a cada contexto juvenil.},
    keywords = {Conductas de riesgo online, Digital vulnerability, Internet, Jóvenes, Online risk behaviors, Tiempo de conexión, Time spent online, Vulnerabilidad digital, Young people},
    url = {https://revistaprismasocial.es/ps/article/view/6048}

}

@article{narongdejphanthaphoommee2026social,
    title = {Social Media Journaling as a Reflective Method for Eliciting Translation Student's Motivation and Self-Efficacy: A Narrative Review},
    author = {Narongdej Phanthaphoommee and Nuntiya Doungphummes},
    howpublished = {Available at https://journals.sagepub.com/doi/10.1177/21582440261469810 (2026/07/01)},
    journal = {SAGE OPEN},
    doi = {10.1177/21582440261469810},
    publisher = {SAGE Publications},
    year = {2026},
    abstract = {This paper reviews the potential use of social media journaling to investigate the translation student’s motivation and self-efficacy, for these aspects seem to receive little attention in Translation Studies. Its objective is to introduce social media journaling as a longitudinal, multimodal, and culturally situated method in studying motivation and self-efficacy. As an illustrative case, we analysed translation students’ online reflective journals across platforms such as Facebook, Instagram, and YouTube through thematic coding that focuses on motivational fluctuations, coping strategies, and identity construction. We showed that multimodal artefacts, including texts, images, and short videos, can be interpreted to capture students’ self-expression and lived experiences. The illustrative case revealed four themes: social relationships, identity and aspirations, academic pressures, and adaptive study processes. Theoretically, social media journaling encourages creativity, immediacy, and authentic reflection, as well as code-switching highlighting translator identity. It provides multimodal insights into translation students’ motivation, adaptive strategies, and identity with creativity and authenticity, but challenges include self-reporting bias, digital footprints, and sustained engagement. This paper also brings a methodological innovation in Translation Studies through reflection with social media journaling. It can capture learning experiences longitudinally in context using real-time, multimodal data. It brings into focus the issues of student motivation, self-efficacy, translator identity, and digital literacy in Translation Studies.},
    keywords = {journaling, motivation, self-efficacy, social media, translation student},
    url = {https://journals.sagepub.com/doi/10.1177/21582440261469810}

}

