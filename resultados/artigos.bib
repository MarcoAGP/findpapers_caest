    year = {2025},
    pages = {118–143},
    abstract = {This longitudinal study investigates the pedagogical utility of Facebook groups as digital learning environments in project management courses for communication students between 2019 and 2024. Grounded in theoretical frameworks including communities of practice (Wenger, 2002), uses and gratifications theory (Katz et al., 1973), and connectivism (Siemens, 2005, Downes 2023), the research examines the evolution of student interaction, instructor involvement, and collaborative learning strategies within these groups. The study’s objectives are (1) to examine the dynamics of online academic interaction with attention to collaboration, and involvement, and (2) to identify specific characteristics of academic communities of practice as manifested in Facebook learning groups. Findings reveal an initial phase marked by vibrant, student-driven communities fostering peer knowledge exchange, reflection, and creativity that align with core characteristics of effective learning networks. However, over time, student engagement declined, resulting in groups shifting towards instructor-centered, administratively focused spaces with reduced peer interaction. This trajectory reflects changing digital behaviors, platform fatigue, and a shift toward more visually stimulating social media platforms (e.g. Instagram, Tik-Tok), challenging the sustainability of Facebook groups as collaborative learning tools. The study underscores the need for flexible pedagogical approaches on independent platforms that integrate blended learning environments responsive to evolving student preferences. Also, it takles the implications for the future design of digital learning ecosystems, the balance between online and face-to-face engagement, and maintaining meaningful educational communities amid shifting media landscapes are discussed.},
    keywords = {Active learning (machine learning), Activity theory, Blended learning, Class (philosophy), Collaborative learning, Computer science, Computer-mediated communication, Connectivism, Cooperative learning, Creativity, Digital learning, Digital media, Educational technology, Experiential learning, Facebook groups, Grounded theory, Higher education, Information and Communications Technology, Knowledge management, Learning Management, Learning theory, Mathematics education, New media, Paradigm shift, Participatory culture, Pedagogy, Peer learning, Project-based learning, Psychology, Public relations, Romanian, Romanian higher education, Social learning, Social media, Social network (sociolinguistics), Social network analysis, Sociology, Student engagement, Sustainability, Teaching method, Uses and gratifications theory, Web 2.0, blended learning, collaborative learning, communication science students, communities of practice, community of practice, connectivism, digital learning communities, digital learning ecosystem, digital learning environments, online student interaction, project management, project management education, uses and gratifications theory},
    url = {https://journals.unibuc.ro/index.php/rjjc/article/view/1552}

}

@article{angelobautista2025exploring,
