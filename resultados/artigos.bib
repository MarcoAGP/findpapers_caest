@article{portom2025how,
    title = {How Can Language Education Contribute to Securing a Livable Planet?},
    author = {Porto M.},
    howpublished = {Available at https://onlinelibrary.wiley.com/doi/10.1002/tesq.3321 (2025/06/01)},
    journal = {Tesol Quarterly},
    doi = {10.1002/tesq.3321},
    publisher = {Wiley},
    year = {2025},
    pages = {585-618},
    abstract = {Abstract The aim of this study was to test the notion of ecological citizenship empirically in the English language classroom in an underrepresented region, Latin America. A pedagogic project aimed at the development of students as ecological citizens was designed and implemented in 2019 in four English language classrooms in a public secondary school in Argentina. Participants were 111 teenagers aged 15–17 taking their fourth or fifth years. The project addressed the theme ‘the world we want’ using the UN sustainable development goals as a foundation, in particular, those concerned with environmental issues. The study is theoretically grounded on the notion of ecological citizenship and the research question is: How can language education contribute to securing a livable planet? Data types include Instagram publications (video, text, and a variety of semiotic resources); Instagram comments; student artifacts created in class (graphs, charts, tables, icons); infographics sewed together to make a quilt; a project video; the Autobiography of Intercultural Encounters; and a final student survey. Qualitative analysis was done in three phases and findings indicate that the creative arts and community engagement in combination fostered students' development as ecological citizens in this context. Implications for language education are considered.},
    keywords = {Argentina, Astrobiology, Astronomy, English language teaching, Instagram, Physics, Planet, Psychology, Sociology, Sustainable Development Goals, community participation, creative arts, environmental citizenship, environmental education, high school students, intercultural encounter},
    url = {https://onlinelibrary.wiley.com/doi/10.1002/tesq.3321}

}

@article{simonabader2025universities,
    title = {Universities, Culture, and Social Media: Enhancing Engagement and Community Through Digital Strategies},
    author = {Simona Bader and George Alexandru Condrache},
    howpublished = {Available at https://www.mdpi.com/2673-5172/6/2/80 (2025/06/01)},
    journal = {Journalism and Media},
    doi = {10.3390/journalmedia6020080},
    publisher = {MDPI AG},
    year = {2025},
    pages = {80–80},
    abstract = {In the digital era, social networks play a crucial role in promoting university cultural events and enhancing accessibility, interaction, and student engagement. This study examines the impact of the communication strategies employed by the West University of Timisoara (UVT) to promote the initiative “At UVT, Culture is Capital” within the framework of Timisoara 2023—European Capital of Culture. This research employs a mixed methodology, combining a quantitative analysis of the performance of Facebook and Instagram posts with a qualitative examination of communication strategies. The results reveal that, despite Generation Z’s preference for visual platforms like TikTok and Instagram, Facebook continues to be an effective channel for promoting university cultural events. This effectiveness stems from trust in the information shared and the strengthened community surrounding the university. Key factors contributing to the campaign’s success included the prominence of guest speakers, high-quality visual and textual content, and the organization of interactive giveaway campaigns. There was also a notable increase in student participation in events and an enhanced sense of belonging to the university community. The findings suggest incorporating more dynamic media formats, such as reels and stories, to boost engagement and explore emerging platforms favored by younger audiences. This research contributes to understanding how universities can effectively leverage social media to promote cultural events and foster a more engaged academic community.},
    keywords = {Community engagement, Computer science, European Capital of Culture, Facebook, Generation Z, Instagram, Instagram Stories, Media studies, Political science, Public relations, Social media, Sociology, TikTok, World Wide Web, cultural communication, digital strategy, sense of belonging, social media in cultural events, student engagement, student engagement in culture},
    url = {https://www.mdpi.com/2673-5172/6/2/80}

}

@article{maríadelvalledemoyamartínez2025educación,
    title = {Educación conectada: las redes sociales en la formación musical del alumnado adolescente. : Revisión sistemática},
    author = {María del Valle De Moya Martínez and Shirley Yolanda de la Cruz Ramos},
    howpublished = {Available at https://revistas.ufg.br/musica/article/view/83072 (2025/01/28)},
    journal = {Musica Hodie},
    doi = {10.5216/mh.v25.83072},
    publisher = {Universidade Federal de Goias},
    year = {2025},
    abstract = {La popularidad generalizada de plataformas como TikTok, Instagram y YouTube entre los adolescentes ha generado un creciente debate sobre su potencial educativo en el aula. Esta revisión sistemática analiza la literatura científica publicada durante la última década sobre el uso pedagógico de estas redes sociales en la educación musical en entornos formales de secundaria y pregrado, centrándose en su impacto tanto en el alumnado como en las prácticas docentes. El estudio siguió el protocolo PRISMA 2020 y aplicó la estrategia PICO para guiar el proceso de búsqueda y selección. Los hallazgos revelan una tendencia predominante hacia el consumo pasivo de contenido, en particular a través de YouTube, utilizado principalmente con fines expositivos o de apoyo teórico. Sin embargo, algunos estudios destacan por promover la participación activa del alumnado, reportando mejoras en la motivación, la creatividad, la colaboración y el aprendizaje significativo. A pesar del potencial educativo de estas herramientas, persisten varios desafíos, como la limitada formación docente, la débil integración curricular y la falta de diseños de investigación experimentales o longitudinales. La revisión concluye que promover la alfabetización digital crítica es esencial para transformar el uso cotidiano de las redes sociales en oportunidades reales de aprendizaje musical en el aula.},
    keywords = {Music education, Secondary education, Social media, Systematic review},
    url = {https://revistas.ufg.br/musica/article/view/83072}

}

@inproceedings{muthmainnahmuthmainnah2025informatization,
    title = {Informatization on Developing E-Learning Materials for IoT-Assisted Education to Enhance EFL in Higher Education},
    author = {Muthmainnah Muthmainnah and Luís Cardoso and Dalwinder Kaur and Ahmad M. Al Yakin and Abdul Gafur Marzuki and Eka Apriani},
    howpublished = {Available at https://link.springer.com/chapter/10.1007/978-981-96-3381-4_42 (2025/01/01)},
    booktitle = {International Conference on Data Analytics \& Management},
    doi = {10.1007/978-981-96-3381-4_42},
    publisher = {Springer Nature Singapore},
    year = {2025},
    pages = {529-552},
    abstract = {Informatization has led to the development and adoption of various digital learning tools. An informatization learning tool, therefore, would be a tool or software that facilitates the use of ICT in the educational setting to enhance learning outcomes. These tools provide interactive and engaging learning experiences for students and allow teachers to deliver content in innovative ways influenced by Internet of Things (IoT) adoption. This study examines the benefits of IoT services in teaching English (TEFL) as multimedia resources such as YouTube, Instagram, Pinterest, VR, and AI. Data collection was carried out using a mixed-methods approach with random sampling by distributing questions online. The study population was 650 undergraduate students and the sample used was 136 students. This study found that the power of IoT as teaching materials in English courses helps students understand the material and increases learning performance, motivation, engagement, learning independence, and joy in learning foreign languages. There is a significant challenge that IoT affects the adaptation of learning from conventional to modern pedagogy, and overall, only a few lecturers in universities are maximizing this IoT for this purpose. Students support and believe that IoT-based teaching material content is more fun and interesting and is a form of lecturer creativity in designing teaching materials that support the twenty-first century. The findings of this research have practical implications for academics who want to maximize the potential of IoT as a digital-based teaching material innovation. This study investigates the integration of Internet of Things (IoT) services in higher education English as a Foreign Language (TEFL). The focus is on the role of digital learning tools, such as multimedia resources such as YouTube, Instagram, Pinterest, virtual reality (VR), and artificial intelligence (AI), in improving educational outcomes. This study provides empirical evidence regarding the effectiveness of IoT-based teaching methods, showing that these methods significantly improve students’ understanding of the material, learning outcomes, and overall enjoyment and motivation in learning English. IoT-based learning models that utilize smartphones and other digital devices create a more fun and engaging learning experience, eliminating the stigma associated with learning English. This research identifies the main factors that influence the effectiveness of IoT, such as the need for educators to continue to innovate and align teaching materials with students’ learning styles. This study provides practical recommendations for educators, emphasizing the need for continued innovation and creativity in designing teaching materials and learning activities. It also emphasizes the importance of training undergraduate students to use IoT effectively, which can further increase their interest in learning English.},
    keywords = {Computer science, E learning, E-Learning, Engineering, Engineering management, English as a foreign language, ICT in education, Informatization, Internet of Things, IoT, Mathematics education, Multimedia, Psychology, TEFL and higher education, The Internet, World Wide Web, artificial intelligence in education, digital learning tools, e-learning materials, higher education, learning outcomes, multimedia resources, student engagement, student motivation, teaching material design, virtual reality},
    url = {https://link.springer.com/chapter/10.1007/978-981-96-3381-4_42}

}

@article{hendriyantobujangga2025social,
    title = {Social Media in Islamic Education; A Systematic Review of Current Trends, Benefits, and Challenges},
    author = {Hendriyanto BUJANGGA and Awal Kurnia Putra NASUTION and Mahdi Wahyuni SALAM and Tuanku MUHAMMAD and Fadhlina HARISNUR},
    howpublished = {Available at https://www.jstage.jst.go.jp/article/ajhs/29/0/29_409/_article (2025/01/01)},
    journal = {Asian Journal of Human Services},
    doi = {10.14391/ajhs.29.409},
    publisher = {Asian Society of Human Services},
    year = {2025},
    pages = {409-423},
    abstract = {This study explores the role of social media in Islamic education using a Systematic Literature Review (SLR) approach.The research aims to understand current trends, key benefits, and challenges in leveraging social media as a tool for Islamic education.Based on an analysis of 18 selected articles, the findings indicate a significant increase in the use of social media for Islamic education, particularly during the COVID-19 pandemic.Major trends include a shift from teacher-centered to student-centered learning and diversification in the use of platforms such as YouTube, Instagram, and WhatsApp.The primary benefits identified include global accessibility to Islamic educational content, enhanced student engagement, and the promotion of moderate Islamic values.The results of this study are expected to serve as a guide for educators, policymakers, and Islamic education communities to optimally utilize social media as an innovative and relevant educational tool.However, the study also highlights critical challenges, such as the risk of misinformation, ethical issues in social media usage, and limitations in content credibility.To address these challenges, strategies such as adopting the principle of sabayon (critical verification), developing structured content, and involving Islamic scholars on social media platforms are proposed.},
    keywords = {Benefits, COVID-19 pandemic, Challenges, Content analysis, Diversification (marketing strategy), Ethical issues, Instagram, Islam, Islamic Education, Islamic culture, Islamic education, Mass media, Media literacy, Political science, Promotion (chess), Public relations, Social Media, Social influence, Social media, Social science, Sociology, Systematic Review, WhatsApp, YouTube, content credibility, misinformation, moderate Islamic values, social media, student engagement, student-centered learning},
    url = {https://www.jstage.jst.go.jp/article/ajhs/29/0/29_409/_article}

}

@article{triwintoloapoko2025social,
    title = {Social media for English language acquisition in Indonesian higher education: Constructivism and connectivism frameworks},
    author = {Tri Wintolo Apoko and Budi Waluyo},
    howpublished = {Available at https://linkinghub.elsevier.com/retrieve/pii/S2590291125001093 (2025/01/01)},
    journal = {Social Sciences \&amp; Humanities Open},
    doi = {10.1016/j.ssaho.2025.101382},
    publisher = {Elsevier BV},
    year = {2025},
    pages = {101382–101382},
    abstract = {The integration of social media into English language education in Indonesian higher education, though underexplored, holds significant potential to enhance learning experiences within constructivist and connectivist frameworks. This study examined the experiences of 108 EFL undergraduates from both English and non-English departments at a private university in Jakarta, Indonesia. A mixed-methods approach was employed, combining quantitative surveys with qualitative interviews. We analysed the data using descriptive statistics and thematic analysis to assess the influence of social media on language learning. The results revealed that undergraduates widely regarded social media platforms such as Instagram, TikTok, Facebook, and WhatsApp as interactive tools that facilitated authentic communication, enhanced both written and spoken English skills, and improved learning strategies, engagement, teaching activities, and academic performance. Despite certain challenges, these platforms offered authentic learning tasks and access to diverse information networks, aligning with constructivist and connectivist principles. The findings highlighted the transformative role of social media as both a supplementary and core educational resource, advocating for its integration into curricula to promote greater student engagement and proficiency in English.},
    keywords = {Computer science, Connectivism, Constructivism (international relations), EFL undergraduates, English as a foreign language, English proficiency, Facebook, Indonesian, Indonesian universities, Instagram, International relations, Law, Learning theory, Linguistics, Pedagogy, Philosophy, Political science, Politics, Sociology, TikTok, WhatsApp, authentic communication, connectivism, constructivism, higher education, social media in language learning, student engagement},
    url = {https://linkinghub.elsevier.com/retrieve/pii/S2590291125001093}

}

@article{marinagalioto2025the,
    title = {The use of social networks in institutional communication at university: a prospective pattern for enhancing the sense of belonging among students},
    author = {Marina Galioto and Francesca Pedone and Apostolos Vantarakis and Paula Tavares and Antonino Bianco},
    howpublished = {Available at https://www.frontiersin.org/journals/communication/articles/10.3389/fcomm.2025.1523295/full (2025/01/01)},
    journal = {Frontiers in Communication},
    doi = {10.3389/fcomm.2025.1523295},
    publisher = {Frontiers Media SA},
    year = {2025},
    pages = {1523295},
    abstract = {Considering that universities follow trends closely in worldwide digital innovation, this community case presents how organizational communication examined and implemented new ways of connecting people in digital environments. A new official Meta profile at the university that was created as part of an innovative communication plan at the department level was utilized for this purpose. The results of a 12-month trial revealed that social connections between people fit with digital connections. In this experimental design of organizational communication, the following two paths were followed: planning social experiences to stimulate student engagement and promoting these initiatives through social networks (i.e., Facebook and Instagram). To connect the students and instill the feeling of belonging to their institution, a specific design was also implemented to restructure the traditional approach to social media dialogue, considering that students, teachers, and academic staff are all part of the same community; instead of a conventional style based on informational language, a more conversational style was used, with the audience being involved as much as possible through questions, surveys, mentions, and collaborative posts to foster their sense of inclusion. As we managed the organization of an educational visit abroad for our students, they were invited to share their feelings, perceptions, and comments via social media with photographs and videos of this experience. This methodology, which focused on social activities linked to digital connections, proved to be a great opportunity for building a type of combined institutional storytelling, embedded in a natural sense of community. Moreover, this joint vision of the academic community, fulfilled by real-life events and not only stories displayed through social networks, is fundamental to creating a brand identity that fosters a sense of belonging.},
    keywords = {Chemistry, Facebook, Instagram, Physical chemistry, Sense (electronics), Sociology, conversational style, institutional communication, organizational communication, sense of belonging, social network, social networks, student engagement, students' engagement, students’ engagement, university communication, university context},
    url = {https://www.frontiersin.org/journals/communication/articles/10.3389/fcomm.2025.1523295/full}

}

@article{raymondbellis2025utilizing,
    title = {Utilizing Instagram Stories to deliver educational content to medical students in pediatrics: curricular design and evaluation},
    author = {Raymond Bellis and Rachel Kim and Rebecca Lendway and Courtney Sniffen and Nathan Smith and Maribeth Chitkara},
    howpublished = {Available at https://www.tandfonline.com/doi/full/10.1080/10872981.2025.2534064 (2025/01/01)},
    journal = {Medical Education Online},
    doi = {10.1080/10872981.2025.2534064},
    publisher = {Informa UK Limited},
    year = {2025},
    pages = {2534064–2534064},
    abstract = {Utilization of social media has been described in medical education, but Instagram as an educational platform for the pediatric clerkship has not yet been reported. We created a 29-item Instagram Story curriculum with summative examination-relevant topics to supplement the pediatric clerkship for third-year medical students. Engagement in the Instagram curriculum was assessed by measuring Storyviews, calculating Story retention rates (number of users who viewed al lslides/number of users who viewed the first slide 100) and analyzing mini-quizperformance. Students completed a voluntary 7-item survey at clerkship end to assess overall satisfaction with the Instagram curriculum. Quantitative analysis of questions using a 7-item scale and qualitative analysis of responses from open-ended questions were performed. A total of 132 students participated over a period of eight 6-week blocks. During the study period, the average number of views on the first slide in a Story was 24.8 and the average number of views on the last slide of a story was 13.3 per block. Average retention rate was 54.3\%, mini-quiz engagement rate was 32.0\%, and percent correct on mini-quizzes was 87.6\%. Students positively rated the Instagram curriculum on feasibility (83.6\%), clerkship relevance (89.1\%), facilitating engagement in the material (65.5\%), assisting in NBME pediatric subject exam preparation (61.8\%), and recommending the modality to other clerkships (69.1\%). This study provides evidence that the use of an Instagram curriculum within a core pediatric clerkship is feasible, engaging, relevant, and favorably received by medical students. We conclude that Instagram can be successfully integrated into clinical undergraduate medical education.},
    keywords = {Computer science, Curriculum, Formative assessment, Instagram, Instagram Stories, Mathematics education, Medical education, Medicine, Pedagogy, Psychology, Social media, Summative assessment, Technology in education, Undergraduate medical education, World Wide Web, curriculum development, educational content delivery, medical students, pediatric clerkship, social media, social media in medical education, student engagement, undergraduate medical education},
    url = {https://www.tandfonline.com/doi/full/10.1080/10872981.2025.2534064}

}

