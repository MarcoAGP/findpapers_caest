    year = {2018},
    abstract = {The potential use of social media applications (app) and associated technologies in learning and teaching have grown in recent years. Social networking web sites, instant messaging and blogs, have the potential to be used to enhance student engagement and educational outcomes (Junco \& Timm, 2008). Here the aim is to enlighten and support awareness of the opportunities available. \textbackslash{}nSuch approaches allow people to share, stream and watch live-video broadcast and events direct from mobile devices. Within teaching, current activities students are partaking in can be broadcast and distributed. The benefit is that it can be used as a way to bring users/students closer to the action and facilitate participation. \textbackslash{}nThe current work presents student and staff reflections of using social media to boost student confidence and professionalism through the use of mobile devices (such as mobile phones and tablets) with Periscope (a live video-streaming app), Twitter and Instagram (networking services).},
    keywords = {Computer science, Instagram, Internet privacy, Mobile device, Mobile technology, Multimedia, Pedagogy, Psychology, Social media, Student engagement, Twitter, World Wide Web, life sciences education, live streaming, mobile devices, periscope, professionalism, social media in education, student engagement, student self-confidence},
