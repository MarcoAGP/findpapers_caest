@article{alliereynolds2022covid19,
    title = {COVID-19: Perspectives from Students Pursuing... : Plastic \& Reconstructive Surgery},
    author = {Allie Reynolds and Alireza Hamidian Jahromi and Jennifer Akin and Jenna Rose Stoehr},
    howpublished = {Available at https://journals.lww.com/plasreconsurg/fulltext/10.1097/prs.0000000000008996~covid-19-perspectives-from-students-pursuing-plastic-surgery (2022/03/21)},
    journal = {Plastic \&amp; Reconstructive Surgery},
    doi = {10.1097/prs.0000000000008996},
    publisher = {Ovid Technologies (Wolters Kluwer Health)},
    year = {2022},
    pages = {1045e–1046e},
    abstract = {We read with great interest the editorial by Shah et al.1 discussing the challenges faced by prospective plastic surgery students during the current COVID-19 pandemic. We commend the authors for their numerous suggestions, and we would like to propose additional updated recommendations. Medical students of all years should take advantage of the many virtual opportunities and resources available that have been created or expanded during the pandemic to gain exposure to plastic surgery. Social media have emerged as a unique educational platform that gives students up-to-date information about opportunities offered by residency programs and professional societies. Instagram has become a cornerstone in how plastic surgery residency programs communicate with applicants and highlight features of their program. Social media have also been used as a place to access recorded lectures, grand rounds, and informational sessions, as well as to directly communicate with residents and attending physicians. Additional novel virtual resources created during the pandemic include a free self-guided virtual plastic surgery curriculum accessible to medical students worldwide2 and resident-run educational podcasts, such as “The Resident Review,” “The Loupe,” and “Quick Cuts.” These resources allow both preclinical and clinical students to improve their knowledge of plastic surgery and develop connections to the field. Senior medical students face extra challenges and thus may turn to additional resources for support. The Association of American Medical Colleges (AAMC) has set guidelines recommending that students to go on only one away rotation/visiting subinternship for the 2021/2022 match cycle. Thus, virtual engagement will continue to be important this year, as in-person interaction is limited. Sources of guidance and information for applicants, besides individual program websites and social media, include targeted mentorship programs and the “Doctority: Plastic Surgery” podcast. Mentorship programs for underrepresented students in medicine and students without plastic surgery home programs have been announced by certain residency programs, which will be particularly useful in allowing students to make professional connections, receive guidance, and obtain access to financial support during the application cycle. Another applicant-targeted resource, the “Doctority: Plastic Surgery” podcast, interviews plastic surgery residents about their respective programs, and it can be used to prepare for interviews and gain insight about program culture.3 While virtual subinternships were offered last year, it is yet to be determined whether they will be available now that in-person away rotations are available. Thus, applicants should consider reaching out to programs of interest individually to participate in virtual didactics or grand rounds. Finally, despite in-person subinternships, plastic surgery applicants need to prepare for another virtual interview cycle. To do so, we recommend reviewing the excellent published guidance available on this topic.4,5 Once again, we thank the authors for their illumination of the challenges faced by medical students. We hope that the knowledge of these additional resources will help support effective student engagement in the plastic surgery community. DISCLOSURE The authors have no financial disclosures or conflicts of interest to report. Allie ReynoldsPrinceton UniversityPrinceton, N.J. Alireza Hamidian Jahromi, M.D.Plastic and Reconstructive Surgery DepartmentRush University Medical CenterChicago, Ill. Jennifer Akin, B.A.Rush Medical CollegeRush UniversityChicago, Ill. Jenna Rose Stoehr, B.A.Feinberg School of MedicineNorthwestern UniversityChicago, Ill.},
    keywords = {Art, COVID-19 pandemic, Computer science, Cornerstone, Coronavirus disease 2019 (COVID-19), Curriculum, Disease, Face (sociological concept), Infectious disease (medical specialty), Instagram, Medical education, Medicine, Pandemic, Pathology, Pedagogy, Programming language, Psychology, Set (abstract data type), Social media, Social science, Sociology, Visual arts, World Wide Web, away rotations, medical students, mentoring programs, online learning, plastic surgery residency, podcasts, program culture, residency applications, social media, student financial aid, student support resources, underrepresented students, virtual interviews},
    url = {https://journals.lww.com/plasreconsurg/fulltext/10.1097/prs.0000000000008996~covid-19-perspectives-from-students-pursuing-plastic-surgery}

}

@article{fadhilabalqis2021the,
    title = {THE USE OF INSTAGRAM IN LEARNING TO WRITE RECOUNT TEXT: A CASE STUDY OF THE TENTH GRADE OF MAN 3 MEDAN},
    author = {Fadhila Balqis},
    howpublished = {Available at https://jurnaltarbiyah.uinsu.ac.id/index.php/brightvision/article/view/2962 (2021/12/30)},
    journal = {BRIGHT VISION Journal of Language and Education},
    doi = {10.30821/brightvision.v1i2.2962},
    publisher = {MIQOT Jurnal Ilmu ilmu Keislaman},
    year = {2021},
    pages = {219–219},
    abstract = {\&lt;p\&gt;Mobile-Assisted Language Learning (MALL) has populary known as language teaching approach in the last decades. This present study aimed to investigate students‟ engagements on Instagram and their perceptions of its utilization in learning to write recount text. Qualitative research method in the form of case study was employed to conduct this study. The data were collected by using questionnaire, interview, and observation and later analyzed by using thematic analysis. Thirty-five students of MAN 3 Medan were recruited as the participants of this study while three students voluntarily participated in the interview session employed to further dig their perceptions on the use of Instagram in learning to write recount text. The results revealed that, first; most of the students had already used Instagram for personal purposes before the teacher introduced it to them. Second, the students towards its utilization, 1) in terms of positive perceptions, they found Instagram beneficial in exploring more ideas and imagination, encouraging to write better, improving confidence, acquiring other proficient language skills, and discovering online learning tool; 2) for the negative perceptions, the students found some drawbacks which may or may not related to the application itself, such as internet connection issues, violence of privacy, and focus distraction. From those findings, this study concludes that the use of Instagram in learning to write recount text may provide the students with great experiences, however if it is not well prepared, it may as well give negative learning experiences. This study suggests that with some efforts to minimize technical issues, Instagram can be used as an online language learning tool in English classroom during the pandemic.\&lt;/p\&gt;},
    keywords = {COVID-19 pandemic, Computer science, English as a foreign language, Instagram, Mathematics education, Psychology, distraction, mobile-assisted language learning, online learning tools, privacy concerns, recount text writing, social media in language teaching, student perceptions, writing instruction},
    url = {https://jurnaltarbiyah.uinsu.ac.id/index.php/brightvision/article/view/2962}

}

