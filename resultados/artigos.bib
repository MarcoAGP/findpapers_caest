}

@article{pijuyupiter2025instagram,
    title = {Instagram Based Reading Strategies Improve Students’ Comprehension Skills},
    author = {Piju Yupiter and Yoga Pratama and Sri Wahyuni},
    howpublished = {Available at https://pedagogia.umsida.ac.id/index.php/pedagogia/article/view/1937 (2025/06/30)},
    journal = {Pedagogia : Jurnal Pendidikan},
    doi = {10.21070/pedagogia.v14i2.1937},
    publisher = {Universitas Muhammadiyah Sidoarjo},
    year = {2025},
    pages = {226–238},
    abstract = {This study aimed to investigate the effectiveness of using Instagram as a social media platform to enhance students’ reading comprehension among tenth-grade students at SMK 02 Empat Lawang. The research employed a quasi-experimental design involving two groups: an experimental class taught using Instagram and a control class taught through conventional methods. The participants consisted of 62 students, divided equally between the two groups. Data were collected through pre-tests and post-tests comprising 40 multiple-choice questions related to narrative texts. Statistical analysis, including paired sample t-tests and independent t-tests, revealed a significant improvement in reading comprehension in the experimental class compared to the control class. The mean post-test score of the experimental group (75.40) was significantly higher than that of the control group (54.67), indicating that integrating Instagram into reading instruction effectively enhanced students’ engagement and comprehension. The findings suggest that incorporating social media, particularly Instagram, into educational practices can serve as a powerful tool for improving language skills in the digital age. Highlights: Innovative use of Instagram for reading narrative texts. Significant improvement in students’ post-test scores. Suggests Instagram’s pedagogical value in digital learning. Keywords: Instagram, Reading Comprehension, Social Media, Narrative Text, Digital Learning},
    keywords = {Comprehension, Computer science, Digital Learning, Instagram, Linguistics, Mathematics education, Narrative Text, Philosophy, Programming language, Psychology, Reading (process), Reading Comprehension, Reading comprehension, Social Media, language skills, narrative texts, online learning, reading comprehension, social media in education, student engagement, tenth grade students, vocational high school students},
    url = {https://pedagogia.umsida.ac.id/index.php/pedagogia/article/view/1937}

}

@article{rijaarribathdwidaep2025the,
    title = {THE ROLE OF INSTAGRAM IN ENHANCING ENGLISH LANGUAGE SKILLS: A SYSTEMATIC REVIEW},
    author = {Rija Arribath Dwi Daep and Nabilla Nurkhalida and Naf’an Tarihoran},
    howpublished = {Available at https://injoqast.net/index.php/INJOTEL/article/download/1544/1523 (2025/06/01)},
    journal = {International Journal of Teaching and Learning},
    year = {2025},
    abstract = {The increasing use of social media in education has brought new opportunities for language learning. This study systematically reviews the role of Instagram in enhancing English language skills. A systematic literature review (SLR) approach was employed, selecting relevant studies from reputable academic databases published between 2020 and 2024, including Mendeley, PubMed, and Taylor \& Francis, with an initial identification of 921 articles. After screening for relevance and duplication, 57 studies were shortlisted, and 19 empirical studies were selected for in-depth analysis, focusing on Instagram's impact on vocabulary acquisition, writing, speaking, and student engagement. The findings indicate that Instagram positively impacts various aspects of English learning, including vocabulary acquisition, writing, speaking, and engagement. The study highlights the effectiveness of Instagram's features, such as captions, reels, and interactive tools, in fostering language development. Additionally, the research reveals that Instagram enhances motivation and self-directed learning. However, limitations such as internet accessibility and digital literacy remain challenges. The study suggests that incorporating Instagram into English language teaching (ELT) can provide an engaging and practical learning experience. Future research should explore its long-term effects and best implementation strategies in formal education settings.},
    keywords = {Computer science, Computer-mediated communication, Digital literacy, Digital media, Empirical research, English as a second language, English language, English language teaching, English vocabulary, Identification (biology), Instagram, Language acquisition, Literacy, Mathematics education, Media literacy, On Language, Pedagogy, Psychology, Relevance (law), Social media, Sociology, Systematic review, The Internet, Vocabulary, digital literacy, internet accessibility, self-directed learning, social media in education, speaking skills, student engagement, student motivation, vocabulary acquisition, writing skills},
    url = {https://injoqast.net/index.php/INJOTEL/article/download/1544/1523}

}

@article{fikialghadari2025targeted,
    title = {Targeted Digital Outreach-Based Socialization: A Strategy to Enhance Students' Understanding of the Study Program's Academic Vision},
    author = {Fiki Alghadari and Feri Tiona Pasaribu and Silvia Fitriani},
    howpublished = {Available at https://jurnal.unimor.ac.id/index.php/JPSH/article/view/AG (2025/05/29)},
    journal = {Jurnal Pengabdian Sains dan Humaniora},
    doi = {10.32938/jpsh.v4i1.9307},
    publisher = {Universitas Timor},
    year = {2025},
    pages = {1–11},
    abstract = {Promoting lifelong learning opportunities for all was part of the Sustainable Development Goal 4 program. However, transitioning from student to alumni was not always easy. To align students' academic activities with the academic vision of the study program, targeted digital outreach was conducted using videos sent through dominant social media platforms, to improve students' understanding of the program's academic vision. A total of 75 and 46 students participated in the social media survey and understanding test, respectively. The effectiveness of the socialization was evaluated based on student engagement, analysing video performance through social media analytics and measuring improvements in understanding. Results showed a surge in views at specific durations, with students re-watching the video links sent via WhatsApp or Instagram. Additionally, there was a significant improvement in students' understanding of the academic vision, categorized as moderate. Thus, targeted digital outreach-based socialization effectively enhanced students' understanding, though content presentation needed optimization. A collaborative approach was also necessary for broader video distribution.},
    keywords = {Academic vision, Computer science, Engineering, Engineering ethics, Instagram, Law, Mathematics education, Medical education, Medicine, Outreach, Political science, Psychology, Social media, Social psychology, Socialization, Students' understanding, Sustainable Development Goal 4, Targeted digital outreach, WhatsApp, higher education, lifelong learning, social media videos, socialization, student engagement, study programs, video analysis},
    url = {https://jurnal.unimor.ac.id/index.php/JPSH/article/view/AG}

}

@article{vanesyacantika2025pemanfaatan,
    title = {Pemanfaatan Akun Instagram @lib.unand dalam Pemenuhan Kebutuhan Informasi Mahasiswa Universitas Andalas},
