@article{surjadeepduttararivazhaganpradeepe2023leveraging,
    title = {Leveraging Meta Marketing Strategies: Factors influencing the Student Engagement in Academic Libraries.},
    author = {Surjadeep Dutta, R. Arivazhagan, Pradeep.E},
    howpublished = {Available at https://bpasjournals.com/library-science/index.php/journal/article/download/1228/3913 (2023/11/05)},
    journal = {Library Progress (International)},
    year = {2023},
    abstract = {Academic libraries must engage students in a social media-dominated world. Meta (previously Facebook) marketing methods can boost student involvement in academic libraries, according to this study. In the digital age, libraries are multiple learning settings, making student engagement difficult. Meta's Facebook Ads, Instagram postings, and event promos allow libraries to reach students on social media. This study examines how focused Meta marketing efforts affect academic library student engagement rates, including event attendance, resource use, and social media use. Meta marketing strategies increased student engagement significantly. A representative sample of Students who have engaged with the Digital Library from Institutes like SRMIST, VIT-Chennai. Online surveys with a well-organized format that are sent out over email and Whatsapp. Primary variables of interest such as Interactive Content, Event Promotion, Community Building, Gamification and Dependent Variable as student engagement. Descriptive statistics are used to summarise the data, while inferential statistics, such as regression analysis are done. 150 respondents who are using Digital Library. IBM SPSS tool has been used for Analysis. This study's findings highlight that interactive content, event promotion, community building, and gamification, when executed using Meta marketing tactics, exhibit a statistically significant and meaningful correlation with engagement among students and researchers in academic libraries},
    keywords = {Community engagement, Computer science, Customer engagement, Descriptive statistics, Digital marketing, Digital media, Empirical research, Event (particle physics), Facebook marketing, Higher education, IBM, Marketing, Marketing research, Mathematics education, Medical education, Online community, Psychology, Public relations, Resource (disambiguation), Sample (material), Social capital, Social marketing, Social media, Student activities, Student engagement, Variables, academic libraries, community building, digital libraries, event promotion, gamification, interactive content, library marketing, social media marketing, student engagement},
    url = {https://bpasjournals.com/library-science/index.php/journal/article/download/1228/3913}

}

@article{jamieannemarcus2019online,
    title = {Online Educator Entrepreneurship With Facilitator-Created, Subject-Specific Targeted Videos},
    author = {Jamie Anne Marcus},
    howpublished = {Available at https://www.emerald.com/dlea/article/16/1/21/1310231/Online-Educator-Entrepreneurship-With-Facilitator (2019/08/20)},
    journal = {Distance Learning},
    doi = {10.1108/dl-08-2019-0005},
    publisher = {Emerald},
    year = {2019},
    pages = {21–25},
    abstract = {N. Miller (2017) suggests there is a lack of educator persistence and o responsibility to assist the influx of adult learners entering programs in universities and colleges over the last 10 years and who are not attaining degrees. Teachers College Columbia University’s (2013) exhaustive research study shows a 50\% greater chance of failure for online students versus face-to-face students and recommends the creation of effective online environments and an online presence. Vella (2002) explains that adult learners thrive with stimulation of their cognitive, affective, and psychomotor learning pathways and that adult learner audiences excel with instructor respect, collaboration, and the recognition that these busy learners value their time management. Cui, Lockee, and Meng (2013) espouse that online instructors need to actively engage and impress the students particularly with first impressions and that online instructors need sufficient training to properly guide the students. Dong and Poh (2015) posit that present generations thrive in digital environments but material needs to be targeted to their needs. Aparicio, Bacao, and Oliveira (2016) suggest e-learning is empirically a combination of learning and technology. They explain technology-driven videos can promote a quick animated reception, perceptions of sensorial familiarity, and kinesthetic awareness that synergize these e-learning constructs.Seckman (2018) relates that online media could create technical challenges for faculty with changes from traditional classroom settings and frustrations with technological challenges. Harrison (2015) highlights the emergent need to address online video construction. Dong and Poh (2015) suggest that if educators produce their videos that they should attain a “working knowledge of video production and techniques” (p. 141). Harrison posits, “Online videos should be carefully planned to create high quality, concise videos of less than 10 minutes in length, yet contain enough content to reduce the overall number of required videos” (p. 168). The application of the rule of thirds, for example, where the object of interest appears in the intersection of thirds of the screen is successful with hand-held mobile device video production (Cassidy, 2016; Marcus, 2018). Moving and stationary colorful blackboard backgrounds, well-prepared facilitator text, and choreographed movements to create succinct, bite-size videos that cover just one to two main concepts of the class lecture engage the adult online learner (Hew, 2016; Marcus, 2018).Dong and Poh (2015) reiterate the digital advantages of online videos with the autonomy they give the student viewer to fast-forward or replay certain sections for clarification. Hew (2016) recommends that videos be subtitled to assist with clarity of information and posits that problemcentric learning with simple to understand expositions promotes online adult student engagement. Prerecorded videos promote autonomy and immediacy that adult learners respond to (Marcus, 2018; McLean \& Suchman, 2016). Murray, Perez, Geist, and Hedrick (2013) further expounded on concepts of online autonomy for students and how this learning is basically student controlled and assists with materials that are significant, exact, and in a consummate tight content presentation format. Johnson, Trabelsi, and Fabbro (2011) suggest establishing digital resource academic libraries and that this is part of the new global lens for educational dissemination. Marcus (2018) further states that collegiate video libraries should be created by the facilitators of the college rather than an outsourcing online video resource.Short, Williams, and Christie’s (1976) theory on social presence posits that it is contingent on the communication medium and factors such as (a) aesthetic appeal, (b) immediacy, (c) the need to convey genuineness, and (d) intimacy. They also explained the dynamics of visual to verbal signals from the trunks, arms, posturing, standing, sitting, and slouching, as significant influences of social presence. Facilitator length and direction of gaze, eye movements, head nods, and pauses between delivery of information have also been shown to be significant engagement skills (Argyle, 1969; Marcus, 2018).Online video educational lecturers can benefit by theatrical skills of performance including: speakers’ movements, gestures, immediacy of information, and recognition of the viewing audience (Cook \& Schofield, 2017; Marcus, 2018). Richardson, Swan, Lowenthal, and Ice (2016) shared results from their meta-analysis on social presence and explained it as the “Dynamic interplay of instructors, students, instructional designers, instructional strategies, technology, media, and norms coming together to determine the learning outcomes” (p. 480). Kizilcec, Bailenson, and Gomez (2015) explained the need for teachers’ faces in the online forums because historically face-to-face communication has been the principal means of knowledge transfer between humans. Cook and Schofield (2017) explained there is a need for online students to see the teachers-as-people and explained how this will imprint adult learner memory.Cook and Schofield (2017) promoted that online students need to perceive and identify teachers as people and online personalities. This includes the skills of a video presenter with speaker articulation and kinesthetic movements in the delivery of information. Marcus’s (2018) study showed success with facilitator clapping of hands to emphasize points and repeated catch phrases such as, “That’s it in a nutshell.” Online facilitators will benefit, therefore, with training in (a) speech resonance, (b) pace, and (c) articulation. They need practice in how to include the kinesthetic presence of hand gestures and body positioning and movements during the subject-specific videos (Marcus, 2018). Sopczyk, Doyle, and Jacobs (2011) explained that losses in electronic communication (text based) of facial expression and even body posturing could miss the educational message’s intent.Cook and Schofield (2017) report on their study of online video lectures as well as the need for personal identity of the lecturer and illustrated that, “Teachers as people loom large in our adult memories” (p. 58). Future online video educators should practice voice articulation, projection, camera eye contact, virtual audience recognition along with salutations at the beginning and end of the videos to formulate the facilitator persona, genuineness, likability, and transparency to build adult online student trust and relationships (Marcus, 2018).Duffy and Pooley (2017) explained the need to for educators to promote or perish. They suggest that organization social networks such as Academia.edu are present and future pathways of dissemination that support concepts of self-branding. According to Duffy and Pooley (2017) academic entrepreneurship maybe a necessity in today’s competitive professor job markets. They point out that secondary to budget cuts and the vacillating economy of today, a phenomenon of a majority of adjunct/ part-time or nontenure track faculty are now being employed. They further state that the secure nature of professor employment is no longer and that the competitive job markets are a challenge for todays’ educators.J. Miller’s (2017)New York Times article explains the power of self-promotion and that it is no longer exclusively for reality stars such as the Kardashians. She reports hundreds of thousands are watching “regular people” through social networks and the astounding reach of self-promoters who apply Instagram, Twitter, Snapchat, and YouTube. J. Miller (2017) suggests that these social media venues create an enticing social vulnerability and tangibility that build trust and strong relationships and a communitylike following. Marcus’s (2018) study on facilitator-created, subject-specific videos suggests that academicians either through their institutions’ media accounts or with vanity entrepreneurship can find their voices and personas to create their unique educational self-brand to engage and capture the adult online student.All dissemination has changed secondary to technology. Brienza (2016) explains degrees of self-exploitation and free-market capitalism pertaining to neoliberal universities. He espouses that new degrees such as masters (MA) in self-publishing and the breakout commercial success of self-published novels such as E. L. James’s Fifty Shades of Grey series are successful with appeal to a specific market. Cummins (2015) remarks on the success of this novel selling over 100 million copies mostly to a target market segment, in this case, surprisingly, women.The phenomena of cosmetic mogul Kylie Jenner’s 100\% self-owned and promoted make-up/lip plumper products also show the success of a specific product with a young consumer market. Ms. Jenner’s success was catapulted by her previous reality television identification, and constant social media vehicles such as Twitter and Snapchat. Her appeal was with a specific product to a specific market and, according to Forbes magazine, she will most likely be the youngest self-made billionaire of all time (Robehmed, 2018). Understanding, therefore, the culture of the market of individuals you wish to reach, and the ability to reach them to forge relationships exponentially catapults technologically driven disseminations.Allison and Rehm (2016) explained that online educators need to enhance their practice from the delivery of information to the reproduction of the essence of a real face-to-face traditional classroom student experience. Giannakos, Chorianopoulos, Ronchetti, Szegedi, and Teasley (2014) posit there is no present consolidated resource for video educational learning. Gormley (2013) concludes that particular with online nursing education programs accommodations need to be made secondary to expanding shifts to computer-based technologies in nursing education, for example, from previous conventional presentations of programs, assignments, and course subjects. Marcus (2018) informs on pragmatic and emotional survey data that support success for adult nursing education students in accelerated programs. These students felt the teacher’s social presence and grasping of advanced subject material with incorporation of facilitator-created, subject-specific videos.McLuhan, Fiore, and Agel (1967) explicated, “All media are extensions of some human faculty psychic or physical” (p. 26). Ivory Tower distance educators will be replaced by familiar educator social media personalities. Online educator entrepreneurship with facilitator-created, subjectspecific, targeted videos are part of the future pathway for academia.},
    keywords = {Computer science, Entrepreneurship, Facilitator, Law, Pedagogy, Political science, Psychology, Social psychology, Subject (documents), World Wide Web, adult learners, faculty training, online course completion, online learning, online video production, rule of thirds, student engagement, student retention, student satisfaction},
    url = {https://www.emerald.com/dlea/article/16/1/21/1310231/Online-Educator-Entrepreneurship-With-Facilitator}

}

@article{ridanoorrehman2019using,
    title = {Using social media for student engagement: A study of two New Zealand academic libraries},
    author = {Rida Noor Rehman},
    howpublished = {Available at https://ir.wgtn.ac.nz/items/4b782029-f1ac-428d-8a60-c030aad02987 (2019/01/01)},
    journal = {ResearchArchive–Te Puna Rangahau (Victoria University of Wellington)},
    year = {2019},
    abstract = {Research Purpose:\textbackslash{}nThis research is an exploration of the content created for social media by two New Zealand academic libraries: Auckland University of Technology libraries and Massey University libraries. It analyses the content of the posts these libraries create for engaging students in conversations on Facebook and Instagram. The likes and comments on the posts are also analysed to better understand student engagement through social media.\textbackslash{}n\textbackslash{}nMethodology:\textbackslash{}nA content analysis method was applied for this study. An inductive approach was applied to analyse the posts and comments. This was done in the form of coding to find themes that emerge from the posts and comments. Furthermore, likes and comments were recorded to understand the picture that Facebook and Instagram portray of engagement. All the data was analysed quantitatively and qualitatively to get an understanding of student engagement from the profiles of the above-mentioned academic libraries.\textbackslash{}n\textbackslash{}nResults:\textbackslash{}nThe posts data showed that both libraries are using social media for promotional purposes to engage students. AUT library had more thankful/complimentary comments despite having a lower number of comments compared to Massey University library because AUT Library are focused on forming connections with the AUT community. The results also shed light on the platform metrics as they don’t add value in our understanding of student engagement.\textbackslash{}n\textbackslash{}nImplications:\textbackslash{}nBased on the findings of this study, this researcher discussed practical strategies for academic libraries to effectively use social media for facilitating student engagement.},
    keywords = {Academic libraries, Computer science, Content analysis, Facebook, Instagram, Librarians, Library science, Media studies, Pedagogy, Political science, Public relations, Social media, Sociology, Student engagement, World Wide Web, academic libraries, library marketing, social media, student engagement},
    url = {https://ir.wgtn.ac.nz/items/4b782029-f1ac-428d-8a60-c030aad02987}

}

@phdthesis{zowdamuhamoudali2026behind,
    title = {Behind the Brand: How Employees and Students Make Sense of Digital Branding in Higher Education},
    author = {Zowda Muhamoud Ali and Nora Mohamed},
    howpublished = {Available at http://urn.kb.se/resolve?urn=urn:nbn:se:hj:diva-71965 (2026/01/01)},
    year = {2026},
    abstract = {Background: The growing use of digital communication has transformed how higher education institutions portray themselves and engage with stakeholders. Universities create digital brand images using websites, social media, and online platforms to attract students, enhance reputation, and convey institutional identity. However, stakeholders actively interpret, assess, and contrast these digital representations with their real-world experiences. Purpose: This study aims to investigate how employees and students interpret internal digital branding practices in higher education. Using Jönköping International Business School (JIBS) as a case study, the research explores how internal stakeholders understand the university's digital image, how expectations are shaped by digital branding, and how the relationship between digital communication and daily university experiences shapes perceptions of authenticity. Method: This study employs a qualitative single-case study design. Semi-structured interviews were conducted with 16 participants, including JIBS employees and students. A qualitative content analysis of the university's Instagram, TikTok, and LinkedIn communication was also carried out to supplement the interview findings. Sensemaking Theory served as the theoretical foundation for the thematic analysis of the gathered data. Conclusion: The findings reveal that digital branding in higher education is actively interpreted through continuous sensemaking processes rather than passively absorbed. Students and employees constructed the university's digital image around themes of internationalization, professionalism, employability, and institutional credibility, while acknowledging the selective and promotional nature of digital communication. When evaluating authenticity, stakeholders continuously assessed how well digital representations aligned with lived experiences. Platform-specific communication strategies produced disparate but complementary institutional identities: Instagram and TikTok emphasized relatability and student life, while LinkedIn focused on professionalism and academic success. By centring the internal interpretive processes through which stakeholders encounter, negotiate, and evaluate digital branding, this study contributes to the existing literature on higher education branding.},
    keywords = {Activity theory, Business, Business communication, Computer-mediated communication, Corporate branding, Digital content, Digital learning, Digital marketing, Digital media, Digital strategy, Digital transformation, Electronic publishing, Higher education, Instagram, Institutional theory, Internal communications, Knowledge management, LinkedIn, Marketing, Multimethodology, Online presence management, Organizational communication, Pedagogy, Perception, Product (mathematics), Psychology, Public relations, Qualitative property, Qualitative research, Semi-structured interview, Sensemaking, Social media, Sociology, Thematic analysis, TikTok, authenticity, digital branding, digital communication, employability, institutional credibility, institutional identity, internationalization, professionalism, sensemaking, social media communication, university branding, university employees, university students},
    url = {http://urn.kb.se/resolve?urn=urn:nbn:se:hj:diva-71965}

}

@techreport{adamgcole2023final,
    title = {Final Report for the 2022-23 Peer Wellness Education Pilot Project at Ontario Tech University},
    author = {Adam G. Cole and Salma Bafagih and Victoria Palmer and Annika Schoeman},
    howpublished = {Available at https://ontariotechu.scholaris.ca/items/5d483813-fc92-426d-9005-db6359e3194c (2023/01/01)},
    year = {2023},
    abstract = {University students are known to be physically inactive, have a poor diet, and engage in substance use, all of which correlate with a variety of chronic conditions and poor health outcomes. During this stage of life, especially as many university students are living away from home for the first time, young adults will set habits that can be potentially helpful or harmful to their health and academic success. Peer-to-peer programs and education strategies can be an effective method to reach many students on campus, foster a campus community, increase knowledge and awareness of healthy behaviours, and recognize and refer students to appropriate resources. In March 2022, a grant was awarded to pilot test a Peer Wellness Education Program at Ontario Tech University through the Faculty of Health Sciences Dean’s Discretionary Teaching Innovation Fund. The Peer Wellness Education Program provides opportunities for students to gain hands-on experience in the field of health promotion, improve their skills, meet other students, and learn health tips that can be used in their own lives. In the Spring/Summer semester, a team of 6 students created 3 display boards for social marketing campaigns and 4 sets of palm cards. A team of 11 students in the Fall semester and 15 students in the Winter semester worked together to implement the social marketing campaigns and distribute the resources created in the Spring/Summer semester. Throughout the year, team members contributed over 370 hours to implement various display booths, health promotion events, and workshops organized by the Peer Wellness Education Program and Ontario Tech Health Promotion. The Peer Wellness Education team volunteered at over 77 health promoting events, interacted with over 2080 students, and disseminated over 4450 health promotion resources. The team also created social media posts on Instagram to promote the program, created blog posts for the Ontario Tech Digital Community, and created two additional display boards during this time. Although few students could directly name the Peer Wellness Education team or Ontario Tech Health Promotion as a program or service on campus without prompting during intercept interviews, the majority of surveyed students had seen or heard about a health promotion activity. Team members reported an increase in knowledge of health promotion concepts and an increase in skills related to engaging students in conversations about their health and creating informative and appealing health education resources after volunteering with the Peer Wellness Education team. The Peer Wellness Education pilot project was very successful. A large volunteer team and collaborations with Athletics and Recreation and Student Life maximized the reach and engagement with students. Students seemed to be excited to be on campus again and readily engaged in conversations with student volunteers. The Peer Wellness Education Program will maintain the momentum achieved over the past year and continue programming into the 2023-24 academic year. Over the next year, the team will create additional social marketing campaigns, create a social media plan, and identify a central space for storing Health Promotion materials.},
    keywords = {Academic year, Best practice, College health, Education, Health care, Health education, Health promotion, Higher education, Medical education, Medicine, Pedagogy, Peer Wellness, Peer education, Peer group, Peer support, Pilot program, Program evaluation, Promotion (chess), Psychology, Public relations, Set (abstract data type), Social marketing, Social media, Test (biology), Variety (cybernetics), campus health promotion, health promotion events, healthy behaviours, social marketing campaign, student health, student volunteers, university students},
    url = {https://ontariotechu.scholaris.ca/items/5d483813-fc92-426d-9005-db6359e3194c}

}

@techreport{juliaoh2021health,
    title = {Health Promotion and Social Media Engagement of Students and UBC Recreation},
    author = {Julia Oh and Morgan Lorenz and Jennifer Nipp and Nikki Stewart Hunter and Karmen Leong},
    howpublished = {Available at http://hdl.handle.net/2429/78668 (2021/01/01)},
    doi = {10.14288/1.0398400},
    year = {2021},
    abstract = {The aim of this research paper was to explore current UBC Vancouver (UBCV) student’s motivation to follow or not follow UBC Recreation and Athletics (UBC Rec) social media pages, specifically Facebook and Instagram. Through our research, we identified strategies UBC Rec can use to get students more interested and engaged with their health-related content. Sedentary time among students has increased especially due to the COVID-19 lockdown (Romero-Blanco et al., 2020). As increases in sedentary time is positively associated with poor health outcomes such as cardiovascular disease (CVD), cancer, and obesity, increasing physical activity is of utmost importance as it would have profound effects on both the individual and society as a whole (Romero-Blanco et al., 2020). In order to approach our research question, we created an online survey consisting of 19 questions using Qualtrics. Survey questions were aimed at assessing students’ current status with UBC Rec social media pages. It included topics such as demographics, current physical activity levels, current engagement levels with UBC Rec content on social media, and recommendations for UBC Rec. The online survey was distributed through our personal social media accounts. This was done via private messaging and posting in large Facebook groups to increase exposure. After the recruitment period, we collected 61 responses and used a combination of quantitative and qualitative analysis to decode open-ended questions into meaningful categories. Our data showed that most of our respondent profiles of UBC students have not previously been engaged in UBC Recreation programs or do not follow them on their social media pages. Most of the respondents shared interest in following UBC Recreation social media in order to get information on upcoming events on campus or to get inspiration for workouts. It is evident based on the assessed population that new techniques or communication outreach can be made in order to increase traction and engagement among the target population. Our findings led us to four recommendations to our project partner, UBC Rec. Our first recommendation is to use posts on Instagram as opposed to IGTVs or Reels. Our second recommendation is to post more about nutrition and quick workouts that students can easily follow while working from home or studying. Our third recommendation is to increase promotion by making media partnerships with other UBC organizations such as UBC Wellness and UBC Student Life. Lastly, we recommend that they use incentives and create fun challenges to increase flow to their content and social media pages. We hope that through our analysis and recommendations, UBC Rec will be able to better engage the student population to encourage physical activity and improve health and quality of life. Disclaimer: “UBC SEEDS provides students with the opportunity to share the findings of their studies, as well as their opinions, conclusions and recommendations with the UBC community. The reader should bear in mind that this is a student project/report and is not an official document of UBC. Furthermore readers should bear in mind that these reports may not reflect the current status of activities at UBC. We urge you to contact the research persons mentioned in a report or the SEEDS Coordinator about the current status of the subject matter of a project/report.”},
    keywords = {Advertising, Business, COVID-19 lockdown, Computer science, Facebook, Health promotion, Instagram, Law, Medicine, Nursing, Political science, Politics, Promotion (chess), Public health, Public relations, Recreation, Social media, Sociology, World Wide Web, campus recreation, health communication strategies, health promotion, media partnerships, sedentary time, social media engagement, student physical activity, student wellness programs, university students},
    url = {http://hdl.handle.net/2429/78668}

}

@article{widiasetiawati2026health,
    title = {Health Communication Pattern of BIMAWA UAD in Supporting Mental Health for Students},
    author = {Widia Setiawati and Dani Fadillah},
    howpublished = {Available at http://journal2.uad.ac.id/index.php/commicast/article/view/16988 (2026/09/14)},
    journal = {COMMICAST},
    doi = {10.12928/commicast.v7i2.16988},
    publisher = {Universitas Ahmad Dahlan},
    year = {2026},
    pages = {185–200},
    abstract = {The mental health of students is an issue that is increasingly receiving serious attention in higher education environments, especially after the COVID-19 pandemic which worsened students' psychological conditions due to limited social interaction, academic pressure, and adaptation crises. This study examines the health communication patterns implemented by the Student Affairs Bureau (BIMAWA) of Ahmad Dahlan University (UAD) in assisting students' mental health, as well as to identify communication barriers faced in the process. This study uses a qualitative approach with a descriptive method, where data is collected through in-depth interviews with two BIMAWA staff and one student who utilized this service, supported by program documentation. Data is analyzed using Braun and Clarke's thematic analysis with the application of source and method triangulation to ensure the validity of the findings. The results of the study identify four main themes, namely (1) the integrated use of verbal and non-verbal communication through seminars, counseling, and empathetic approaches; (2) the implementation of multi-channel communication strategies that combine digital platforms such as Instagram, Telegram, email, and face-to-face communication; (3) mental health messages that are trifunctional, namely educational, persuasive, and motivational, tailored to the learning stages of students; and (4) communication barriers that include psychological stigma, gaps in digital literacy, and limited access to information. This study concludes that BIMAWA UAD has implemented a systematic and adaptive health communication pattern, although efforts to eliminate stigma and strengthen digital literacy still need to be improved. These findings have implications for the importance of developing inclusive and sustainable health communication strategies in university environments to support students' overall mental well-being.},
    keywords = {Adaptation (eye), Applied psychology, COVID-19 pandemic, Data collection, Digital divide, Digital health, Digital literacy, Health communication, Health education, Health literacy, Higher education, Medical education, Mental health, Mental health literacy, Nursing, Plan (archaeology), Psychological intervention, Psychology, Qualitative property, Qualitative research, Social psychology, Stigma (botany), Thematic analysis, Triangulation, communication barriers, counseling, digital literacy, health communication, higher education, mental health stigma, multi-channel communication, nonverbal communication, student mental health, university student affairs},
    url = {http://journal2.uad.ac.id/index.php/commicast/article/view/16988}

}

@inbook{josieahlquist2023welcome,
    title = {Welcome to Your Digital Leadership Purpose},
    author = {Josie Ahlquist},
    howpublished = {Available at https://www.taylorfrancis.com/chapters/mono/10.4324/9781003444244-3/welcome-digital-leadership-purpose-josie-ahlquist (2023/06/21)},
    doi = {10.4324/9781003444244-3},
    publisher = {Routledge},
    year = {2023},
    pages = {9–31},
    abstract = {The superpower of digital leadership is the ability to connect a purpose with platforms to help people. Two associations that have attempted to formalize competencies around technology are Student Affairs Administrators in Higher Education and College Student Educators International. Facebook provides a groups feature that allows users to create groups with varying levels of privacy and invite others to join them. Gruzd et al. declared that Twitter was “a good case to understand how people integrate information and communication technologies to form new social connections, collaboration and conversation”. Researchers placed YouTube under the category of social networks early on. In addition, as social media algorithms make it increasingly difficult to see posts chronologically, more and more users are opting in to the simpler interfaces and in-the-moment benefits of the stories feature provided by Instagram and other social media platforms. Similar to YouTube and Instagram, Snapchat has attracted a younger demographic, with its most active users ages 18 to 34 years.},
    keywords = {Computer science, Facebook groups, Instagram Stories, Political science, Snapchat, Twitter, YouTube, digital leadership, purpose, social networking sites, social networks, student affairs professionals, technological competence, younger audiences},
    url = {https://www.taylorfrancis.com/chapters/mono/10.4324/9781003444244-3/welcome-digital-leadership-purpose-josie-ahlquist}

}

@book{brandonwaite2020social,
    title = {Social Media for Student Affairs in \#HigherEducation},
    author = {Brandon Waite and Darren A. Wheeler},
    howpublished = {Available at https://www.bloomsburycollections.com/monograph?docid=b-9798216457978 (2020/01/01)},
    doi = {10.5040/9798216457978},
    year = {2020},
    abstract = {Given the ubiquity of online technologies in the lives of high school and college students, universities are increasingly turning to social media for the purpose of organizational communication. This book shines a light on these practices in order to better understand how platforms such as Facebook, Twitter, Instagram, and Snapchat are being used within the realm of student affairs. Each chapter will explore a different dimension of student affairs (e.g., admissions, career services, student health services) to provide an overview of key challenges and how new social media tools can be used to solve them. By providing examples that illustrate these evolving trends, this book is intended to help higher education professionals develop creative social media solutions that are appropriate for their own situations as they seek to strategically integrate social media into their student affairs efforts.},
    keywords = {Dimension (graph theory), Emerging technologies, Engineering ethics, Facebook, Higher education, Human Dimension, Instagram, Key (lock), Media studies, Online learning, Order (exchange), Pedagogy, Political science, Public relations, Realm, Snapchat, Social media, Sociology, Student affairs, Twitter, career services, collections, higher education, organizational communication, social media, social media strategy, student health services, student support services, university admission},
    url = {https://www.bloomsburycollections.com/monograph?docid=b-9798216457978}

}

@article{georginaargüello2019virtual,
    title = {Virtual Advising},
    author = {Georgina Argüello and María Grethel Méndez},
    howpublished = {Available at https://www.emerald.com/dlea/article/16/2/51/1310331/Virtual-AdvisingA-Tool-for-Retention-Engagement (2019/12/26)},
    journal = {Distance Learning},
    doi = {10.1108/dl-12-2019-0006},
    publisher = {Emerald},
    year = {2019},
    pages = {51–57},
    abstract = {Ahypothetical student, Mary J., is a graduate distance learner at a private not-for-profit university. She works full time, has family obligations, and has decided to go back to school to pursue a graduate degree. She has the support of her family and employer. Although Mary J. was very excited and motivated to start her coursework, after a month into the program, she feels overwhelmed and is ready to give up. Based on what she had learned at the new student orientation, her university offers e-advising services, which may assist her with the situation she is encountering.Online education is a vital part of the digitized realm of higher education. Quality online education is normally encouraged. However, quality online student support services, such as academic advising, has lagged. Even though online enrollments tend to rise annually, student attrition rates in distance education have a tendency to be greater than that of traditional programs due to feelings of isolation.The number of nontraditional students in distance education programs has increased in the past years. The majority of these students experience feelings of isolation and anxiety. As a result, they drop out from their program of study without being able to graduate. Studies indicate that student attrition rates in online higher education programs tend to be 3\% to 5\% higher compared to those in traditional programs (U.S. News and World Report, 2015). Student retention in online courses is an ongoing concern for higher education institutions. This apprehension remains as online enrollment continues to increase. As a result, the guidance of an academic advisor, especially the virtual advisor, plays a crucial role in extending a “lifeline” to the diverse needs of online students, by providing a supportive relationship (Ludwig-Hardman \& Dunlap, 2003).The use of effective technologies is critical to virtual advising, and employing these tools is paramount. When using virtual advising tools, current advisors “flip” the way on-campus advisement is delivered (Steele, 2016). Virtual academic advisors enhance their interactions with the distance learner by using online advising tools and resources, such as e-mails, web chats, video conferencing, blogs, podcasts/ vodcasts, virtual learning environments (e.g., Canvas), and social networking sites. Consequently, academic advisors, administrators, faculty, and staff in higher education institutions will be able to build a bridge that will encourage, support, and ensure that the distance learner remains engaged, succeeds, and graduates.The challenge of virtual advising is to apply the vast array of online advising technologies, in order to improve the quality of academic advising for distance learners. Virtual advising is a way to supplement, rather than displace, face-to-face advising (Waldner, McDaniel, \& Widener, 2011). As the online student population is growing, virtual advising services must also increase in order to provide students with a viable connection to the university. The purpose of this paper is to illustrate how virtual advisors and the tools they employ can enhance and confirm the success of students registered in online programs at institutions of higher learning. This article presents critical reasons for implementing a virtual academic advising model to reduce attrition rates in online programs, as well as explores solutions to boost retention, success, and graduation rates. Furthermore, it provides the strategies necessary for a successful virtual advising program. Examining these issues is vital to contemporary learning environments.Online course enrollment has seen an increase in the past years, but student perseverance and retention is lower in online programs than in traditional ones (Cochran, Campbell, Baker, \& Leads, 2014). As a result, it is important to understand the characteristics of the students who choose online learning. Students who participate in distance education courses are adults working full-time jobs, raising a family, taking care of their parents, and having an active lifestyle. These nontraditional students make up a large percentage of the student population in colleges. Furthermore, they may be reluctant and afraid of returning to college, and are not engaged in face-to-face interactions with any advisor, faculty, or staff at the university. Additionally, they may encounter other challenges, such as lack of study habits, technology skills, goal setting abilities, work–life balance, and stress management. As evidenced, they have many responsibilities beyond their current graduate programs.Distance learners usually feel a sense of disconnection and anxiety, which the academic advisor mitigates with support and a positive relationship. The traditional 18– 22-year-old student who attends face-to-face classes has the opportunity to just walk up to the advising office and meet with a counselor, but the online student lacks this physical accessibility. Pursuing online courses requires learners to be dedicated, motivated, proactive, prepared, and focused. In addition, they need the following characteristics to be successful in a distance education class: initiative, persistence, organization, engagement, and aspiration (Central Michigan University, n.d.). This is where the role of the virtual academic advisor comes into play and offers a lifeline that will assist in meeting these challenges, and thus improve student retention and success.In order to address these issues experienced by the distance learners, the way we think of academic advising needs to evolve and adapt. Academic advising offers a path to promote student retention and persistence to graduation (Kulls, 2016). According to Schlosser, Knox, Moskovitz, and Hill (2003), graduate advising is key in student satisfaction, success, and retention. Furthermore, these authors defined the advisor as the individual who “has the greatest responsibility for helping guide the advisee through the graduate program” (p. 179). In a national survey of 27 universities, conducted by Zhao, Golde, and McCormick (2007), graduate students reported the greatest satisfaction when they received constant and productive feedback, and availability of the advisor when needed. As evidenced, advisees require and value accessible and timely support from their advisors. Due to the characteristics of the online learner (time constraints, family and professional obligations), virtual advisors need to avail themselves of the technology tools necessary to bring the on-demand “advising session” to the student. Therefore, implementing a virtual advising model will help provide solutions to boost retention, success, and graduation rates among distance learners.Virtual advising or e-advising is a way to provide a minimum set of essential sensitive, flexible, and creative services, relating to academic advising, which supports online students in recognizing and achieving their determined educational goals (Polson, 2003; Varney, 2009). It is relevant that academic advisors strive to recognize and meet students’ needs proactively, making necessary adjustments to the established structures. Starks (2011) pointed out that by building and maintaining effective communication skills, the virtual advisor could overcome the challenge of creating relationships in the absence of direct contact.Online students can seek assistance from their virtual advisor in a myriad of ways, with e-mail messages and phone calls being the most common methods. Distinct from traditional advising, where the advisor can see the students’ visual cues and cultivate a positive advising relationship, the virtual advisor is restricted to the strategic use of words and the proper tone of voice to create a trusting and proactive advising relationship (Ohrablo, 2016). Virtual advisors need to keep this in mind when using other technology tools.Implementing effective technology tools into academic advising is vital for student success. Online tools hold the promise of delivering advising services in financially difficult times. Proper design is a key to unlocking this challenge. Higher education institutions have made efforts to update the way advisors communicate with students according to the current technology trends. Incorporating technology to achieve efficiency in virtual advising can provide better student services and improve student interaction (Multari, 2004).Technology cannot replace the interaction between the virtual advisor and the advisee. It needs to go hand-in-hand as a tool to enhance engagement. Nevertheless, technology breaks down the existing barriers of time and place faced by online learners, as they may reside in different time zones, and due to other professional and personal obligations, do not have access to an advisor. Students feel isolated and disconnected without the personal connection that a virtual advisor provides. Advisors encourage students to develop intellectually, physically, and personally. Additionally, they help address the causes of poor retention, misunderstanding of the difficulty of online courses, poor study habits, tendency to procrastinate, and lack of connection to peers. Advisors must use technology as a bridge between the students’ virtual scene and the higher education institution.We recommend that virtual advisors use the following tools to retain, engage, and promote success among graduate distance learners:The main purpose of the mandatory online orientation is to provide an overview of topics critical to ensuring students’ success in their program of study. Topics may include:Higher education institutions can adopt an online degree audit system, which will allow students to review degree requirements. Online degree audit systems are an easy to use tool to help students track progress toward degree completion. This is an unofficial tool, unlike the official transcript. Therefore, constant communication between the academic advisor and the advisee is required to ensure the information on the degree audit is accurate and complete.Electronic communication is one of the most common ways of advising traditional and distance education students. Virtual advisors should take the necessary time to respond to e-mails as if they were advising face to face. Furthermore, it is important to keep in mind that this type of communication creates a “paper trail.” Best practices encourage advisors to respond to e-mails in a timely fashion (24- to 48-business hours), and to anticipate students’ needs, options, and resolutions to concerns (Ohrablo, 2010). In order to understand the needs of the online student, advisors need to be proactive and send targeted e-mails as reminders of upcoming registration deadlines, workshops, and other relevant information. Advisor created templates may be useful in preparing these types of e-mails.The use of videoconferencing tools, such as GoToMeeting, Skype, or Zoom, provide real-time support services to distance learners. Videoconferencing replicates an in-person advising session. Virtual advisors and students have the opportunity to familiarize themselves with each other and review documents more efficiently with the use of this tool (Ohrablo, 2016). Implementing videoconferencing sessions helps virtual learners feel connected and engaged with their program of study and university. Consequently, another benefit is the ability to record the session for future reference.Early alert systems are tools used to improve student retention and boost academic success. This instrument helps identify at-risk students and assist with interventions (Hanover Research, 2014). These systems provide assistance and early feedback to students at the exact time of academic need. Moreover, an early alert system is a way of sharing responsibility among the faculty, advisor, and student. Early alert systems can direct students to suitable resources at the precise time of need. Higher education institutions that have these programs demonstrate to students that advisors and faculty care about their academic progress and general well-being (Arkansas State University, 2010).Distance learners are using social network sites, such as Facebook, Twitter, or Instagram to seek academic advising help and obtain information about academic matters. Social media is a way of connecting the student with the higher education institution. According to a study done by Amador and Amador (2014), participants considered the use of social media beneficial for seeking help and were open to interacting with advisors and other higher education personnel.As previously mentioned, the use of effective technologies is critical to distance advising. Therefore, in order to provide distance learners with the 24/7 service they are accustomed to, advisors need to provide students with rich multimedia resources with on-demand access. A VLE hub will flip the advising model and fulfill this need. In order to mitigate the learning curve, the “hub” will use the same learning management system used by the institution (e.g., Canvas, Blackboard, etc.). This flipped model puts more of the responsibility for obtaining basic information on the students, which is similar to how they seek information in their daily lives.The hub or VLE will offer a “one-stop shop” of relevant information, links, and myriad other academic and advising resources. This hub will provide high-quality advising services to online students, who have other conflicting responsibilities that interfere with regular office hours. The advising team develops, monitors, and updates the essential elements of the hub. As indicated, students should be familiar with the layout of the hub, as it resembles the format of their online courses. All students, upon admission, will acquire access to the VLE. This hub will remain available to the student until degree completion. Virtual learning environments provide on-demand access and personalized advising. This timely responsiveness and connection with an advisor promotes a successful college experience and caring attitude, making it a powerful retention tool.The hub should include the following information:A virtual learning environment addresses the four components of a quality-advising model: centralized communication, problem solving, relationship management, and administrative processing (Simpson, 2018). The hub not only benefits the virtual student, but also the traditional student. Although there may be a minimal cost to set up the hub (VLE shell), ultimately, it is more efficient. If additional funds are available, the hub should host an artificial intelligence chat-bot to assist with general questions and provide a warm touch to the distance learner.As the presence of distance learners continues to increase in higher education institutions, it is imperative that virtual advisors wisely use various technology tools to engage, support, and retain students. Online academic advisors need to provide “concierge service” on one hand, and a virtual learning environment, on the other, for the countless university processes and bureaucracy. These services are not only expected by the student, who experiences the current online retail market, but also it provides the immediate response that helps maintain a transparent relationship, and assists with engaging the student. By using these tools, e-advisors are able to assist students with academic planning, decision making, and problem solving without neglecting other key elements of advising.We recommend virtual advisors use proactive advising communication techniques, such as targeted e-mails, supportive phone calls, virtual office hours, instant chat, social network sites, early alert systems, new student online orientations, videoconferencing, and a virtual learning environment. The e-advisor uses these measures to frequently monitor student progress and provide problem-solving solutions. By using positive active listening, the advisor demonstrates constructive advising techniques to open the lines of communication to support student success and the attainment of goals. These strategies lead to increased student satisfaction and decreased attrition. Ultimately, the aforementioned tools will help build a virtual community that engages and retains the online graduate student.},
    keywords = {Apprehension, Attendance, Attrition, Canva, Curriculum, Digital native, Disappointment, Distance education, Download, Drop out, Feeling, Graduate students, Higher education, Isolation (microbiology), Mathematics education, Medical education, Online chat, Online course, Online discussion, Online learning, Pace, Pedagogy, Psychological intervention, Psychology, Public relations, Quality (philosophy), Realm, Student engagement, The Internet, distance learners, non-traditional students, social networking sites, student attrition, student engagement, student isolation, student retention, supervisor-student relationship, videoconferencing, virtual learning environments},
    url = {https://www.emerald.com/dlea/article/16/2/51/1310331/Virtual-AdvisingA-Tool-for-Retention-Engagement}

}

@article{susancamphor2026student,
    title = {Student Co-Creation of Instagram Content to Enhance Learning, Engagement and Belonging in Level 4 Nursing},
    author = {Susan Camphor and Kate O'Keefe},
    howpublished = {Available at https://openjournals.ljmu.ac.uk/studentexp/article/view/4007 (2026/09/02)},
    journal = {Liverpool John Moores University},
    doi = {10.24377/learningex4007},
    year = {2026},
    abstract = {Project Summary The Curriculum Enhancement Internship built on an existing Level 4 Nursing Instagram pilot, established in January 2026 to enhance communication with a large cohort, particularly when students were on placement and away from the University. The pilot used a familiar digital platform to maintain connection, share information and support engagement. Curriculum Enhancement funding enabled the project to move beyond staff-created content by placing students at the centre of development and exploring intellectually stimulating and engaging teaching through student co-creation. The project was underpinned by the principles of students as partners/co-creators and student-developed curriculum, enabling student content creators to identify priorities, shape the agenda and develop material in response to their peers’ learning and support needs. Seven student content creators collaborated with one another, the project leads and the wider cohort. Projects included transition-to-Level-5 content, interviews with module leaders, study and assessment guidance, medication quizzes, careers content, information about Academic Success services, and material exploring nursing practice and healthcare systems internationally. The project benefited both the wider cohort and the creators. Student-created content was well received, particularly material supporting transition into Level 5. Through researching, questioning, explaining and communicating information, creators moved beyond content production and began to take on the role of peer educators. They developed skills in prioritisation, collaboration, communication, quiz design, interviewing, digital and media production, community building and evaluation, alongside increased confidence and understanding of their programme. Future work will extend evaluation and co-creation. Questionnaire findings will inform student-supported focus groups, with creators contributing to evaluation and gaining further experience of research methodology. Findings will be disseminated through publication and conference presentation. Current creators will also support the September 2026 cohort Instagram page and help recruit new student content creators, to establish a sustainable cycle of peer education in which students support those who follow.},
    keywords = {Best practice, Community engagement, Community of practice, Content (measure theory), Content analysis, Content creation, Curriculum, Curriculum development, Digital content, Digital health, Digital learning, Digital media, Experiential learning, Focus group, Health care, Instagram, Internship, Medical education, Medicine, Nurse education, Nursing, Pedagogy, Peer learning, Program evaluation, Project-based learning, Psychological intervention, Psychology, Public relations, Social media, Sociology, Student engagement, Work (physics), Work experience, curriculum improvement, nursing education, peer education, peer educators, school belonging, social media in teaching, student co-creation, student engagement},
    url = {https://openjournals.ljmu.ac.uk/studentexp/article/view/4007}

}

@article{julielunatorres2026improving,
    title = {Improving pediatric inflammatory bowel disease outcomes through social determinants of health interventions},
    author = {Julie Luna‐Torres and Edwin F. de Zoeten and Tolulope O. Falaiye and Pooja Mehta},
    howpublished = {Available at https://onlinelibrary.wiley.com/doi/10.1002/jpn3.70313 (2026/01/08)},
    journal = {Journal of Pediatric Gastroenterology and Nutrition},
    doi = {10.1002/jpn3.70313},
    publisher = {Wiley},
    year = {2026},
    pages = {642–646},
    abstract = {Understanding the relationship between social determinants of health (SDOH) and pediatric inflammatory bowel disease (IBD) is essential for delivering equitable care. SDOH are the conditions in the environments where people are born, live, learn, work, play, worship, and age that affect a wide range of health, functioning, and quality-of-life outcomes and risks. These are grouped into five categories: economic stability, neighborhood/built environment, healthcare access/quality, education access/quality, and social/community context. Marginalized groups are most affected by SDOH, often stemming from historical inequities. Moreover, there is a strong link between poverty and race in the United States, rooted in structural racism and discrimination.1 Figure 1 depicts an overview of SDOH and pediatric IBD. This article explores how each SDOH category impacts pediatric IBD and offers solutions for improved care. Children with IBD from low-income families have higher healthcare utilization rates and face more financial strain from direct and indirect costs. One study found that compared with children from higher-income neighborhoods, children from low-income neighborhoods were 17\% more likely to require hospitalization, 21\% more likely to visit the emergency department, and nearly four times as likely to have IBD-related clinician visits. Moreover, children with Crohn's disease (CD) in these neighborhoods had a 22\% higher risk of needing surgery within 3 years of diagnosis.2 Socioeconomic factors, particularly public insurance status, exacerbate these disparities in care access and outcomes. Beyond direct healthcare costs, indirect costs like transportation, specialized diets, and lost parental work time add significant barriers to care for families with limited financial resources. Access to specialized IBD care is heavily influenced by geographic location. Studies show that patients from rural areas have less outpatient gastroenterology visits but more IBD-related hospitalizations and emergency department visits compared with patients from urban areas.3 While telehealth has emerged as a potential solution, it has uncovered new challenges related to the built environment such as reliable broadband access, stable housing, and appropriate devices. A recent study found that paradoxically, children with IBD living in areas of high opportunity were more likely to utilize telehealth than children from lower opportunity neighborhoods.4 These findings underscore how the physical environment, technological infrastructure, and other social determinants impact pediatric IBD care access and outcomes. Early initiation of biologic therapy is now considered standard of care in IBD management. However, several factors can delay this critical treatment, with the most significant being Black race, greater distance from treatment sites, and insurance approval challenges.5 These barriers disproportionately affect patients with public insurance, creating significant disparities in timely access to optimal care. Language barriers also pose challenges in healthcare delivery. While studies on language barriers in pediatric IBD are limited, broader pediatric gastroenterology data shows that Spanish language preference is linked to higher odds of missed clinic visits, and this has worsened with telehealth.6 These patterns highlight how language barriers can worsen access challenges, especially as healthcare models evolve to include more technological infrastructure. Children with IBD miss more school than their peers, with over one third being “persistently absent” as defined as missing 10\% or more of school days.7 Children with Medicaid insurance and Black and Hispanic children already have more emergency department visits and hospitalizations for IBD compared with children with private insurance and White children respectively. These disparities underscore the compounded impact that SDOH can have on academic performance in children with IBD. Additionally, research on adult populations show healthcare literacy and information-seeking behaviors including involvement in IBD patient-advocacy organizations varies by racial and ethnic groups.8 Cultural context and lived experiences shape how individuals understand and manage IBD. A 2006 study found that White patients with IBD reported more frequent interactions with IBD organizations and greater access to disease management resources compared to Black and Hispanic patients.8 Black and Hispanic patients were also more likely to attribute their IBD to factors such as stress, smoking, or infections. Differences in beliefs may reflect multiple underlying factors including healthcare provider communication, cultural context, and access to health education. Such factors may also impact how patients approach their disease management and patient activation—the skills, knowledge, and confidence needed to manage one's health condition. SDOH also create significant barriers to clinical trial participation, limiting research diversity and generalizability. Currently, 90.5\% of IBD trial participants are White, with only 22\% of studies reporting race at baseline, despite significant heterogeneity in IBD outcomes between racial groups.9 SDOH barriers include transportation costs, scheduling conflicts, language barriers, and historical medical mistrust compounded by lack of diverse research staff.10 These barriers highlight the need for comprehensive IBD care that addresses medical, psychosocial, and research participation barriers to ensure equitable outcomes for all children. Addressing disparities in pediatric IBD care requires a multi-level approach encompassing direct patient support, practice and organizational reform, community outreach, increased research participation and industry and policy-level changes (Figure 2). At the patient level, proactive integration of care coordinators and patient navigators is crucial. These professionals assist with transportation, scheduling, and disease management complexities, especially for families facing linguistic or literacy barriers. Although data on navigators is limited, studies suggest they improve access, treatment adherence, and may be cost-effective.11 Additionally, providing patients with access to information in their own language could improve both health literacy and adherence to instructions and follow-up. Healthcare systems can mitigate the impact of SDOH on children with IBD through expanding subspecialty access in underserved areas. This includes establishing loan forgiveness programs specifically for pediatric gastroenterology specialists, similar to National Health Service Corps (NHSC) models. Additional strategies include creating fellowship training tracks with rural rotations, implementing financial incentives such as salary differentials and relocation bonuses, or practice establishment grants for specialists in high-need areas. Practices should offer communication options beyond digital platforms as increasing reliance on patient portals and electronic health records can exclude families without reliable internet access. This includes a “communication preferences” assessment during initial visits, dedicated multilingual phone hotlines for appointment scheduling and clinical questions, and maintaining non-digital channels for appointment reminders and important updates. Healthcare systems can establish partnerships with local libraries or community centers to provide computer/internet access for telehealth visits, especially for families with limited technological resources. Given that children with IBD miss significantly more school than their peers, providers should advocate for educational accommodations.12 This includes establishing 504 Plans, federally mandated individualized educational plans that allow children with chronic illnesses to catch up academically without penalty. These plans can include discrete bathroom access, tutoring for missed classes, and extended time for examinations. Healthcare providers should use standardized physician letter templates to communicate diagnosis, and accommodation needs to school and utilize educational resources such as Crohn's and Colitis Foundation brochures to help school personnel understand IBD and provide the necessary student support. Addressing SDOH requires engagement with broader community networks. In our current era, community refers not only to people and places in our physical environment but also to online communities. Patients and families should be provided a list of vetted internet resources with diverse representation such as the Crohn's and Colitis Foundation's Spanish website (https://www.crohnscolitisfoundation.org/es/home) and the Color of Gastrointestinal Illnesses website (https://colorofgi.org) and Instagram: (@colorofgi). Beyond online influences, providers and hospital systems can partner with school systems and community organizations to engage leaders and members of underserved groups. Additionally, institutions should prioritize hiring a diverse workforce and continue to offer training sessions that emphasize understanding systemic racism, implicit bias, and SDOH to mitigate their impact on pediatric health outcomes. Addressing the research participation barriers requires targeted interventions to ensure clinical trials reflect all children affected by IBD. This includes establishing recruitment diversity benchmarks, providing logistical support (travel reimbursement, flexible scheduling, childcare), developing community partnerships with trusted organizations to improve trial awareness, and hiring diverse research coordinators. Sustainable improvement in pediatric IBD care requires policy changes to address systemic barriers. These include inflexible work schedules, limited transportation, complex prior authorization processes, lack of paid sick leave, geographic distance from specialty care, and residence in food deserts. Rather than working independently, clinicians can leverage existing organizational resources that provide structured pathways for engagement. Professional societies such as the North American Society for Pediatric Gastroenterology, Hepatology and Nutrition and the American Academy of Pediatrics, as well as patient advocacy organizations like the Crohn's \& Colitis Foundation, can facilitate opportunities to engage with legislators. Most Children's Hospitals maintain government affairs departments where pediatricians can access support for policy work. With potential funding challenges in research, advocacy through established channels becomes critical for industry partners to increase grant support for health equity research. In summary, SDOH have a wide-ranging impact on the health of children with IBD. Children from marginalized communities including those living in rural areas or disadvantaged neighborhoods and Black and Hispanic children, often incur the greatest impact of SDOH on their health. However, there are opportunities to improve outcomes, from patient-level interactions to policy change. Engagement in initiatives to mitigate the influence of SDOH will ultimately lead to better pediatric IBD outcomes. This work was supported by the National Institutes of Health T32 grant DK067009. The authors declare no conflicts of interest. This descriptive report did not involve human subjects research and therefore did not require institutional review board approval or patient consent.},
    keywords = {Affect (linguistics), Crohn's disease, Disease, Disease burden, Disease management, Environmental health, Ethnic group, Family medicine, Gerontology, Global health, Health care, Health equity, Health policy, Health services research, Indirect costs, Inflammatory bowel disease, Intensive care medicine, MEDLINE, Medicaid, Medicine, Pediatrics, Poverty, Psychological intervention, Public health, Race (biology), Race and health, Racism, Social class, Social determinants of health, Social inequality, Socioeconomic status, built environment, health care access, health disparities, health equity, hospitalization and emergency department visits, insurance status, low-income households, out-of-pocket costs, pediatric inflammatory bowel disease, quality of life, social determinants of health, socioeconomic status, structural racism, telemedicine, urban-rural differences},
    url = {https://onlinelibrary.wiley.com/doi/10.1002/jpn3.70313}

}

@article{jefreytungol2025students,
    title = {Students’ Social Media Use and Severity of Depression},
    author = {Jefrey Tungol and Fernando Enad},
    howpublished = {Available at https://scimatic.org/show_manuscript/5033 (2025/04/27)},
    journal = {Psychology and Education: A Multidisciplinary Journal},
    doi = {10.70838/pemj.360303},
    publisher = {Innovative Scholars and Researchers Alliance},
    year = {2025},
    pages = {273–285},
    abstract = {Social media has transformed global communication and become deeply embedded in the daily lives of Filipino youth, shaping how they connect, express themselves, and engage with society. This study employed a descriptive-comparative research design to determine and examine the differences in the severity of depression among college students in Tagbilaran City during the academic year 2019–2020. It also examines the patterns of social media usage and the extent to which students engage in social comparison. Guided by the Uses and Gratifications Theory (Katz et al., 1973), Social Comparison Theory (Festinger, 1954), and Cognitive Theory of Depression (Beck, 1967), the study provides a comprehensive analysis of how digital engagement influences student experiences. Survey data were collected from 450 college students across two universities in Tagbilaran City. Results show that Facebook is the most frequently used platform (92.44\%), followed by Instagram (51.56\%) and Twitter (32.00\%). The top reasons for social media engagement include staying connected with family and friends (88.40\%), entertainment (79.33\%), and news consumption (68.22\%). Findings also indicate that 78.44\% of students engage in upward social comparison, while 21.56\% engage in downward comparison. Depression severity was assessed, revealing that 34.67\% of respondents exhibit moderate symptoms, while 3.33\% experience severe depression. Further analysis shows that the amount of time spent on social media is not a significant factor in determining depression severity. However, the manner in which students interact with digital content has notable implications. The results underscore the importance of mental health awareness and digital well-being programs in educational institutions. The study suggests the development of targeted interventions to promote responsible social media use, self-awareness, and coping mechanisms for managing digital exposure. These findings contribute to ongoing discussions on digital engagement and mental health, offering insights that can inform institutional policies and student support programs.},
    keywords = {Clinical psychology, Computer science, Depression (economics), Economics, Facebook, Instagram, Macroeconomics, Psychiatry, Psychology, Social media, Tagbilaran City, World Wide Web, cognitive theories of depression, depression severity, digital well-being, downward social comparison, social comparison, social comparison theory, social media use, student mental health, university students, upward social comparison, uses and gratifications theory},
    url = {https://scimatic.org/show_manuscript/5033}

}

@article{dagogowilliamleggjack2026a,
    title = {A Review on the Use of Social and Learning Media Platforms in Technical and Vocational Education and Training},
    author = {Dagogo William Legg-Jack},
    howpublished = {Available at https://twistjournal.net/twist/article/download/1055/673 (2026/08/29)},
    journal = {TWIST},
    year = {2026},
    abstract = {This systematic review examines the role of social and learning media platforms in enhancing instructional methods, student engagement, and skill development in Technical and Vocational Education and Training (TVET). The review synthesizes evidence from peer-reviewed studies published between 2010 and 2025 across Asia, Africa, Australia, and the Americas. Using a rigorous systematic literature review approach supported by an AI-assisted tool (SciSpace) and ChatGPT under full human supervision, 29 relevant studies were selected and thematically analyzed. The findings reveal that social media platforms, mainly Facebook, YouTube, Instagram, WhatsApp, and emerging AI-driven tools, are widely employed to facilitate collaborative learning, authentic tasks, and learner-centered instructional strategies. Evidence indicates consistent improvements in cognitive, emotional, and behavioral engagement, alongside positive gains in both technical and soft skills, including communication, teamwork, and entrepreneurial competencies. Additionally, the integration of immersive technologies such as augmented reality, virtual reality, and artificial intelligence further bridges the theory-practice gap by enabling safe, interactive, and personalized learning environments. The study concludes that while social media-enhanced pedagogies offer substantial benefits for TVET, their effectiveness depends on strategic instructional design, institutional support, and alignment with industry needs.},
    keywords = {Collaborative learning, Computer science, E learning, Educational technology, Engineering ethics, Instructional design, Knowledge management, Lifelong learning, Pedagogy, Psychology, Public relations, Social learning, Social media, Sociology, Sociotechnical system, Soft skills, Systematic review, Training (meteorology), Transfer of training, Virtual learning environment, Vocational education, Workplace learning, artificial intelligence in education, augmented reality, cooperative learning, entrepreneurial skills, instructional design, social media in education, soft skills development, student engagement, student-centered learning, technical and vocational education and training, theory-practice gap, virtual reality},
    url = {https://twistjournal.net/twist/article/download/1055/673}

}

@article{sarirotussadiyah2026media,
    title = {MEDIA SOSIAL SEBAGAI RUANG BELAJAR ANAK DI ERA DIGITAL: PELUANG PEMBELAJARAN DAN DILEMA PENGAWASAN},
    author = {Sarirotus Sa’diyah and Siti Hamidahtur Rofi'ah},
    howpublished = {Available at https://journal.unpas.ac.id/index.php/pendas/article/download/60924/33935 (2026/07/22)},
    journal = {Pendas Jurnal Ilmiah Pendidikan Dasar},
    doi = {10.23969/jp.v11i03.60924},
    year = {2026},
    abstract = {The development of digital technology has driven social media to transform from merely a means of communication and entertainment into a new learning space for elementary school children. Social media such as WhatsApp, TikTok, and Instagram are now beginning to be utilized in the learning process, both as a medium for delivering material, assignments, and a means of interaction between teachers, students, and parents. This study aims to analyze the role of social media as a learning space for elementary school children in the digital era, examine the pedagogical opportunities it offers in learning, and identify the dilemmas and challenges of supervision faced by teachers and parents. This study used a qualitative approach with a descriptive-analytical design and was conducted at SDN Menampu 03. The research subjects included teachers, students, and parents who were selected purposively. Data were collected through observation, in-depth interviews, and documentation, then analyzed through the stages of data reduction, data presentation, and drawing conclusions using triangulation techniques. The results show that social media is utilized as a learning space through various digital learning products, such as educational videos on TikTok and Instagram, discussion groups and material delivery via WhatsApp, online quizzes, and other interactive digital content. This utilization provides significant pedagogical opportunities to improve students' digital literacy, communication skills, creativity, critical thinking, and independent learning, while expanding access to learning outside the classroom and strengthening student engagement in the learning process. However, the use of social media as a learning space also presents supervisory dilemmas, particularly related to learning distractions and limited teacher and parental control. This study confirms that collaborative supervision between teachers and parents is a key factor in optimizing the function of social media as a safe, meaningful, and sustainable learning space for children.},
    keywords = {Blended learning, Computer science, Cooperative learning, Data collection, Digital learning, Digital media, E learning, Educational technology, Entertainment, Informal learning, Information and Communications Technology, Instagram, Mathematics education, Multimedia, Pedagogy, Physical space, Psychology, Qualitative property, Qualitative research, Social learning, Social media, Social space, Sociology, Space (punctuation), The Internet, TikTok, Triangulation, WhatsApp, digital literacy, elementary school students, learning distraction, online learning, online quizzes, parental supervision, student engagement, teacher supervision, teacher-parent collaboration},
