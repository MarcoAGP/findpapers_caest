@article{gizellataskiaramadana2026social,
    title = {SOCIAL MEDIA ENGAGEMENT AND ADOLESSCENTS’ READING COMPREHENSION IN SENIOR HIGH SCHOOL},
    author = {Gizella Taskia Ramadana and Yuri Lolita},
    howpublished = {Available at https://ojs.fkip.ummetro.ac.id/index.php/english/article/view/15641 (2026/06/06)},
    journal = {Premise: Journal of English Education and Applied Linguistics},
    doi = {10.24127/pj.v15i2.15641},
    publisher = {Muhammadiyah Metro University},
    year = {2026},
    pages = {410–431},
    abstract = {The rapid incorporation of social media into students’ daily lives has transformed it into a powerful learning medium. This shift raises important questions about its potential impact on their academic performance, especially reading comprehension. This study aims to investigate the correlation between senior high school students’ engagement with social media platforms –Instagram, TikTok, and YouTube –and their reading comprehension. A quantitative correlational research design was employed involving 36 senior high school students. Data were collected using a social media engagement questionnaire measuring behavioral, cognitive, and emotional engagement. Further, the reading comprehension test is conducted, consisting of 25 multiple-choice questions. The data were analyzed using Pearson Product-Moment correlation. The correlation analysis showed a significant positive relationship between social media engagement and reading comprehension, with TikTok showing the strongest correlation (r = .823), followed by YouTube (r = .675), and Instagram (r = .395). The results suggest that social media platforms, especially those providing short and multimodal content, may facilitate students’ reading comprehension.},
    keywords = {Comprehension, Correlation, Data collection, Developmental psychology, Engagement, Instagram, Mathematics education, Media use, Pedagogy, Positive correlation, Psychology, Quantitative research, Reading (process), Reading Comprehension, Reading comprehension, Reading motivation, Senior High School Students, Social Media, Social engagement, Social impact, Social media, Social psychology, Student engagement, Test (biology), TikTok, YouTube, adolescents, high school students, multimodal content, reading comprehension, short-form video, social media engagement},
    url = {https://ojs.fkip.ummetro.ac.id/index.php/english/article/view/15641}

}

@article{bikashkumura2026effect,
    title = {Effect of Social Media Usage on Academic Performance of College Students: A Comprehensive Review of Existing Literature},
    author = {Bikash Kumura and Aishwarya Barik},
    howpublished = {Available at https://rjwave.org//jaafr/viewpaperforall.php?paper=JAAFR2606331 (2026/06/01)},
    journal = {JOURNAL OF ADVANCE AND FUTURE RESEARCH},
    doi = {10.56975/jaafr.v4i6.511731},
    publisher = {IJ Research Organization},
    year = {2026},
    pages = {c870-c885–c870-c885},
    abstract = {The widespread adoption of social networking platforms by university students has fundamentally altered scholastic interaction, information dissemination, and pedagogical methodologies. Digital applications like Facebook, WhatsApp, YouTube, Instagram, Twitter, and TikTok are progressively integrated into students' lives for both academic endeavors and recreational pursuits. Nonetheless, the precise consequences of social media engagement on student performance remain highly debated, given that existing literature presents conflicting evidence regarding positive and negative educational returns. Accordingly, this meta-synthesis aims to thoroughly investigate the connection between digital network usage and academic metrics among college students, categorize its constructive and disruptive influences on scholarship, and examine the underlying parameters that mediate academic performance. Adopting a systematic qualitative literature review framework, this study analyzes secondary data derived from 51 empirical investigations published between 2011 and 2025. The results suggest that social media functions as an asset for education when leveraged for collaborative study, academic dialogue, peer information exchange, and intellectual advancement. Conversely, compulsive, or uncontrolled network immersion exerts a detrimental toll on academic outcomes by shrinking available study windows, accelerating procrastination, impeding concentration, and causing sleep fragmentation. Furthermore, the synthesis highlights critical mediating elements including time management efficacy, cognitive student engagement, intrinsic academic motivation, self-regulatory behavior, mental well-being, stress, and the precise intent behind platform usage. Ultimately, the study concludes that social media operates as a double-edged sword, whose net effect on scholastic performance relies fundamentally on the students' capacity to regulate and direct their digital habits. Consequently, balanced, intentional, and disciplined application of digital networks is imperative to optimize learning metrics and mitigate adverse academic consequences.},
    keywords = {5 above impact factor, 500 INR journal, Academia.edu, Academic achievement, Asset (computer security), Categorization, CiteSeerX, Cognition, Collaborative learning, Computer science, Computer-mediated communication, Constructive, Critical thinking, Digital media, Digital object identifier (DOI), DocStoc, Educational research, Educational technology, Effect of Social Media Usage on Academic Performance of College Students: A Comprehensive Review of Existing Literature, Electronic publishing, Empirical evidence, Empirical research, Follow ugc approved journal, Free Publication, Google Scholar, Hard Copy of certificate Provided, High Impact Factor, High Impact Factor: 8.75, Higher education, ISSN approved, ISSUU, Indian Journal, Information technology, International Journal, Interpersonal communication, JOURNAL OF ADVANCE AND FUTURE RESEARCH, Journal, Journal publication, Knowledge management, Learning development, Low Cost INR 500, Mathematics education, Mendeley : reference manager, Multidisciplinary, Negotiation, New UGC-CARE Reference List, Pedagogy, Psychology, Public relations, Research Gate, Research journal, ResearcherID Thomson Reuters, Scopus, Scribd, Social media, Social network (sociolinguistics), Social network analysis, Sociology, Student engagement, Systematic review, The Internet, UGC, UGC Approved, UGC Approved list, UGC CARE, UGC CARE Approved Journals, UGC CARE Journal, UGC CARE Journal Author Guidelines, UGC CARE Journal Call for Papers, UGC CARE Journal Impact Factor, UGC CARE Journal List, UGC CARE Journal Publication Guidelines, UGC CARE Journal Ranking, UGC CARE Journal Review Process, UGC CARE Journal Subscription, UGC CARE Journals, UGC CARE list, UGC and ISSN Approved, UGC approved journal, UGC-CARE, UGC-CARE list, UGCCARE, academic achievement, academic motivation, academic performance, approved by issn and ugc, approved in university, arXiv.org, call for research paper, care journal, college students, conferences, digital di