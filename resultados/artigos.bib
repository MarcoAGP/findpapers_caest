@article{lydiarfrass2017technology,
    title = {Technology in the Distance Education Classroom},
    author = {Lydia R. Frass and Ryan Rucker and Daniel Brown},
    howpublished = {Available at https://www.emerald.com/dlea/article/13/4/17/1311057/Technology-in-the-Distance-Education-ClassroomAn (2017/06/22)},
    journal = {Distance Learning},
    doi = {10.1108/dl-06-2017-0003},
    publisher = {Emerald},
    year = {2017},
    pages = {17–26},
    abstract = {Emerging instructional technologies provide the opportunity for distance education to overcome the traditional classroom challenges of limited physical space and geographic location. This can lead to a wider spectrum of educational opportunities with a more diversified cohort of students with unique academic abilities in the health sciences field (Penman \& Thalluri, 2014). Distance learning is made available by Internet technologies that allow the delivery of content so that faculty and students can interact while in separate locations.As more colleges and universities adopt a component of either asynchronous or synchronous distance learning, it is important to realize that technologies have been shown to improve both faculty’s teaching and students’ learning experience (DiVall et al., 2013). Distance education “uses a number of technologies to offer learning and services to students” (Meyer, 2009, p. 12). Synchronous distance learning opportunities can be applied by using a simple chat system, webinars, or video chats to help reinforce both instructor–student and student–student relationships. Additionally, asynchronous distance learning approaches are student centered and can use a wide range of tools, including learning management systems, discussion boards, blogs, and wikis. Meyer (2009) wrote that, by using “various technologies such as satellite or two-way video and audio systems to extend on-campus face-to-face instruction to students” (p. 12), programs can help offer a better educational experience.Despite the implementation of some emerging distance education technologies in higher education pharmacy colleges and schools, students prefer a “greater use of technology in the classroom” (DiVall et al., 2013, p. 1). Existing studies show the unavailability and reliability of required equipment; complexity of technology; and internal perceptions to be the main barriers that prevented faculty from adopting new technology (Reid, 2014). It is important to note that faculty members accept and implement new technology into their classroom at different intervals for a variety of reasons, including the perceived barriers mentioned above (Buchanan, Sainter, \& Saunders, 2013).As shown by DiVall et al. (2013), the adoption and implementation of new technology can provide increased “student engagement and active learning in the classroom” (p. 6). To improve technology adoption in distributed classrooms, it is essential to identify the competency and instructional technology skill gaps of faculty members. While there are several models used to predict technology adoption, the Level of Use model provides a conceptual framework to gauge individual’s knowledge (Hall, Loucks, Rutherford, \& Newlove, 1975). One purpose of this study was to assess faculty members’ use of technology to deliver synchronous distance learning to identify technological skill gaps.In today’s university environment, there has been an increased demand to offer courses in the broadcast delivery format, especially those courses and degree programs within the health sciences fields. According to McLaughlin et al. (2013), “an increasing number of pharmacy colleges and schools use satellite campuses as a space- and cost-effective means to expand and diversify their student body” (p. 1). Additionally, McLaughlin et al. (2013) found that “of the 127 degree programs with accreditation status from the Accreditation Council of Pharmacy Education, 31 have a branch or distance education campus” (p. 1). Broadcast delivery education is “a synchronous technology that allows for a direct and immersive learning experience for students since it enables a simultaneous face-to-face interaction with audio and video” (Weitze \& Ørngreen, 2014, p. 215).While each broadcast delivery classroom can be laid out differently and include many technologies, there are some common technologies that most of these classrooms incorporate. These include: projectors, microphones, specific software to record lectures (Adobe Connect), document cameras, lighting controls, et cetera. Within these broadcast delivery classrooms, the faculty member typically uses some sort of technology (e.g., learning management system, e-mail, computer projector, etc.) to deliver the instruction. Kaur (2015) states that “the main reason in using technology within a learning environment is to enhance the quality of learning and teaching” (p. 394). While distance education can provide a great opportunity, faculty members must be willing to “adjust to the pedagogy that uses instructional technology as an integral component in teaching” (Khatib, 2014, p. 93). By putting forth an extra effort in their broadcast delivery courses by incorporating various tools, faculty members can often help to “foster more direct social interaction and feedback amongst learners and teachers which fosters higher levels of learner engagement” (Giesbers, Rienties, Tempelaar, \& Gijselaers, 2013, p. 285).While various models are used to predict technology adoption (e.g., technology acceptance model, concerns-based adoption model, levels of use [LoU], etc.), the LoU has been used by many studies to “account for the individual variation in use of an innovation” (Hall et al., 1975, p. 52). Ultimately, the LoU “describes behaviors exhibited by individuals from any knowledge of the innovation exists, through preparation to begin use, through development of skills and knowledges necessary for use to become routine, and finally through refinement, integration, and renewal” (Loucks, 1977, p. 5). The original LoU has eight levels, labeled as: nonuse, orientation, preparation, mechanical use, routine, refinement, integration, and renewal. It is important to note that researchers have modified this model and removed various levels (e.g., Rucker \& Downey, 2016).Lonn and Teasley (2009) and Meloni (2010) found that faculty members adopt communications tools the most in their courses. To establish effective and efficient communication in the online classroom, faculty members must use tools like discussion boards, blogs, social-networking sites (i.e., Facebook, Twitter, Instagram), announcements, and e-mail lists (Meloni, 2010). Lonn and Teasle found that 67\% of faculty members believe posting announcements was very valuable, 30\% valuable, and 6\% not valuable. Petrovic and Kennedy (2005) believe that rather than investigate the tools that faculty members use most often; faculty members need to investigate which tools students use most often. The researchers affirm that faculty members need to understand which tools students use and why, and then faculty members need to integrate these tools within the course (Petrovic \& Kennedy, 2005).The purpose of this study was to determine faculty members’ level of use of tools within an LMS (Blackboard Learn), along with classroom technologies, as they deliver synchronous distance learning courses. The three main research questions guiding this study were, when teaching distance education courses: (a) To what level of use do faculty members use Blackboard tools? (b) To what level of use do faculty members use classroom technology? (c) To what frequency do faculty member utilize various training options to learn more about classroom technology?To achieve this exploratory nonexperimental quantitative study’s purpose and understand level of use, faculty members were asked to participate in a survey regarding their level of use of Blackboard Learn tools; classroom technology; and frequency and preference of utilizing various training formats.Participants in this study included 46 both full-time and adjunct faculty members within a pharmacy college at a large research university. The university is in the southeastern part of the United States and, at the time of the study, had 33,709 undergraduate and graduate students enrolled. Per the Indiana Center for Postsecondary Research’s (n.d.) Carnegie Classification of Institutions of Higher Education, the university is considered a 4-year, large, primarily residential institution.The college of pharmacy had a total of 46 full-time and part-time faculty members and is accredited by the Accreditation Council for Pharmacy Education. Faculty members in the college consisted of both clinical faculty (individuals with a professional doctorate degree in pharmacy, PharmD) and research faculty (individuals with a PhD who are subject-matter experts in basic sciences, biochemistry, or bioinformatics). Overall, the college accepts an average of 110 students yearly while maintaining an average enrollment of 410 students. Given that many universities and colleges at the time of this study are often faced with a shortage of classroom space, 85\% of the nonexperiential courses in the PharmD program are delivered in a distance learning environment.A survey instrument was developed based on the LoU model. The instrument was deployed using Qualtrics Survey Software to all faculty within the college of pharmacy, including department chairs and faculty administrators. Overall, participants had roughly 4 weeks to complete the survey. During this 4-week period, an initial e-mail was sent to all participants encouraging them participate. A reminder e-mail was sent to all participants who had not previously completed the survey at the end of the second week.The survey questionnaire included a combination of best choice, Likert-scale, and open-ended questions and was divided into three main sections: demographics; technology adoption levels; and training and support usage. The questions in the first section, demographics, asked participants to select how many years of experience they had teaching face-to-face and distance education courses; faculty status; and the number of years of experience using Blackboard Learn (LMS).The second section, technology adoption levels, asked participants to select at which level of use they use the tools within Blackboard Learn and common tools used within the distance education classroom. Participants had to select their level of use based on the following 8-point scale:The third section, training and support usage, asked participants to select how often (never, occasionally [1–2 times], frequently [3–4 times], most often [5–6 times], always) they use various training options (e.g., asked a coworker, student technology workers, information technology support, Internet, etc.). Additional questions asked participants to rate their level of agreement (strongly disagree, disagree, neither agree or disagree, agree, or strongly disagree) on which tools within the distance education classroom do they need more training or support.Twenty faculty (out of 46) began the online questionnaire; 7 responded only to the demographic items, and 13 completed the questionnaire for a 28.2\% response rate. Of those who completed, 7 were assistant clinical faculty, 2 were associated clinical, 2 were associate researchers, and 1 selected other, but did not identify a faculty status. The faculty members’ experience using the LMS varied. Many faculty (n = 6) indicated they had 4–6 years of experience; 1 participant reported 1–3 years; 2 additional participants reported having 7–9 years of experience; 3 had 10–12 years, and 1 participant had 15+ years of experience. Table 1 presents the years of experience faculty members indicated they had teaching either face-to-face or distance deliver. The majority reported 6–10 years of teaching experience for both face-to-face and distance.Participants were asked to select on an 8-point scale their level of use of 10 Blackboard tools. Table 2 provides a list of the tools and the average level of use for each. Responses ranged from 1.54 (SD = 1.47) to 5.85 (SD = 1.73), on an 8-point scale. These means corresponded to Levels 0–5, where faculty had no interest or were taking no action to learn the tool (Level 0), to making changes of using the tool to increase outcomes (Level 5). The Blackboard tools used most often to increase outcomes, or whose patterns of use were not being changed, were the more traditional: Announcements, Gradebook, and Assessments/Assignments. Web 2.0-type tools (i.e., journals, blogs, wikis) were not as widely adopted by faculty who teach in these synchronous distance education classes, but were taking an initiative to learn more about the tools.Participants were asked to rate their level of use of 15 tools available within their distance education delivery classrooms. The means ranged from 1.92 (SD = 1.30) to 5.85 (SD = 1.33), corresponding to a range of Level 0 to Level 5. Faculty members reported utilizing familiar technology (for example, PowerPoint, computer/laptop, lectern controls, Internet, microphones) at a level where they are using it without making changes; however, faculty members’ responses indicated that they take the initiative to learn more about implementing changes to increase outcomes by using some of the tools. For example, the Apple TV does not seem to have been adopted as a classroom tool, while faculty have plans to use other tools (lighting, whiteboard, PointMaker/Smart monitor, etc.). Table 3 lists the tools available to faculty as well as the participants’ level of use of each tool.Participants were asked to identify on a 5-point scale how they most frequently learned to use the tools and navigation of the distance education classroom. The scale corresponded to 1 = never, 2 = occasionally, 3 = frequently, 4 = most often, and 5 = always. Table 4 lists the options available to participants and the means of their responses. The responses indicated faculty members occasionally asked coworkers how to use the tools, called technical services, and attended college-provided workshops/sessions.Participants were asked to rate if they needed additional training on the 15 tools located in the distance education classroom listed in Table 5. Overall, participants did not seem to indicate a strong need for training on any of the tools. However, there were seven tools where participants’ responses ranged from a mean of 3.15 (lectern controls/Polycom system) to 3.69 (TopHat), falling between neither agree nor disagree and agree, indicating perhaps a moderate need for training. This was based on a 5-point Likert scale of strongly disagree to strongly agree.In addition, participants were asked their preferred format for training. Most indicated they preferred classroom training (n = 8), followed closely by asynchronous (recorded) web-based training (n = 5). Table 6 lists the methods of delivery faculty members prefer for training, sorted by the number of responses for each format.Emerging instructional technologies can help educational programs overcome challenges in offering classes to students in different locations—technology can enhance and expand an academic program’s ability to serve its students. Putting forth extra effort in broadcast delivery courses can also provide a more active, engaging learning opportunity for students (Giesbers et al., 2013). As noted previously by Khatib (2014), for these tools to be beneficial, however, they be must be adopted by faculty members who teach in the classroom. Using Loucks’ LoU as a framework, this study sought to explore faculty members’ level of use of Blackboard tools and classroom technologies, as well as how frequently they took part in various training options, in a professional degree program offered through distance delivery classroom formats at multiple sites. While there were a number of tools available in both Blackboard and the classroom for use, only a few selected tools seemed to have been adopted and implemented.Within Blackboard Learn, the Announcements, Gradebook, and Assessment/Assignment were the tools reported to have “Making few or no changes of using the tool/established pattern of use,” followed closely by faculty members who were “Looking at ways to better organize using the tool” of Discussion Boards. Other Web 2.0 type tools (Rubrics, Learning Module, Journal, Blog, and Wiki) seem to be under consideration for use by the faculty.Faculty members indicated moderate levels of use with Microsoft Powerpoint, computer/laptop, lectern controls, Internet, and ceiling microphones. Faculty indicated they were looking at ways to better organize using the tool for six additional technologies (presentation “clickers”, TopHat, table top microphones, Camtasia, document camera/ELMO, and Adobe Connect).The participants did not utilize any of the eight types of training and support options available to them, although they occasionally asked a colleague how to use a tool. When asked about their need for additional training on any of the tools found within the distance education classroom, a need was not indicated. Regarding format, the majority seemed to prefer classroom training.The results of this study raised additional questions for the researchers and possibilities for future investigation. While this study was aimed primarily at determining current levels of use, what would be valuable to know is how the faculty use the tools pedagogically. The researchers speculated why faculty member do not have a higher level of tool use—which led to the following questions: While classes are offered in a distance education classroom, is delivery style traditional lecture? Do the faculty members view teaching only in the traditional format of lecturing? Do faculty members see the benefits of utilizing additional tools or understand how they can pedagogically utilize the tools in class? How comfortable are they in using technology?Results indicated that faculty members want training either face-to-face, handson, and on-demand video formats, but these same results do not indicate that they use the training resources currently available. Why? Is the college not providing it in the time and format they want—when they need it? Maybe the technology services unit does not provide training or offer training based around faculty members’ schedules or the type of training format they want. Results indicate that these faculty members do not seem to use the support services available or they are barely using services; perhaps they already know how to use these tools, but do they need to learn how to use it increase student engagement?While this study explored actual level of use, future research studies should follow and explore why faculty members do or do not utilize Blackboard tools, classroom tools, and training. Additionally, it would be beneficial to understand what would motivate the faculty members to increase their level of use, as well as what is the impact of their other faculty duties, to modify pedagogical processes to incorporate additional tools. And on the flip side, it would be important to investigate the students’ perceptions of tool use within their classes.One purpose of this study was to assess faculty members’ use of technology to deliver synchronous distance learning to identify technological skill gaps. One recommendation would be for programs to develop strategies to incorporate pedagogy and technology training sessions and workshops in a method and time that faculty would participate. Spotlighting success stories might also be useful for faculty who are considering adopting new tools; sometimes people need to see an example of how something works to give them ideas on how they can use it. Of course, incentives never hurt! Release time and/or financial investments for course revisions that would incorporate tools that increased student engagement should be welcomed by faculty. Ultimately, the purpose of using emerging instructional technologies in the distance education classroom is to increase student engagement across multiple classrooms and, therefore, increase student learning outcomes.},
    keywords = {Active learning (machine learning), Asynchronous communication, Asynchronous learning, Best practice, Blended learning, Component (thermodynamics), Computer science, Computer-mediated communication, Distance education, E learning, Educational technology, Emerging technologies, Experiential learning, Field (mathematics), Higher education, Information and Communications Technology, Information technology, Instructional design, Interactive video, Learning Management, Mathematics education, Multimedia, Reliability (semiconductor), Space (punctuation), Synchronous learning, Teaching method, Technology education, The Internet, Unavailability, Videoconferencing, active learning, blended learning, distance education, educational technology, faculty development, faculty technology adoption, health sciences education, pharmacy education, student engagement, synchronous and asynchronous learning, technology acceptance, technology adoption barriers, technology integration in the classroom, virtual learning environments},
    url = {https://www.emerald.com/dlea/article/13/4/17/1311057/Technology-in-the-Distance-Education-ClassroomAn}

}

@article{sarojchaudhary2026the,
    title = {The Influence of Social Media Usage on Students' Academic Performance and Study Habits},
    author = {Saroj Chaudhary},
    howpublished = {Available at https://zenodo.org/records/20669919 (2026/06/12)},
    journal = {Zenodo (CERN European Organization for Nuclear Research)},
    doi = {10.5281/zenodo.20669918},
    year = {2026},
    abstract = {Social media has become one of the most powerful forces shaping student life in the last decade. Platforms like Instagram, YouTube, WhatsApp, Snapchat, and increasingly TikTok and Threads, are now part of the daily routine of almost every college student. While these platforms offer entertainment, communication, and even learning opportunities, they also raise serious questions about how they affect academic performance and study habits. This paper investigates the relationship between social media usage and student outcomes in higher education, focusing on grade performance, time management, attention span, and study behaviour. A mixed-method approach was used, combining a survey of 286 students from various Indian universities with a controlled observation study involving 50 volunteers. The findings show that moderate use of social media for academic purposes can support learning, but excessive recreational use is strongly linked to lower grades, poor sleep, and reduced concentration. The study also found that students who consciously manage their social media time tend to perform better than those who do not. Regression analysis revealed that daily social media hours had a significant negative effect on CGPA, while purposeful academic use showed a small positive effect. The paper concludes that the impact depends less on social media itself and more on how students use it. Universities and parents should focus on building digital self-discipline rather than imposing complete restrictions.},
    keywords = {Academic Performance, Academic achievement, Academic year, Advertising, Affect (linguistics), Digital Distraction, Digital media, Digital native, Focus (optics), Focus group, Higher Education, Higher education, Media use, Medical education, Positive relationship, Psychology, Public relations, Recreation, Regression analysis, Social Media, Social influence, Social media, Social psychology, Sociology, Student Behaviour., Study Habits, Survey data collection, academic performance, attention span, concentration, cumulative grade point average, higher education, sleep, social media in education, social media use, study habits, time management, university students},
    url = {https://zenodo.org/records/20669919}

}

@article{nitinshelar2026scrolling,
    title = {Scrolling Vs Studying: Hidden Academic Cost of Social Media},
    author = {Nitin Shelar and Mansi Jaiswal},
    howpublished = {Available at https://zenodo.org/records/19595690 (2026/04/15)},
    journal = {Zenodo (CERN European Organization for Nuclear Research)},
    doi = {10.5281/zenodo.19595689},
    year = {2026},
    abstract = {This research paper examines the Scrolling Vs Studying: Hidden academic Cost of Social Media students in the digital age. With the increasing use of platforms such as Instagram, WhatsApp, and YouTube, students are spending a significant amount of time online for both academic andnon-academic purposes. The study adopts a descriptive research design and collects data from 150 students across various academic streams. It focuses on analyzing usage patterns, time spent, and behavioral effects such as concentration and study habits. The findings reveal that socialmedia plays a dual role in student life. While it supports communication, collaboration, and access to educational resources, excessive usage leads to distraction, procrastination, and reducedacademic performance. The study concludes that controlled and purposeful use of social media can enhance learning outcomes, whereas overuse negatively affects student productivity and academic success.},
