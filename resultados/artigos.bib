@inproceedings{achmadhidayatullah2020the,
    title = {The Affect of The Internet and Social Media: Mathematics Learning Environment Context},
    author = {Achmad Hidayatullah and Endang Suprapti},
    howpublished = {Available at https://iopscience.iop.org/article/10.1088/1755-1315/469/1/012080 (2020/01/01)},
    booktitle = {INTERNATIONAL CONFERENCE ON ENVIRONMENT AND TECHNOLOGY},
    doi = {10.1088/1755-1315/469/1/012080},
    publisher = {IOP Publishing},
    year = {2020},
    pages = {012080},
    abstract = {Abstract Mathematics as one of the lessons in school has quite complex problems, it is often labelled as a difficult subject, poor in innovation and bored. Various methods has been used to make mathematics easier to learn. While on the other hand, the development of the communication industry revolution has changed community's thinking style, learning style, and lifestyle. More specifically, the development of social media, which has an impact on mathematics learning. Students who are classified as millennial, learn more about mathematics using audio visuals such as on YouTube or Instagram. The existence of social media has raised a new form of teacher relations with students. This article discussed and described about how social media has an impact on mathematics learning. The existence of internet social media made the task of the teacher lighter. However, learning mathematics in this era of social media has challenges, advantages, and disadvantages. In this literature study, it will also be explored how social media distorts the role of teachers as educators.},
    keywords = {Mathematics Learning, Media Social Era},
    url = {https://iopscience.iop.org/article/10.1088/1755-1315/469/1/012080}

}

@article{mikethelwall2020why,
    title = {Why are some websites researched more than others? A review of research into the global top twenty},
    author = {Mike Thelwall},
    howpublished = {Available at https://revista.profesionaldelainformacion.com/index.php/EPI/article/view/epi.2020.ene.01 (2020/01/01)},
    journal = {El Profesional de la Información},
    doi = {10.3145/epi.2020.ene.01},
    publisher = {Ediciones Profesionales de la Informacion SL},
    year = {2020},
    abstract = {The web is central to the work and social lives of a substantial fraction of the world´s population, but the role of popular websites may not always be subject to academic scrutiny. This is a concern if social scientists are unable to understand an aspect of users´ daily lives because one or more major websites have been ignored. To test whether popular websites may be ignored in academia, this article assesses the volume and citation impact of research mentioning any of twenty major websites. The results are consistent with the user geographic base affecting research interest and citation impact. In addition, site affordances that are useful for research also influence academic interest. Because of the latter factor, however, it is not possible to estimate the extent of academic knowledge about a site from the number of publications that mention it. Nevertheless, the virtual absence of international research about some globally important Chinese and Russian websites is a serious limitation for those seeking to understand reasons for their web success, the markets they serve or the users that spend time on them. The sites investigated were Google, YouTube, Facebook, Baidu, Wikipedia, QQ, Tmall, Taobao, Yahoo, Amazon, Twitter, Sohu, Live, VK, JD, Instagram, Sina, Weibo, Yandex, and 360.},
    keywords = {Academic research, Amazon, Baidu, Bases de datos, Bibliometrí­a, Bibliotecas, Biblioteconomí­a, Cibermedios, Ciencias de la información, Comparative research, Comunicación, Comunicación audiovisual, Comunicación cientí­fica, Comunicación polí­tica, Comunicación social, Cybermetrics, Documentación, Facebook, Google, Indicadores bibliométricos, Indicadores cienciométricos, Información, Información multimedia, Informetrí­a, Major websites, Medios, Periodismo, Periódicos, Popular websites, Publicación cientí­fica, Redes sociales, Review article, Revistas cientí­ficas, Scholarly interest, Success reasons, Twitter, Webs, Wikipedia, Yahoo, YouTube, altmetrics, indicadores altmetricos, revisión de pares, revista Q1 comunicación, revista cientí­fica, revista cientí­fica española, revista de comunicación, revista de investigación, revista indexada, revista indexada scopus, revista scimago},
    url = {https://revista.profesionaldelainformacion.com/index.php/EPI/article/view/epi.2020.ene.01}

}

