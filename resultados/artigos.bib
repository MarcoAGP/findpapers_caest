@inproceedings{soniasahli2025enhancing,
    title = {Enhancing Student Engagement through Social Media-Based Gamification in a UI/UX Design Course},
    author = {Sonia Sahli and Denis Gillet},
    howpublished = {Available at https://ocs.editorial.upv.es/index.php/HEAD/HEAd25/paper/view/20115 (2025/01/01)},
    booktitle = {11th International Conference on Higher Education Advances (HEAd’25)},
    doi = {10.4995/HEAd25.2025.20115},
    publisher = {Editorial Universitat Politècnica de València (edUPV)},
    year = {2025},
    pages = {996-1004},
    abstract = {Nowadays, incorporating innovative teaching methods that enhance student engagement has become increasingly crucial. In our study, we examine a new pedagogical practice which relies on gamified formative peer assessment and social media to improve student engagement and digital skills in higher education. The approach was implemented and validated with 300 IT students in a UI/UX Design course. Students were requested to design high-fidelity wireframes as part of a project, which were posted on Instagram, where followers voted for the best wireframe using Instagram’s poll feature. The wireframe with the most votes was awarded, adding a competition aspect to gamification. These results show a significant impact on student engagement. High level of interest was confirmed on Instagram. Students expressed excitement about using social media as part of the course and valued the move away from a teacher-centred pedagogical approach.},
    keywords = {Aerospace engineering, Computer science, Course (navigation), Engineering, Human–computer interaction, Instagram, Mathematics education, Multimedia, Psychology, Social media, Student engagement, User experience design, World Wide Web, digital skills, formative assessment, gamification, higher education, peer assessment, social media in education, student engagement, student-centered learning, wireframe design},
    url = {https://ocs.editorial.upv.es/index.php/HEAD/HEAd25/paper/view/20115}

}

