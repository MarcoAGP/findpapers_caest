@article{fatéméhdubois2026educational,
    title = {Educational Impact of an Instagram Account on Histology Teaching: Mixed Methods Approach in Medical Education},
    author = {Fatéméh Dubois and Damien Ambrosetti and Lucie Tosca},
    howpublished = {Available at https://formative.jmir.org/2026/1/e89044 (2026/08/06)},
    journal = {JMIR Formative Research},
    doi = {10.2196/89044},
    publisher = {JMIR Publications Inc.},
    year = {2026},
    pages = {e89044–e89044},
    abstract = {Abstract Background Morphology-based disciplines such as histology, embryology, and cytogenetics require strong visual learning and rely heavily on visual pattern recognition, with more complex integrative processes, that is, higher-order cognitive skills that connect, interpret, and apply knowledge across contexts. These skills may be supported by social media formats. In parallel, medical students increasingly engage with digital and social media platforms, prompting interest in their potential educational value. Instagram (Meta Platforms, Inc), as an image-centered and interactive medium, has emerged as a potential pedagogical tool. The Histo.Embryo Instagram account was launched in 2023 under the auspices of the French National College of Histologists, Embryologists, and Cytogeneticists (CHEC) to complement traditional teaching with bilingual, interactive, image-based posts. Objective This study aimed to evaluate the pedagogical contribution of the Histo.Embryo Instagram account with a focus on students’ engagement, usage patterns, perceived learning outcomes, and qualitative user experience. This learning platform was developed as a visual and interactive tool to complement traditional teaching in histology, embryology, and cytogenetics. Methods A mixed methods design combined a structured online survey (N\&gt;100), Instagram analytics (90-day period), and qualitative feedback. Quantitative data assessed usage frequency, preferred content formats, perceived utility, and self-reported learning outcomes. Qualitative data were analyzed thematically to explore how students interacted with and integrated the content into their learning practices. Results Instagram was the dominant platform among students, with 81\% (101/125) reporting daily use. The account reached 2582 unique users and 168,778 views. Static quiz-based posts generated 96\% (203/207) of engagement, highlighting a strong preference for active recall formats. Survey data showed that 98\% (122/125) perceived improved understanding, 64\% (80/125) enhanced visual recognition, and over two-thirds reused content in academic settings. Qualitative findings provided additional insight into these patterns. Students described the content as accessible, visually clear, and aligned with exam expectations, emphasizing its role in simplifying complex concepts and supporting memorization. Many reported using posts for rapid revision, self-assessment, and consolidation of prior knowledge, suggesting integration into self-regulated learning strategies. The interactive quiz format was perceived as motivating and cognitively engaging. Conclusions The Histo.Embryo Instagram account suggests that Instagram, when intentionally structured, may complement traditional teaching by supporting visual learning, active recall, and flexible study practices. Nevertheless, these findings should be interpreted cautiously due to potential self-selection bias, reliance on subjective measures, and the absence of controlled comparisons. Further research is needed to evaluate its impact on objective learning outcomes and long-term knowledge retention.},
    keywords = {Class (philosophy), Computer science, Focus (optics), Gerontology, Instagram, Internet privacy, Intervention (counseling), MEDLINE, Medical education, Medicine, Psychology, Social media, The Internet, educational impact, histology education, medical students, social media in medical education, visual learning},
    url = {https://formative.jmir.org/2026/1/e89044}

}

@article{davinaazzahravirzarozak2026instagram,
    title = {Instagram Broadcast Channels for Enhancing EFL Learners' Vocabulary Mastery},
    author = {Davina Azzahra Virza Rozak and Rika Riwayatiningsih and Yunik Susanti},
    howpublished = {Available at https://ejournal.intelektualedu.com/index.php/JPPI/article/download/118/53 (2026/07/26)},
    journal = {Jurnal Penelitian Pendidikan Indonesia},
    year = {2026},
    abstract = {Vocabulary mastery is a fundamental component of English language learning, yet many students still experience difficulties in understanding and using vocabulary appropriately. Social media offers an alternative approach to supporting vocabulary learning and increasing students' engagement. This study aimed to examine the effect of Instagram Broadcast Channels on the vocabulary mastery of eighth-grade students at SMPN 4 Kediri. The study employed a quantitative approach using a pre-experimental One Group Pretest-Posttest design involving 29 students from Class VIII-K. Data were collected through a multiple-choice vocabulary test measuring word meaning, synonym, antonym, and vocabulary in context. The data were analyzed using descriptive statistics, the Shapiro-Wilk normality test, and a paired-samples t-test with IBM SPSS Statistics. The results showed that the mean score increased from 44.60 on the pre-test to 92.87 on the post-test. The paired-samples t-test yielded a significance value of 0.000 (p < 0.05), indicating a statistically significant difference between the pre-test and post-test scores. These findings suggest that Instagram Broadcast Channels have the potential to support students' vocabulary mastery by providing continuous vocabulary exposure and flexible access to learning materials.},
    keywords = {Artificial intelligence, Class (philosophy), Component (thermodynamics), Computer science, Descriptive statistics, EFL learners, English vocabulary, IBM, Incidental learning, Language acquisition, Linguistics, Mathematics education, Multimedia, Natural language processing, Normality, Psychology, Quasi-experiment, Significant difference, Statistical analysis, Test (biology), Vocabulary, Vocabulary development, Vocabulary learning, Word (group theory), eighth grade students, social media in language learning, student engagement, synonyms and antonyms, vocabulary exposure, vocabulary in context, vocabulary mastery, word meaning},
    url = {https://ejournal.intelektualedu.com/index.php/JPPI/article/download/118/53}

}

@article{nurtetengnurteteng2026integrating,
    title = {Integrating Local Culture and Digital Tools in Culturally Responsive English Teaching},
    author = {Nurteteng Nurteteng and Nursalim Nursalim and Melanie Bobert},
    howpublished = {Available at https://e-journal.undikma.ac.id/index.php/jollt/article/view/18719 (2026/07/17)},
    journal = {JOLLT Journal of Languages and Language Teaching},
    doi = {10.33394/jollt.v14i3.18719},
