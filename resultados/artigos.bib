@article{dranuradhakumari2026social,
    title = {SOCIAL MEDIA AND EDUCATION: A REVIEW},
    author = {Dr. Anuradha Kumari},
    howpublished = {Available at https://zenodo.org/records/21241127 (2026/06/30)},
    journal = {Zenodo (CERN European Organization for Nuclear Research)},
    doi = {10.5281/zenodo.21241126},
    year = {2026},
    abstract = {Abstract Social media has emerged as one of the most influential technological innovations in the field of education during the twenty-first century. The increasing accessibility of the internet and smartphones has transformed the ways in which students, teachers, researchers, and educational institutions communicate, collaborate, and exchange information. Social media platforms such as Facebook, WhatsApp, YouTube, Instagram, Twitter (X), Telegram, LinkedIn, and Google Classroom are no longer limited to entertainment and social interaction; rather, they have become important educational tools that support teaching-learning processes. The integration of social media into education has created opportunities for collaborative learning, online discussions, resource sharing, distance education, and student engagement. The present review paper critically examines the relationship between social media and education by reviewing existing research studies and scholarly literature published between 2020 and 2025. The paper discusses the educational uses of social media, its advantages in enhancing learning outcomes, and the challenges associated with excessive or improper use. The review further explores issues such as academic distraction, social media addiction, cyberbullying, misinformation, and privacy concerns. The findings reveal that social media can significantly improve communication, collaboration, creativity, and accessibility in education when used appropriately. However, unregulated use may negatively affect students’ academic performance and mental well-being.   The paper concludes that educational institutions, teachers, parents, and policymakers should work collaboratively to promote responsible and ethical use of social media in educational settings. Proper digital literacy, awareness programs, and institutional policies are essential for maximizing the educational benefits of social media while minimizing its negative impacts.   Keywords: Social Media, Education, Digital Learning, Collaborative Learning, Student Engagement, Online Learning, Higher Education},
    keywords = {Affect (linguistics), Digital divide, Digital media, Educational resources, Educational technology, Entertainment, Field (mathematics), Internet privacy, Political science, Public relations, Resource (disambiguation), Social media, Social media optimization, Sociology, The Internet, Web 2.0, Work (physics), academic distraction, cooperative learning, cyberbullying, digital literacy, distance education, educational technology, higher education, misinformation, online learning, privacy concerns, responsible social media use, social media addiction, social media in education, student engagement},
    url = {https://zenodo.org/records/21241127}

}

@article{mutiaravikalaw2026slanging,
    title = {Slang-ing into Digital Age: Exploring the appeal for EFL students},
    author = {Mutiara Vika Law and Efrika Siboro and Antonius Setyawan Sugeng Nur Agung and Monika Widyastuti Surtikanti},
    howpublished = {Available at https://publikasi.dinus.ac.id/unclle/article/download/16366/6099 (2026/06/10)},
    journal = {UNCLLE (Undergraduate Conference on Language, Literature, and Culture)},
    year = {2026},
    abstract = {This study explores the appeal and sources of slang among English as a Foreign Language(EFL) students in the digital age. Data were collected through questionnaires and semi-structuredinterviews. The findings indicate that acronym-based slang, such as LOL (Laughing Out Loud), IDK (IDon’t Know), TBH (To Be Honest), and NGL (Not Gonna Lie), is the most popular, with 54.8\% ofparticipants reporting frequent use. Other types include clipping (29\%), imitative slang (25.8\%), andfresh and creative slang (19.4\%). Students perceive slang as appealing because it is easy to use (48.4\%),helps them appear trendy (29\%), and facilitates communication with peers (22.6\%). In terms of digitalplatforms, Instagram and TikTok were the most frequently cited (64.5\%), followed by WhatsApp(22.6\%). These findings suggest that integrating slang into language learning activities and instructionalmaterials may enhance student engagement and make learning more relatable and interactive in EFLclassrooms.},
