    url = {https://articlegateway.com/journals/index.php/JHETP/article/view/4900}

}

@article{ávilaja2021multimediaresponse,
    title = {\#MultimediaResponse: Instagram as a Reading Activity in a University English Class},
    author = {Ávila J.A.},
    howpublished = {Available at https://ila.onlinelibrary.wiley.com/doi/10.1002/jaal.1128 (2021/03/01)},
    journal = {Journal of Adolescent \&amp; Adult Literacy},
    doi = {10.1002/jaal.1128},
    publisher = {Wiley},
    year = {2021},
    pages = {531-541},
    abstract = {Abstract In this article, the author describes utilizing Instagram as a reading response activity in an undergraduate English course to increase student engagement with challenging texts. Using a shared class account, students created a menu of prompts that they then chose from to create posts after reading fictional, theoretical, and philosophical texts; students’ choices of prompts are analyzed as well as their reflections on the activity as a whole. Lastly, the author shares recommendations for other educators who want to bring in social media, including, but not limited to, Instagram, as a reading response activity into their classrooms.},
