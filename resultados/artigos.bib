@article{alghasabmb2025the,
    title = {The Use of Smartphone Apps for Informal Language Learning Among EFL Students: Focusing on Students' Choices, Purposes, and Perceptions},
    author = {Alghasab M.B.},
    howpublished = {Available at https://awej.org/the-use-of-smartphone-apps-for-informal-language-learning-among-efl-students-focusing-on-students-choices-purposes-and-perceptions/ (2025/12/01)},
    journal = {Arab World English Journal},
    doi = {10.24093/awej/vol16no4.4},
    publisher = {AWEJ Publishing},
    year = {2025},
    pages = {64-89},
    abstract = {The advancement in mobile technologies has paved the way for personalized and self-directed language learning beyond conventional classroom settings. Despite the availability of numerous studies on mobile-assisted language learning (MALL) in the higher education context, there has been a lack of research exploring its potential within the informal learning context in Kuwait. This paper, therefore, aims to (1) investigate how English as a Foreign Language (EFL) students use MALL to develop their language skills in informal learning settings and (2) investigate their perceptions and attitudes towards using MALL. Adopting a mixed methods design, the research involved 54 undergraduate students, majoring in English language, at the College of Basic Education in Kuwait. Questionnaires were distributed to all participants, and semi-structured interviews were conducted with 20 students. The findings revealed that students generally held positive perceptions towards using mobile apps in learning English. YouTube, TikTok, and Instagram emerged as the most frequently used apps for informal English language learning. Additional findings indicated that among the language skills developed through smartphone apps, writing is the least targeted skill. In contrast, other skills, such as listening and enhancement of vocabulary knowledge, receive comparatively greater emphasis. These findings underscore the significant role of smartphone apps in enhancing students’ engagement and motivation in language learning, extending beyond the traditional classroom boundaries.},
    keywords = {Active listening, Context (archaeology), EFL learners, Educational technology, English as a foreign language, English as a second language, English language, Foreign language, Informal education, Informal learning, Instagram, Kuwait, Language acquisition, Language education, Mathematics education, Medical education, Mobile apps, Mobile device, Mobile technology, Pedagogy, Perception, Psychology, Second language, Smartphone application, TikTok, Vocabulary, Vocabulary learning, YouTube, higher education, informal language learning, informal learning, language skills development, listening skills, mobile application, mobile assisted language learning, mobile-assisted language learning, smartphone apps, student motivation, student perceptions, vocabulary acquisition},
    url = {https://awej.org/the-use-of-smartphone-apps-for-informal-language-learning-among-efl-students-focusing-on-students-choices-purposes-and-perceptions/}

}

