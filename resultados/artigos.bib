@article{kimjuansia2026using,
    title = {Using Social Media to Enhance Student Engagement and Learning Effectiveness in Microbiology Education: The “Adopt A Microbe” Program},
    author = {Kim Juan Sia and Yew Kong Lee and Chia‐Wei Phan},
    howpublished = {Available at https://www.tandfonline.com/doi/full/10.1080/0047231X.2026.2738807 (2026/01/01)},
    journal = {The journal of college science teaching},
    doi = {10.1080/0047231X.2026.2738807},
    publisher = {Informa UK Limited},
    year = {2026},
    pages = {1–14},
    abstract = {The Adopt a Microbe project integrates traditional classroom instruction with Instagram to enhance microbiology and immunology education learning. Designed as a blended learning strategy, the project aimed to foster engagement, satisfaction, and creativity among first-year Bachelor of Pharmacy (B. Pharm) students at a Malaysian public university during the 2022/2023 academic session. Students were assigned a microorganism (such as a virus, bacterium, fungus, or protozoan parasite) and required to research its characteristics before communicating their findings through Instagram posts using visuals, avatars, and lay-friendly content. This study evaluated the project’s effectiveness in enhancing student engagement, satisfaction, learning experience, and self-evaluated effectiveness, while identifying implementation challenges. A mixed-methods approach was employed, combining an online questionnaire completed by 65 students with a focus group discussion involving five participants. Students reported high levels of engagement (mean = 4.46), satisfaction (mean = 4.39), learning experience (mean = 4.34), and self-evaluated effectiveness (mean = 4.40). Qualitative findings indicated that students valued the project’s creativity, science communication opportunities, and practical learning experience, while identifying challenges in simplifying scientific concepts, managing social media use, and developing technical design skills. These findings support the use of social media as an effective blended learning approach for microbiology education and pharmacy training.},
    keywords = {Active learning (machine learning), Bachelor, Blended learning, Computer-mediated communication, Cooperative learning, Creativity, Educational technology, Electronic publishing, Engineering education, Focus group, Higher education, Instagram, Mathematics education, Medical education, Medicine, Multimethodology, Online discussion, Pedagogy, Pharmacy, Project-based learning, Psychology, Public engagement, Qualitative property, Qualitative research, Social media, Student engagement, Teaching method, blended learning, first-year students, immunology education, learning effectiveness, microbiology education, pharmacy students, science communication, social media in education, student engagement, student satisfaction},
    url = {https://www.tandfonline.com/doi/full/10.1080/0047231X.2026.2738807}

}

@inbook{allena2026how,
    title = {How Can I Engage Students in Responding to Poetry and Spoken Word?},
    author = {Allen A.},
    howpublished = {Available at https://www.taylorfrancis.com/chapters/edit/10.4324/9781003627647-12/engage-students-responding-poetry-spoken-word-ashleigh-allen (2026/01/01)},
    doi = {10.4324/9781003627647-12},
    publisher = {Routledge},
    year = {2026},
    pages = {260-283},
    abstract = {In this chapter, the authors describe approaches to fostering students engagement in responding to poetry as well as writing, publishing, and performing poetry. They contrast a formalist approach to teaching poetry with examples of how teachers use more creative, critical, collaborative, interactive, and performative methods. They argue that the best teachers of writing are writers themselves. Throughout, the authors emphasize that poetry is meant to be experienced, read aloud, performed, and played withand offer ways for teachers to relate poetry to students own experiences as readers and writers in the world. They share examples of how teachers select poems that appeal to diverse students, from Instagram poetry to rap lyrics; connect poetry to students lives; and encourage them as writers and poets.},
    url = {https://www.taylorfrancis.com/chapters/edit/10.4324/9781003627647-12/engage-students-responding-poetry-spoken-word-ashleigh-allen}

}

