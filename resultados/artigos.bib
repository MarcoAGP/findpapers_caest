@article{dayanasgonçalvesmanso2022strategies,
    title = {Strategies adopted by undergraduate teaching assistants in physiology and biophysics education during the COVID-19 pandemic},
    author = {Dayana S. Gonçalves-Manso and Mateus P. Rodrigues and Ayla Secio-Silva and Eliza L. Alves and Vitória S. Oliveira and Pedro E. P. Carvalho and Ikaro J. S. Beraldo and Giulia T. C. Vaccarezza and Rodrigo S. Viza and Francisco A. C. Carmo and Grace S. Pereira and Paula Bargi-Souza and Glauber S. F. da Silva and Pedro P. G. Guimaraes},
    howpublished = {Available at https://journals.physiology.org/doi/10.1152/advan.00042.2022 (2022/09/01)},
    journal = {ADVANCES IN PHYSIOLOGY EDUCATION},
    doi = {10.1152/advan.00042.2022},
    publisher = {American Physiological Society},
    year = {2022},
    pages = {351-357},
    abstract = {The COVID-19 pandemic affected almost all aspects of our lives, including the education sector and the way of teaching and learning. In March 2020, health authorities in Brazil imposed social isolation and the interruption of on-site activities in schools and universities. In this context, the Federal University of Minas Gerais (UFMG), one of the largest universities in Brazil and Latin America, developed an emergency remote learning (ERL) plan that allowed the return of classes in an online format and supported students to obtain access to equipment and internet network. Within this new perspective, the Undergraduate Teaching Assistant (UTA) program of the Department of Physiology and Biophysics (DFIB) explored strategies to minimize the impact of the absence of face-to-face classes. Using different available tools in online platforms and social media such as Microsoft Teams, YouTube animated video classes, and Instagram, the UTA program assisted \&gt;500 undergraduate students and strongly supported professors during ERL. In just over a year, our video classes on YouTube Channel reached ∼40,000 views. Most of the students reported that their questions were fully and quickly solved by the UTA program. Collectively, our results indicate that the strategies implemented by the UTA program helped the undergraduate students and professors to adapt to a remote learning format.},
    keywords = {COVID-19, UFMG, biophysics, online teaching, physiology},
    url = {https://journals.physiology.org/doi/10.1152/advan.00042.2022}

}

