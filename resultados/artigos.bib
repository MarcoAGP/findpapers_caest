@inproceedings{priyankagahlaut2025impact,
    title = {Impact of AI-Generated Content on Social Media Engagement of Graduate Students in New Delhi},
    author = {Priyanka Gahlaut and Tapasya Tyagi},
    howpublished = {Available at https://ieeexplore.ieee.org/document/11400004/ (2025/01/01)},
    booktitle = {2025 IEEE DELCON - International Conference on Recent Smart Technologies in Engineering for Sustainable Development},
    doi = {10.1109/DELCON68055.2025.11400004},
    publisher = {IEEE},
    year = {2025},
    pages = {1-6},
    abstract = {This study examines how AI-generated images and videos influence social media engagement metrics namely likes, comments, shares, and time spent for graduate students in Delhi University. We conducted a survey in October 2025 of 315 randomly selected graduate students across various colleges of Delhi University. A structured questionnaire with 5-point Likert-scale items measured students' interaction frequency and attitudes toward AI-generated content on Facebook and Instagram. Demographic data (age, gender, discipline) were collected as control variables. Multiple regression analyses tested the hypotheses that exposure to AI-generated images and videos significantly predicts engagement levels. Results indicate that AI-generated content has a strong positive association with engagement: AI images in particular elicited higher like/comment/sharing rates, while AI videos also showed a significant but smaller effect. No significant differences were found between platforms or demographic groups, suggesting broad receptivity. These findings align with recent research showing that users readily engage with AI-created posts.},
    keywords = {AI-generated content, Facebook, Graduate students, Instagram, Likert scale, Regression analysis, social media engagement},
    url = {https://ieeexplore.ieee.org/document/11400004/}

}

