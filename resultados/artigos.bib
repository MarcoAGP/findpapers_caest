@article{hestioctaviana2026an,
    title = {An Analysis of Instagram's Role in Enhancing Students’ Writing Skills at Senior High School},
    author = {Hesti Octaviana and Muhamad Yahrif and Eka Fitriana HS},
    howpublished = {Available at https://jurnal-eureka.com/index.php/ijoleh/article/view/426 (2026/05/30)},
    journal = {IJOLEH : International Journal of Education and Humanities},
    doi = {10.56314/ijoleh.v5i1.426},
    publisher = {CV. Eureka Murakabi Abadi},
    year = {2026},
    pages = {63–82},
    abstract = {This study investigates the role of Instagram as a digital learning platform in enhancing students’ English writing skills at SMAN 8 Bone during the 2024/2025 academic year. The rapid development of social media has created new opportunities for language learning, particularly in promoting authentic and meaningful writing practices among students. Employing a qualitative descriptive research design, this study involved 36 students from class XI-7 as research participants. Data were collected through semi-structured interviews and document analysis to explore students’ experiences, perceptions, and challenges in using Instagram for English writing activities. The findings indicate that the integration of Instagram into writing instruction positively influenced students’ engagement and learning experiences. Most participants reported increased confidence in composing English captions and expressing their ideas in written form. The platform also encouraged students to pay greater attention to language accuracy, as they tended to review and revise their writing before posting it publicly. Furthermore, students perceived Instagram-based writing activities as more interesting, enjoyable, and relevant to their daily lives, which contributed to higher levels of motivation and participation in the learning process. The interactive features of Instagram, such as likes, comments, and sharing options, further supported students’ willingness to write and communicate in English. Despite these positive outcomes, several challenges were identified, including persistent grammatical errors, limited vocabulary, and students’ anxiety about making mistakes in public online spaces. Overall, the study concludes that Instagram can serve as an effective and supportive medium for teaching and learning English writing skills by fostering motivation, self-expression, and authentic language use in digital learning environments.},
    keywords = {Academic writing, Anxiety, Class (philosophy), Collaborative writing, Computer-mediated communication, Data collection, Digital media, Educational technology, Electronic publishing, English Language Learning, English as a second language, English language, English writing skills, Instagram, Journal writing, Language acquisition, Mathematics education, Medical education, Multimethodology, Pedagogy, Professional writing, Psychology, Public speaking, Qualitative property, Qualitative research, Semi-structured interview, Social media, Social skills, Study skills, Willingness to communicate, Writing Skill, authentic language use, digital learning platforms, grammatical errors, high school students, social media in language learning, student motivation, vocabulary limitations, writing anxiety, writing revision},
    url = {https://jurnal-eureka.com/index.php/ijoleh/article/view/426}

}

@article{aizamallo2026extent,
    title = {Extent Of Social Media Engagement and Academic Performance of Senior High School Students in Kayapa East District},
    author = {Aiza Mallo},
    howpublished = {Available at https://ijsair.com/index.php/ijsair/article/view/566 (2026/05/22)},
    journal = {International Journal of Sustainability and Advanced Integrated Research},
    doi = {10.65339/ijsair.v2.i2.466},
    publisher = {International Journal of Sustainability and Advanced Integrated Research},
    year = {2026},
    pages = {2445–2449},
    abstract = {Social media platforms such as Facebook, TikTok, YouTube, Instagram, and Discord have become integral to students’ daily lives. This study explored the extent of social media engagement and its relationship with the academic performance of Senior High School students in Kayapa East District during the School Year 2025–2026. This study employed a quantitative descriptive-correlational research design. The respondents comprised 198 ABM Senior High School students selected through complete enumeration sampling. Data were collected using a structured and validated questionnaire that focused on respondents’ profiles, the effects of social networking sites on learners’ lives, academic performance, and challenges encountered in using social media. Frequency, percentage, weighted mean, standard deviation, and Pearson Product-Moment Correlation Coefficient were used to analyze the data. The findings indicated that Facebook was the most commonly used social networking site, while Android cellphones were the primary devices used by respondents. Social networking sites positively influenced learners’ mental, social, physical, spiritual, and emotional aspects, with the mental aspect receiving the highest rating. Social media engagement also has positive effects on academic performance and learning engagement when used responsibly and for educational purposes. However, students also face challenges such as distraction, excessive use, and poor time management. Correlation analysis revealed a moderately significant positive relationship between social media engagement and academic performance. The study concluded that responsible and balanced use of social media may support students’ engagement and academic success while minimizing its negative effects on their mental health.},
    keywords = {Academic Performance, Academic achievement, Academic year, Cyberpsychology, Discord, Face (sociological concept), Face-to-face, Facebook, Instagram, Learning Engagement, Mathematics education, Medical education, Mobile device, Pearson product-moment correlation coefficient, Pedagogy, Positive correlation, Positive relationship, Psychology, Scale (ratio), Senior High School Students, Social Media Engagement, Social Networking Sites, Social engagement, Social media, Social network (sociolinguistics), Social psychology, Social support, Sociology, South east, Student engagement, TikTok, User engagement, YouTube, academic performance, high school students, mental health, responsible social media use, smartphone use, social media engagement, social networking sites, student distraction, student engagement, time management},
    url = {https://ijsair.com/index.php/ijsair/article/view/566}

}

@article{indawansyahri2026from,
    title = {From Watching to Speaking? Indonesian EFL Students’ Engagement with English Role-play Content on Instagram Reels},
    author = {Indawan Syahri and Asti Gumartifa and Amanah Nurussakinah},
    howpublished = {Available at https://e-journal.hamzanwadi.ac.id/index.php/veles/article/view/32928 (2026/05/04)},
    journal = {Voices of English Language Education Society},
    doi = {10.29408/veles.v10i1.32928},
    publisher = {Universitas Hamzanwadi},
    year = {2026},
    pages = {42–58},
    abstract = {Speaking remains a persistent challenge for Indonesian EFL learners, partly because classroom instruction often provides limited opportunities for meaningful oral practice. At the same time, students’ frequent engagement with short-form social media videos, particularly Instagram Reels, offers potential exposure to authentic, contextualized spoken English. This study investigated students’ engagement with English roleplay content on Instagram Reels and its perceived contribution to EFL speaking learning. Using a qualitative descriptive design, data were collected from 32 eleventh-grade students in a bilingual class at a public senior high school through closed-ended and open-ended questionnaires. The data were analyzed using descriptive statistics and thematic analysis to identify patterns in emotional, cognitive, and behavioral engagement, as well as perceived speaking-related benefits and challenges. The findings revealed that students demonstrated strong emotional engagement, reflected in enjoyment, interest, and reduced learning pressure, and high cognitive engagement, shown through efforts to understand, remember, and notice vocabulary, pronunciation, expressions, and contextual language use. Behavioral engagement was mainly reflected in frequent viewing and imitation, while direct interaction and original content creation remained limited due to low confidence and fear of public judgment. Students perceived English roleplay Reels as helpful for improving pronunciation, vocabulary exposure, fluency awareness, tone, expression, and comfort in speaking English. However, distraction from entertainment content, time management issues, technical constraints, and limited confidence in producing videos constrained its pedagogical value. These findings suggest that Instagram Reels can serve as a supplementary speaking resource when integrated with guided imitation, structured speaking tasks, feedback, and confidence-building activities.},
    keywords = {Anger, Applied psychology, Class (philosophy), Cognition, Comprehension, Content analysis, Data collection, Descriptive statistics, Distraction, EFL speaking, Entertainment, Fluency, Headline, Indonesian, Indonesian EFL learners, Instagram Reels, Language acquisition, Mathematics education, Neuroscience of multilingualism, Note-taking, Notice, Pedagogy, Pleasure, Popularity, Psychology, Qualitative property, Qualitative research, Recall, Resource (disambiguation), Social media, Social psychology, Target culture, Thematic analysis, User-generated content, Vocabulary, Vocabulary development, Vocabulary learning, behavioral engagement, cognitive engagement, digital learning, emotional engagement, imitation, pronunciation, roleplay content, social media in language learning, speaking confidence, student engagement, vocabulary exposure},
    url = {https://e-journal.hamzanwadi.ac.id/index.php/veles/article/view/32928}

}

@article{agustineclaramamentu2026instagram,
    title = {Instagram Digital Storytelling in Teaching English Literature: Students’ Interpretation, Classroom Engagement, and Pedagogical Challenges},
    author = {Agustine Clara Mamentu and Fridolin J. P Kukus and Yapi Henri Wongkar and Firjinia Putri Utami Sukirman and Sabrina Wardatul Jannah Husain and Samuel Frederick Lasut},
    howpublished = {Available at https://journal.globresco.com/index.php/GLENS/article/view/696 (2026/04/30)},
    journal = {GLENS: Global English Insights Journal},
    doi = {10.66314/glens.v3i2.696},
    publisher = {PT. Global Research Collaboration},
    year = {2026},
    pages = {278–293},
    abstract = {Instagram Digital Storytelling is a teaching method in which students use or create, compose, and share narratives using various features; this is not just uploading photos, but a pedagogical process. This study examines students' and lecturers' interpretations of the use of Instagram digital storytelling in English literature learning. The data were collected through semi-structured interviews with three lecturers and fifteen students, as well as documentation in the form of Instagram content, learning notes, and student interpretive assignments. The results showed that students interpreted digital storytelling on Instagram as a multimodal literary text that combines captions, images, colors, videos, sounds, symbols, expressions, and personal experiences. Student interpretations focused not only on plot and messages but also encompassed moral, social, and humanistic values ​​such as empathy, responsibility, respect for differences, and concern for human emotional experiences. Furthermore, Instagram increased student engagement emotionally, cognitively, and behaviorally through discussions, comments, content creation, assignment uploads, and literary reflections. However, the use of Instagram also faces challenges such as shallow content, the dominance of visual aspects, potential distractions, misinterpretations, technical limitations, and the need for lecturer guidance. Therefore, Instagram is most effectively used as a complementary medium before students are directed to more in-depth literary analysis.},
    keywords = {Computer-mediated communication, Creativity, Digital Storytelling, Digital media, Digital storytelling, Documentation, Dominance (genetics), Electronic publishing, English Literature, English literature teaching, Human communication, Humanism, Instagram, Mathematics education, Multimedia, Multimodal Literacy, Narrative, Pedagogy, Plot (graphics), Psychology, Social media, Sociology, Story telling, Storytelling, Student Engagement, Student engagement, Teaching method, Upload, digital storytelling, educational challenges, lecturer guidance, literary analysis, multimodal texts, social media in education, student engagement, student interpretation},
    url = {https://journal.globresco.com/index.php/GLENS/article/view/696}

}

@article{fariedsopiyantomuhammadsoniuniversitasislamnegerisumaterautaramedanindonesia2026analysis,
    title = {Analysis of the Use of the Social Media Platform Instagram (@kursusarab.id) as a Reference Source for Learning Arabic Among Eighth-Grade Students at the Fifth Al-Wasliyah Islamic Middle School in Belawan},
    author = {Faried Sopiyanto, Muhammad Soni; Universitas Islam Negeri Sumatera Utara Medan, Indonesia and S, Fahrurrozi.; Universitas Islam Negeri Sumatera Utara Medan, Indonesia},
    howpublished = {Available at http://jurnal.uinsu.ac.id/index.php/ihya/article/download/28830/12217 (2026/04/29)},
    journal = {Jurnal Ilmu Perpustakaan dan Informasi (Universitas Islam Negeri Sumatera Utara)},
    doi = {10.30821/ihya.v11i1.28830},
    year = {2026},
    abstract = {This study aims to analyze the use of social media, specifically Instagram @kursusarab.id, as a reference source for learning Arabic among eighth-grade students at MTs Al-Wassiliya 05 in Bilwan. The development of digital technology has made it possible to utilize social media as accessible and engaging educational resources for students. Instagram is one of the popular platforms that can serve as an alternative educational tool to help students understand Arabic language material outside the classroom setting. This study adopted a qualitative approach using a descriptive method. The research population consisted of eighth-grade students at MTs Al-Wassiliya 05 in Belawan. Data were collected through questionnaires, interviews, observation, and documentation. The questionnaire was used to determine the frequency of Instagram use as a learning resource, as well as to gather students’ opinions on the learning content presented there. Interviews were also conducted with the Arabic language teacher and some students to obtain more in-depth information. Observation was used to monitor students’ engagement with the learning content, while documentation served as supporting data. The data was analyzed through the stages of data reduction, data presentation, and drawing conclusions. The research findings revealed that most students benefit from the Instagram account @kursusarab.id as an additional learning resource. It also revealed that the content provided is engaging and easy to understand, and contributes to increasing students’ motivation to learn. Thus, Instagram can be utilized as one of the effective alternative educational tools to support the Arabic language learning process.},
    keywords = {Arabic, Arabic language learning, Computer science, Computer-mediated communication, Content analysis, Conversation, Data collection, Data source, Descriptive research, Descriptive statistics, Digital learning, Digital media, Documentation, Educational technology, Instagram, Islam, Language acquisition, Mathematics education, Multimedia, Pedagogy, Population, Psychology, Qualitative property, Qualitative research, Quantitative research, Social media, Social studies, World Wide Web, alternative learning resources, digital learning tools, eighth grade students, madrasah tsanawiyah, social media in education, student motivation},
