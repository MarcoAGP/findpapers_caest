    howpublished = {Available at https://revistas.uned.es/index.php/ried/article/view/39080 (2024/07/01)},
    journal = {RIED-REVISTA IBEROAMERICANA DE EDUCACION A DISTANCIA},
    doi = {10.5944/ried.27.2.39080},
