    title = {Assessing the Students’ Social Media usage on their Emotional Regulation, Social Relationship and Behavioral Patterns},
    author = {Mitchel B. Ruiz and Phoebe A. Aguilar, DPA and Aida C. Selecios, PhD and Ely Jay A. Pasco and Cathy Jean M. Sarcaoga and Wilfredo A. Miasco Jr. PhD and Arlene A. Castillo, PhD},
    howpublished = {Available at https://ijsmsjournal.org/2025/volume-8%20issue-2/ijsms-v8i2p111.pdf (2025/04/30)},
