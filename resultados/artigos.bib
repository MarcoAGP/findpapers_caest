@article{winnyberliana2026exploring,
    title = {Exploring Platform Choices in Enhancing English Speaking Skills: A Case Study in Jambi Province},
    author = {Winny Berliana and Rojab Siti Rodliyah and Bachrudin Musthafa},
    howpublished = {Available at https://www.journal.staihubbulwathan.id/index.php/alishlah/article/view/9168 (2026/04/01)},
    journal = {AL-ISHLAH: Jurnal Pendidikan},
    doi = {10.35445/alishlah.v18i1.9168},
    publisher = {STAI Hubbulwathan Duri},
    year = {2026},
    abstract = {This study investigates the alignment between teachers’ selected digital platforms and students’ platform preferences in supporting English speaking practice in the EFL context of Jambi Province, Indonesia. Despite the increasing integration of digital tools in language learning, limited research has explored how mismatches between teacher choices and student preferences influence speaking engagement.A qualitative case study design was employed involving 30 students and 2 English teachers from two secondary schools selected through purposive sampling. Data were collected through semi-structured interviews and supported by questionnaires for triangulation. The data were analyzed thematically using Oxford’s (1990) language learning strategies framework.The findings reveal that WhatsApp and YouTube were the most frequently used platforms due to their accessibility and ease of use. However, students showed a stronger preference for Instagram, which they perceived as more engaging and less anxiety-inducing for speaking practice. While partial alignment existed in the use of familiar platforms, a notable misalignment emerged in platform preference, potentially limiting students’ engagement and opportunities for meaningful speaking practice.The study concludes that effective integration of digital platforms in EFL speaking instruction requires not only consideration of accessibility and teacher manageability but also alignment with students’ preferences. Incorporating student-preferred platforms in a structured and pedagogically sound manner may enhance engagement and support more meaningful speaking practice, particularly in contexts with infrastructural constraints.},
    keywords = {Case study research, Computer science, Context (archaeology), Data collection, EFL speaking instruction, English as a second language, English language, English speaking skills, Instagram, Jambi, Knowledge management, Language acquisition, Limiting, Mathematics education, Multimethodology, Nonprobability sampling, Pedagogy, Preference, Psychology, Qualitative analysis, Qualitative property, Qualitative research, Second language, Semi-structured interview, Student engagement, Usability, WhatsApp, YouTube, digital platforms, high school students, language learning strategies, speaking anxiety, student engagement},
    url = {https://www.journal.staihubbulwathan.id/index.php/alishlah/article/view/9168}

}

@phdthesis{kairatmakym2026nu,
    title = {NU Event \& Club Management System},
    author = {Kairat Makym and Bekarys Serikov and Aldiyar Aspandiyar and Assanali Rashidov and Alikhan Tangirbergen},
    howpublished = {Available at https://nur.nu.edu.kz/items/98105c23-edc6-478d-bdc9-26cdc30b7695 (2026/04/01)},
    year = {2026},
    abstract = {Mixed-interaction environments lead to disengaged students at NU. Information about clubs and events is spread out across Instagram, Telegram channels, email threads, and physical posters that make discovering events more difficult. First-year and international students are especially susceptible, as they probably do not yet have social networks. It also increases the administrative burden on club officers, who often have to post the same announcement across multiple platforms and track attendance manually. No single platform at NU acts as an authoritative source for what is happening on campus, who is running it, and who plans to attend. The NU Event \& Club Management System addresses this problem with a role-aware platform that unifies event discovery, registration, attendance tracking, and club management in one place. The project was guided by three objectives: to centralize event information across the university, to improve student engagement through personalization and a low-friction discovery experience, and to streamline operations for club officers by replacing manual processes with integrated tooling. Three distinct web interfaces, namely a Student Portal, a Club Dashboard, and an Admin Console, sit on top of a shared REST API, with backend-facing infrastructure for mobile use cases such as offline check-in sync and device-token registration for push delivery already in place.},
    keywords = {Attendance, Automated Attendance Tracking, Centralized Event Discovery, Club, Complex event processing, Computer science, Computer security, Event (particle physics), Event management, Information management, Information system, Internet privacy, Management information systems, Management system, Mass gathering, Personalization, REST API, Role-Aware Campus Platform, Session (web analytics), The Internet, Web application, World Wide Web, attendance tracking, club management, event discovery, event management system, information centralization, push notifications, student engagement, student portal, sync, university student clubs},
    url = {https://nur.nu.edu.kz/items/98105c23-edc6-478d-bdc9-26cdc30b7695}

}

@phdthesis{manishaharirajan2026enhancing,
    title = {Enhancing the Student Learning Experience: Exploring the Role of Virtual Learning Environments and Online Learning Tools within University Settings},
    author = {Manisha Hari Rajan},
    howpublished = {Available at http://hdl.handle.net/1959.4/107035 (2026/02/16)},
    doi = {10.26190/unsworks/32024},
    year = {2026},
    abstract = {Student engagement and motivation are critical in shaping the learning experience and influencing academic success in higher education. The shift to online learning, accelerated by the COVID-19 pandemic, disrupted traditional learning environments, leading to challenges in maintaining student engagement. The emergence of Artificial Intelligence (AI) has further reshaped the educational landscape, adding complexity with how universities support and enhance student learning. Virtual Learning Environments (VLEs), and Online Learning Tools (OLTs) such as pedagogical agents and social media platforms, have potential to create engaging and immersive learning experiences, when used in conjunction with traditional learning environments. However, there is limited research on the pedagogical development and implementation of these environments and tools to enhance the student experience. This thesis investigated the development and evaluation of immersive VLEs, specifically 360o and 3D desktop simulations compared against pre-existing online modules (H5P) within 2nd and 3rd year undergraduate pathology courses. Additionally, a pedagogical agent (PATHBOT) and a social media page (Instagram) were designed and evaluated to supplement student learning. Student engagement, motivation, confidence and performance were assessed using surveys and knowledge/transfer tests. Students reported that their allocated learning environments enhanced their perceived engagement, motivation and confidence, while knowledge/transfer tests revealed improved learning outcomes for the VLEs and the pre-existing H5P modules. However, while students reported a positive response to the immersive and interactive elements of the VLEs, there was no significant enhancement in learning experience compared to the pre-existing H5P modules. Additional pilot studies revealed that using PATHBOT as a learning tool improved student engagement more than its administrative use. While participating students responded positively to the Instagram page, overall interaction and student use was limited. Overall, VLEs, pedagogical agents and social media pages have potential to improve the student learning experience. However, this thesis highlights the importance of educators to understand elements of VLEs that enhance learning and the need to tailor resources to the needs of learners. In addition, educators must assess if immersive VLEs and OLTs justify the time and effort required for their development and use.},
    keywords = {Active learning (machine learning), Blended learning, COVID-19 pandemic, Collaborative learning, Computer science, Computer-mediated communication, Conjunction (astronomy), Cooperative learning, E learning, Educational technology, Experiential learning, H5P, Higher education, Informal learning, Instagram, Learning environment, Learning sciences, Mathematics education, Multimedia, Online learning, Psychology, Set (abstract data type), Social learning, Social media, Student engagement, Synchronous learning, Teaching method, Virtual learning environment, Virtual reality, artificial intelligence in education, educational agents, immersive learning, online learning tools, pathology education, social media in education, student engagement, student motivation, student self-confidence, undergraduate medical education, virtual learning environments},
    url = {http://hdl.handle.net/1959.4/107035}

}

@article{inggitgardina2026instagramsupported,
    title = {Instagram-Supported Writing Instruction: Exploring Vocational Students’ Writing Development and Engagement in an Indonesian EFL Context},
    author = {Inggit Gardina and Bachtiar Bachtiar and Aminuddin Zuhaeri},
    howpublished = {Available at http://jiip.stkipyapisdompu.ac.id/jiip/index.php/JIIP/article/view/10752 (2026/02/13)},
    journal = {JIIP - Jurnal Ilmiah Ilmu Pendidikan},
    doi = {10.54371/jiip.v9i2.10752},
    publisher = {Ainara},
    year = {2026},
    pages = {2342–2349},
    abstract = {This study aims to explore how Instagram-supported writing instruction influences vocational high school students’ writing development and engagement in an Indonesian EFL context, identify the aspects of writing most affected, and examine the challenges encountered during the learning process. Adopting a qualitative descriptive design, the study involved 20 eleventh-grade vocational students from a vocational high school in West Java, Indonesia. Data were collected through classroom observations, document analysis of students’ Instagram posts, and semi-structured interviews with selected students and the teacher. The data were analyzed thematically to capture recurring patterns related to writing development, engagement, and learner perceptions. The findings indicate that Instagram-supported instruction positively enhanced students’ engagement, confidence, and motivation to write. Students demonstrated noticeable improvement in creativity, relevance, and coherence of writing, supported by Instagram’s multimodal affordances and authentic audience interaction. However, grammatical accuracy and vocabulary limitations remained challenges, highlighting the need for pedagogical scaffolding. The study implies that integrating Instagram into EFL writing instruction can support vocationally relevant writing practices when combined with guided feedback and instructional support.},
    keywords = {Affordance, Coherence (philosophical gambling strategy), Comprehension, Computer science, Context (archaeology), Context effect, Data collection, Discourse analysis, EFL writing, Indonesian, Indonesian EFL learners, Mathematics education, Pedagogy, Professional writing, Psychology, Qualitative property, Qualitative research, Semi-structured interview, Teaching method, Technical writing, Vocabulary, Vocational education, authentic audiences, grammatical accuracy, instructional scaffolding, learner perceptions, student engagement, student motivation, vocabulary limitations, vocational high school students, writing development},
    url = {http://jiip.stkipyapisdompu.ac.id/jiip/index.php/JIIP/article/view/10752}

}

@article{soniamuhammadalmwalad2026the,
    title = {The Relationship between Social Media Use and Student Engagement in the Classroom among Undergraduate Students at Rockford University},
    author = {Sonia Muhammad Almwalad},
    howpublished = {Available at https://www.confmeets.com/journals/jppc/archive/2026-volume-2-issue-1-january/the-relationship-between-social-media-use-and-student-engagement-in-the-classroom-among-undergraduate-students-at-rockford-university (2026/02/13)},
    journal = {Journal of Psychiatry and Psychological Sciences},
    doi = {10.67238/jppc.2026.v2.03},
    publisher = {Conve International Pvt Ltd (Confmeets Publishing)},
    year = {2026},
    pages = {60–60},
    abstract = {ABSTRACT This study examines the relationship between undergraduate students\&rsquo; academic and personal use of social media and their classroom engagement at Rockford University. Student engagement is understood as a multidimensional construct that includes behavioral, emotional, and cognitive components, while social media use can function as either an academic tool or a personal distraction. A quantitative correlational study approach was used, with data collected from 46 undergraduate students from Rockford University, using PsyToolkit, utilizing self-report surveys investigating social media use and behavioral, emotional, and cognitive engagement to examine the relationships among the study variables. Descriptive statistics and Pearson correlation analysis were used to examine the data to determine the direction and degree of correlations between the variables. The results showed that academic social media use was negatively but not significantly related to engagement, r (44) = \&ndash;.15, p = .36. Personal use was positively and significantly related to engagement, r (44) =.44, p = .001. Instagram was the most used platform (93.48\%), followed by TikTok (84.78\%) and YouTube (65.22\%). In conclusion, personal social media use was associated with higher engagement, whereas academic use did not increase engagement. It is recommended that educators provide students with clear instructions on how to use academic technology and help them develop self-control when engaging with social media in the classroom. Keywords: Social Media; Engagement; Affective Engagement; Behavioral Engagement; Cognitive Engagement},
    keywords = {Academic year, Cognition, Confmeets, Construct (python library), Data collection, Descriptive research, Descriptive statistics, Higher education, Instagram, Journal of Psychiatry and Psychological Sciences, Mathematics education, Medical education, Pedagogy, Positive correlation, Psychology, Social cognitive theory, Social engagement, Social media, Social psychology, Sociology, Statistical analysis, Student engagement, TikTok, YouTube, academic social media use, behavioral engagement, classroom engagement, cognitive engagement, emotional engagement, self-control, social media use, undergraduate students},
    url = {https://www.confmeets.com/journals/jppc/archive/2026-volume-2-issue-1-january/the-relationship-between-social-media-use-and-student-engagement-in-the-classroom-among-undergraduate-students-at-rockford-university}

}

@article{ahmadpurwanto2026strategi,
