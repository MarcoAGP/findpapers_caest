@article{leungjavier2025the,
    title = {The Prevalence of the Learning Styles Myth: A Social Media Analysis},
    author = {Leung, Javier and Abramenka-Lachheb, Victoria and Muljana, Pauline S. and Sankaranarayanan, Rajagopal and Lachheb, Ahmed},
    howpublished = {Available at https://link.springer.com/article/10.1007/s10758-025-09932-9 (2025/01/01)},
    journal = {Technology, Knowledge and Learning},
    doi = {10.1007/s10758-025-09932-9},
    publisher = {Springer Science and Business Media LLC},
    year = {2025},
    pages = {1–38},
    abstract = {Despite lacking scientific support, the idea of Learning Styles is widespread in social media engagement. This phenomenon raises concerns about its potential harm in educational practices. This study investigates the prevalence of the Learning Styles myth on two major global social media platforms from 2014 to 2021: Facebook and Instagram. Through Natural Language Processing (NLP) of users’ posts, the findings of this study showed: (1) positive sentiments toward the idea of Learning Styles, perpetuating the myth; (2) prevalent specific topics in posts in relation to Learning Styles, including addressing student needs, curriculum changes, teacher recruitment, and emphasizing different learning modalities; (3) active promotion of professional development events endorsing the idea of Learning Styles by non-profit organizations and educational institutions; and (4) strong associations between users’ reactions and posts on Learning Styles related to teacher jobs, alternative pedagogies for diverse learners, and extracurricular activities. The study highlights the need to address the propagation of unsubstantiated educational myths, such as Learning Styles, through strategic information dissemination practices by educators, professional organizations, and academic institutions on social media.},
    keywords = {Creativity and Arts Education, Education, Educational Technology, Evidence-based teaching, Instructional design and technology, Learning and Instruction, Learning styles myth, Natural language processing, Science Education, Social media misinformation},
    url = {https://link.springer.com/article/10.1007/s10758-025-09932-9}

}

