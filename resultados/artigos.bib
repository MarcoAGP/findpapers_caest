@article{npm199010022walaerpurini2025penerapan,
    title = {Penerapan strategi diversifikasi produk dan digital marketing pada UMKM GEMI 0418},
    author = {NPM. 199010022 WALA ERPURINI and Khaerul Rizal Abdurahman},
    howpublished = {Available at https://iocscience.org/ejournal/index.php/abdimas/article/download/5701/4155 (2025/07/19)},
    journal = {TRIDARMA Pengabdian Kepada Masyarakat (PkM)},
    doi = {10.35335/abdimas.v8i1.5701},
    year = {2025},
    abstract = {Community Service Learning (KKN) is a student service program that is part of the higher education curriculum in Indonesia, in accordance with the Republic of Indonesia Law Number 20 of 2003. This program aims to connect academic theory with practice in the community, allowing students to apply the knowledge they have learned to directly help society. One of the main focuses of KKN is on Micro, Small, and Medium Enterprises (MSMEs), which play a crucial role in the economy by providing employment, income distribution, and economic growth. The method used is collaborative between students and MSMEs. The results of this KKN program include an increased use of digital marketing through Instagram social media, higher sales, product innovation, and improved confidence and independence of the MSMEs. The contributions of this KKN program are Local Economic Empowerment, Improved Human Resource (HR) Capacity, Strengthening the Relationship between Higher Education and the Community, and the Application of Academic Theory in Practice. KKN aims to enhance the digital capabilities of MSMEs, address marketing challenges, and support local economic growth through the integration of academic theory with field practice.},
    keywords = {Audit, Bookkeeping, Business, Business administration, Curriculum, Goods and services, Higher education, Independence (probability theory), Inductive method, Instagram marketing, MSME sales, Marketing, Payment, Political science, Product (mathematics), Resource (disambiguation), Service (business), Sociology, digital marketing, local economic empowerment, micro, small and medium enterprises, product diversification, product innovation, service-learning, social media marketing, university-community collaboration},
    url = {https://iocscience.org/ejournal/index.php/abdimas/article/download/5701/4155}

}

@article{mustafadghiffara2025optimalisasi,
    title = {Optimalisasi Digitalisasi Marketing di Padukuhan Pancoh},
    author = {Mustafad Ghiffara and Gede Guruh Prasetya and Rofi Fathurrohman and M. Ricki Bagus Ernanda and Rosita Puspaningrum and Wardah Ma'rifatul Azizah and Margareta Angelina Mian and Nuraisyah Ayumi Almi and M. Riski Ananda Putra and Qoori Hidayat and Rita Kusumawati},
    howpublished = {Available at https://prosiding.umy.ac.id/semnasppm/index.php/psppm/article/download/1371/1330 (2025/05/23)},
    journal = {Prosiding Seminar Nasional Program Pengabdian Masyarakat},
    year = {2025},
    abstract = {The Community Service Program (PKM) is a form of student service to the community as an implementation of the Tridharma of Higher Education. PKM 194 of Universitas Muhammadiyah Yogyakarta (UMY) which was placed in Dusun Pancoh, Kelurahan Girikerto, Kecamatan Turi, Sleman, which had problems in empowering Micro, Small, and Medium Enterprises (MSMEs) through digital marketing to increase their business competitiveness. The purpose of this program is to improve the understanding, skills, and independence of MSME actors in utilizing digital media as a means of product marketing, so that they can expand the market and increase business competitiveness. The methods used include digital marketing socialization and training, assistance in creating social media content, product photography, compiling digital catalogs, to creating Linktree as a liaison for various business platforms. The results of this activity showed high enthusiasm from MSME actors, although most still use traditional marketing methods. One of the MSMEs assisted, namely Viva Nafigo, succeeded in implementing a digital marketing strategy by improving the quality of product photos, optimizing Instagram accounts, and creating catalogs and Linktrees to facilitate customer access. Although this program has a positive impact, there are several obstacles faced, such as the limited number of MSMEs and the short mentoring time. The implementation of marketing digitalization requires a continuous process in order to provide optimal results. Therefore, further efforts and continuous support are needed to ensure the success of MSME digitalization in Dusun Pancoh},
    keywords = {Advertising, Business, Business administration, Business process, Community service, Customer service, Digital marketing, Digital media, Enthusiasm, Independence (probability theory), Instagram, Linktree, MSME empowerment, Marketing, Marketing strategy, New product development, Order (exchange), Process (computing), Process management, Product (mathematics), Product marketing, Production (economics), Quality (philosophy), Service (business), Service oriented, Service quality, Small and medium-sized enterprises, Small business, Social media, Socialization, community service program, digital catalog, digital marketing, enterprise competitiveness, micro, small and medium enterprises, product photography, social media marketing},
    url = {https://prosiding.umy.ac.id/semnasppm/index.php/psppm/article/download/1371/1330}

}

@article{misfilailirohmi2023promosi,
    title = {Promosi Ruang Kreatif Ekologis dan Camp Education (Riverside Camp Kota Metro)},
    author = {Misfi Laili Rohmi and Rista Meilia and Trio Fajri and Husna Nur Pujianto and Carmidah Carmidah},
    howpublished = {Available at https://ukitoraja.id/index.php/jnb/article/view/197 (2023/08/14)},
    journal = {Jurnal Nusantara Berbakti},
    doi = {10.59024/jnb.v2i1.197},
    publisher = {CV. Alim's Publishing},
    year = {2023},
    pages = {10–19},
    abstract = {Tourism that carries the theme of nature is currently showing a stretch of development. Tourist attractions are starting to move to present green open spaces designed in such a way as to attract visitors. One of the eco-based tourist attractions in Metro City is Riverside Camp. Riverside Camp is an ecological-based educational vehicle in Metro City with the concept of ecological tourism as well as education-based tourism that has economic potential. However, since the Covid-19 pandemic container, Riverside Camp has seemed to be in “suspended animation” so it needs a touch to make it come back to life. Thus, the purpose of this service is to reintroduce Riverside Camp to the community through various activities which will later be shared on social media. The method of implementing the service begins with a discussion with the service team consisting of two lecturers and three accompanying students with 40 student service participants. Next is coordination with the manager to plan a schedule of activities. This service was carried out for four days with the result that the participants had the opportunity to learn about digital marketing in the open space of the Riverside Camp; implementation of activities to introduce trigona honey bee cultivation and planting several types of plants with polygonal media; as well as participants and the service team were able to make Riverside Camp promotional media through the Instagram page.},
    keywords = {Advertising, Art, Business, Engineering, Ethnology, Instagram marketing, Metro City, Sociology, Summer camp, Visual arts, camp education, ecotourism, nature-based tourism, plant cultivation, post-COVID-19 recovery, tourism promotion},
    url = {https://ukitoraja.id/index.php/jnb/article/view/197}

}

@article{gagankesharwani2025evaluating,
    title = {Evaluating the Effectiveness of Digital Strategies in Student Recruitment: A Case Study of Amity University Raipur Marketing},
    author = {Gagan Kesharwani},
    howpublished = {Available at https://isjem.com/download/evaluating-the-effectiveness-of-digital-strategies-in-student-recruitment-a-case-study-of-amity-university-raipur-marketing/ (2025/06/05)},
    journal = {International Scientific Journal of Engineering and Management},
    doi = {10.55041/isjem04028},
    publisher = {Edtech Publishers (OPC) Private Limited},
    year = {2025},
    pages = {1–9},
    abstract = {Abstract: This research paper explores the role of digital marketing in shaping prospective students’ decisions to enroll at Amity University Raipur. Employing a quantitative survey methodology with 82 student participants, the study analyzes the impact of digital platforms including Instagram, the university’s official website, webinars, and direct engagement tools on recruitment outcomes. The findings indicate that interactive and personalized digital communication significantly enhances prospective students’ engagement and decision-making. The study concludes with strategic recommendations to amplify marketing effectiveness via enhanced visual storytelling, targeted content, and real-time digital interaction, providing actionable insights for higher education institutions operating in Tier-2 cities.},
    keywords = {Business, Engineering, Engineering management, Instagram, Marketing, digital marketing, higher education marketing, personalized communication, prospective students, student recruitment, tier-2 cities, university websites, visual narrative, webinars},
