@article{raniaabdelqaderabdallah2026exploring,
    title = {Exploring Digital Trust: Social Media Engagement and Security Concerns among Al Ain University Students},
    author = {Rania Abdel-Qader Abdallah},
    howpublished = {Available at https://www.ssrn.com/abstract=6163546 (2026/01/01)},
