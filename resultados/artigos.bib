@inbook{ankitapathak2023critical,
    title = {Critical Review of Computer-Based Technology and Student Engagement},
    author = {Ankita Pathak and Sunil Kumar Mishra},
    howpublished = {Available at https://onlinelibrary.wiley.com/doi/10.1002/9781119867647.ch18 (2023/01/01)},
    doi = {10.1002/9781119867647.ch18},
    publisher = {Wiley},
    year = {2023},
    pages = {341-358},
    abstract = {Technology has crept into every aspect of life and industry, yet an understanding of promoting student engagement. Higher education has a firm eye on the concept as it has displayed a positive academic outcome. The article draws attention to how computer technology can engage students in higher education. It focuses on how computer-based technology engages students in a higher education setting. Various technologies like web conferencing software, Facebook, Instagram, blogs, Wikis are studied after analyzing the available literature. The article presents a critical literature review on how blogs, social networking sites, wikis influence student engagement. Students engage behaviorally, emotionally, and cognitively. The study concluded that web conferencing and social networking sites create a higher student engagement after digital games. Overall, it appears that computer-based technology has an impact on student involvement. Successful implementation of computer-based technology depends on the hardware, software, and micro-processing features each mobile device has. Recommendations are accustomed to how technology would help in gaining higher student engagement.},
