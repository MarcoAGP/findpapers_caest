    doi = {10.1109/ICICCS65191.2025.10984511},
    publisher = {IEEE},
    year = {2025},
    pages = {902-907},
    abstract = {Digital communication plays an important role in pupils in their daily life, including platforms namely Instagram, Snapchat, LinkedIn, Facebook, and Twitter for communication, networking, and learning. It provides several advantages, including access to educational resources, opportunities for collaboration, and exposure to diverse perspectives. However, excessive usage often leads to negative consequences, such as reduced concentration, procrastination, mental distress, privacy concerns, and lowered self-esteem. Many students struggle to balance academic responsibilities with the distractions posed by social media. Highly curated images on these platforms contribute to unrealistic societal standards, fostering continuous self-comparisons and elevating anxiety. Consequently, students may experience feelings of isolation and turn to online communities for support. While social media offers a space for meaningful discussions and shared experiences, overuse can significantly impact mental well-being, learning effectiveness, and overall health. Students frequently engage in endless scrolling, which leads to wasted time and detachment from the real world, ultimately affecting their academic and personal success.},
    keywords = {Facebook, Impact, Mental Health, Social Media, Twitter},
    url = {https://ieeexplore.ieee.org/document/10984511/}

}

