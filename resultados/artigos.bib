@article{victorugochukwuezeonwumelu2021social,
    title = {Social Media Addiction and Time Management Skills of University Students in Akwa Ibom State, Nigeria},
    author = {Victor Ugochukwu Ezeonwumelu and Mary Nneka Nwikpo and Cornelius C. Okoro and Ekanem Eyaema Idara},
    howpublished = {Available at https://onlinesciencepublishing.com/index.php/gjss/article/view/547 (2021/01/01)},
    journal = {Global Journal of Social Sciences Studies},
    doi = {10.20448/807.7.1.24.34},
    publisher = {Online Science Publishing},
    year = {2021},
    pages = {24–34},
    abstract = {The study was conducted to ascertain the influence of social media addiction on time management skills of university students in Uyo Senatorial District. The population of the study comprised all the second year 2018/2019 students in the University of Uyo. This consisted of a total of 5854 students. The simple random sampling technique was used to select 650 students from the 13 Faculties in the University of Uyo. Two instruments - Social Media Addiction Scale and Time Management Inventory - were adopted for the study and piloted on 80 year two students in the institution. The pilot test yielded a Chronbach alpha reliability coefficient of .78 which was deemed appropriate for the study. The data generated were analyzed using Mean and Standard deviation, while the hypotheses formulated were tested using the t-test statistics. The findings revealed that Facebook and Twitter addiction had significant influence on students’ time management skills. Instagram addiction, however, was not found to have significant influence on students’ time management skills. The recommendations made were that social networking sites should develop features that would help integrate learning contents into social media platforms and that virtual learning should be explored to enhance student engagement, among others.},
    keywords = {Addiction, Biology, Cartography, Computer science, Developmental psychology, Environmental health, Facebook addiction, Geography, Instagram addiction, Mathematics education, Medical education, Medicine, Neuroscience, Operating system, Paleontology, Population, Psychology, Scale (ratio), Simple random sample, Social media, Social networking sites., Social skills, Test (biology), Time management, Twitter addiction, University of Uyo, World Wide Web, social media addiction, social networking sites, student engagement, time management skills, university students, virtual learning},
    url = {https://onlinesciencepublishing.com/index.php/gjss/article/view/547}

}

