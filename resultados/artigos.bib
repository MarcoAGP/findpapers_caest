@article{teacheratpracticalenglishdepartmentforeignlanguagesfacultykarshistateuniversitykarshikashkadaryaregionuzbekistan2025media,
    title = {Media Coverage Of Journalism Education Challenges And Its Impact On Faculty Image},
    author = {Teacher at Practical English Department, Foreign Languages Faculty, Karshi State University, Karshi, Kashkadarya Region, Uzbekistan and Shahnoza Uzakova Beknazarovna},
    howpublished = {Available at https://theusajournals.com/index.php/ajps/article/view/8011/7433 (2025/11/30)},
    journal = {American Journal Of Philological Sciences},
    doi = {10.37547/ajps/volume05issue11-83},
    publisher = {The USA Journals},
    year = {2025},
    pages = {362–368},
    abstract = {This study investigates how journalism education in Uzbekistan is represented in both traditional and digital media, and examines the impact of such coverage on the image of journalism faculties. The research highlights the growing challenges faced by Uzbek journalism programs, including outdated curricula, insufficient practical training, limited access to modern newsroom technologies, and inadequate faculty development opportunities. Employing a multi-method approach, the study analyzes content from national newspapers (Kun.uz, Uzbekistan Today), television news, and social media platforms (Telegram, Facebook, Instagram) between 2018 and 2025. Through qualitative content analysis and frequency counts, recurring themes, the tone of reporting, and the relative emphasis of different issues are identified. The findings reveal that media coverage is predominantly critical, focusing on institutional shortcomings, though positive narratives about student achievements and international collaborations also exist. The study concludes that media representation significantly shapes public perception of journalism faculties, affecting institutional credibility, student engagement, and policy decisions. Strategic and proactive engagement with both traditional and digital media is recommended to enhance faculty image, showcase achievements, and support ongoing educational reforms in line with international standards.},
    keywords = {Alternative media, Citizen journalism, Citizen media, Compliance (psychology), Content analysis, Digital media, Government (linguistics), Higher education, Journalism, Mass media, Media literacy, Media relations, Media studies, Narrative, News media, Newspaper, Perception, Political science, Print media, Public opinion, Public relations, Qualitative research, Representation (politics), Social media, Sociology, Technical Journalism, Tone (literature), Uzbek, Uzbekistan, curriculum reform, faculty development, institutional credibility, journalism education, journalism faculty, media coverage, newsroom technology, practical training, public perception, social media, television news},
    url = {https://theusajournals.com/index.php/ajps/article/view/8011/7433}

}

@article{ekonursalim2025social,
    title = {Social Media Challenge-Based PAI Learning Model: An Interactive Approach for Generation Z},
    author = {Eko Nursalim},
    howpublished = {Available at https://ejournal-nawalaedu.com/index.php/AI/article/view/2108 (2025/11/29)},
    journal = {Al Ilmu.},
    doi = {10.62872/xwp2km09},
    publisher = {PT. Anagata Sembagi Education},
    year = {2025},
    pages = {23–35},
    abstract = {The rapid growth of social media has transformed the learning ecosystem of Generation Z, who rely on visual, fast, and interactive content and increasingly encounter Islamic Religious Education (PAI) through digital platforms. This study responds to the limited research on how challenge-based learning can be systematically integrated into social media environments most used by Gen Z, such as TikTok, Instagram, and YouTube Shorts. The research aims to analyse the characteristics, opportunities, and risks of social media challenge-based PAI learning for Generation Z and to identify the pedagogical, technological, and value-oriented elements required for its effective implementation. A Systematic Literature Review (SLR) was conducted using the PRISMA protocol. Searches in major academic databases for the period 2014–2024 produced 86 records; after screening, eligibility assessment, and critical appraisal, 14 articles were included and synthesised thematically. The findings show that social media challenge-based learning can significantly increase student engagement, religious digital literacy, collaboration, and internalisation of Islamic values when activities are designed to be experiential, reflective, and aligned with Gen Z’s digital habits. However, the results also highlight serious challenges related to misinformation, algorithmic bias, superficial learning, and gaps in digital literacy between teachers and students. The study concludes that the success of this model depends on teacher capacity in content curation, digital ethics guidance, and challenge design, supported by clear institutional policies on safe and moderate social media use. The article offers an integrated conceptual understanding that can guide future empirical applications of challenge-based PAI learning for Generation Z.},
    keywords = {Algorithms, Computer science, Conceptual framework, Conceptual model, Content analysis, Digital Religion, Digital content, Digital learning, Digital literacy, Digital media, Digital native, Educational technology, Empirical evidence, Empirical research, Engineering ethics, Generation Z, Government (linguistics), Informal learning, Instagram, Interactive media, Islam, Islamic education, Knowledge management, Literacy, Mathematics education, Media literacy, Morals, Multimedia, Pedagogy, Period (music), Psychology, Public relations, Social Media, Social influence, Social learning, Social learning theory, Social media, Sociology, TikTok, User-generated content, World Wide Web, YouTube Shorts, algorithmic bias, challenge-based learning, digital competence of teachers, digital ethics, misinformation, social media in education, student engagement, superficial learning},
    url = {https://ejournal-nawalaedu.com/index.php/AI/article/view/2108}

}

@article{guytrainin2025art,
    title = {Art TEAMS Year 4 Annual (Ad Hoc) Report 2024-2025},
    author = {Guy Trainin and Kimberley D’Adamo and HyeonJin Yoon and Azadeh Hassani and Zohreh Tamimdari and Jiabin Lyu and Michael Nti Ababio and Sarah Trainin},
    howpublished = {Available at https://digitalcommons.unl.edu/cgi/viewcontent.cgi?article=1063&context=cehsgpirw (2025/11/26)},
    journal = {Lincoln (University of Nebraska)},
    year = {2025},
    abstract = {This report documents the fourth year of the Art TEAMS project, a multi-year professional learning initiative focused on arts-integrated, transdisciplinary teaching practices across Nebraska K-12 schools. During the 2024-2025 academic year, the project advanced work with its second cohort of educators while maintaining engagement with the first cohort to assess the sustainability of implementation. The second cohort brought increased diversity in art forms, including ceramics, digital media, and career and technical education, demonstrating the versatility of arts integration across curricula. Year Four activities included delivering refined professional development courses grounded in emergent curriculum design, with significant curriculum modifications based on Cohort One feedback. The redesigned Course C/D introduced "The Prairie as Home," a unified inquiry-based unit that modeled arts-centered pedagogy while positioning teachers to oscillate between student and reflective practitioner roles. Classroom observations revealed consistent implementation of Art TEAMS elements, with both art and generalist teachers demonstrating high levels of student engagement, peer learning, and student choice. CREDE observations across 34 classrooms showed strongest implementation in Instructional Conversation (47\% at Integrating level) and Challenging Activities (35\% at both Enacting and Integrating levels). Research contributions included studies on emergent professional learning curriculum, teacher arts-based journaling impacts on practice, and transformative applications in special education contexts. The project's dissemination efforts expanded significantly, including 12 conference presentations, a bi-weekly podcast with over 1,500 views, and growing social media presence (52\% increase in Instagram followers). Partnerships extended to seven school districts statewide, moving beyond the Lincoln-Omaha corridor to include North Platte. Challenges included recruiting administrators and teachers of color, sustaining Cohort One practices, and navigating staffing transitions. Despite these challenges, instructional log data and classroom observations demonstrated continued teacher engagement with Art TEAMS practices, though time commitments decreased in spring months, likely due to competing instructional demands. The report provides evidence that sustained, responsive professional learning can support meaningful arts integration that enhances teacher efficacy and transforms learning experiences for diverse student populations.},
    keywords = {Active learning (machine learning), Appreciative inquiry, Best practice, Cohort, Community engagement, Conversation, Curriculum, Curriculum development, Deliverable, Diversity (politics), Faculty development, Focus group, Grounded theory, Higher education, Journaling file system, K-12 education, Language arts, Mathematics education, Medical education, Pedagogy, Professional development, Professional learning community, Psychology, Public relations, Reflective practice, Service-learning, Social media, Social work, Sociology, Student engagement, Sustainability, Teacher education, The arts, Transformative learning, Unit (ring theory), Visual arts education, Work (physics), arts integration, ceramics (art and archaeology), digital media, implementation sustainability, instructional conversations, peer learning, professional learning, reflective practice, special education, student choice, student engagement, teacher professional development, teacher self-efficacy, transdisciplinary teaching, vocational education},
    url = {https://digitalcommons.unl.edu/cgi/viewcontent.cgi?article=1063&context=cehsgpirw}

}

@article{chairulhuda2025transformasi,
    title = {Transformasi Pembelajaran PAI Melalui Media Sosial: Strategi Meningkatkan Keterlibatan Mahasiswa},
    author = {Chairul Huda and Muhammad Zaki},
    howpublished = {Available at https://journal.stikescolumbiasiamdn.ac.id/index.php/Sevaka/article/view/572 (2025/11/08)},
    journal = {Sevaka : Hasil Kegiatan Layanan Masyarakat},
    doi = {10.62027/sevaka.v3i3.572},
    publisher = {Sekolah Tinggi Ilmu Kesehatan Columbia Asia Medan},
    year = {2025},
    pages = {253–263},
    abstract = {Digital transformation in the modern era has significantly influenced various aspects of life, including education. Today's university students, as digital natives, have a strong tendency to access information and learn through social media platforms such as Instagram and YouTube. This opens up great opportunities to develop more adaptive, contextual, and relevant learning strategies, particularly in Islamic Religious Education (PAI), which is often perceived as traditional and monotonous. This community service project aims to transform PAI learning methods through the integration of social media to enhance student engagement and learning motivation. The implementation method includes five stages: socialization, training and workshops, content production mentoring, instructional implementation, and evaluation and reflection. The results show that the use of YouTube and Instagram as learning media effectively increases student engagement scores (average 3.75) and learning motivation (average 3.80), with YouTube contributing the most by providing long-form, flexible educational content. Instagram complements this by delivering moral messages in a quick and visually appealing format. Beyond improving learning effectiveness, this initiative also promotes Islamic digital literacy and empowers students as content creators for moderate and educational Islamic messages. In conclusion, the strategic integration of social media in PAI learning is a proven innovative approach that should be widely adopted in higher education environments.},
    keywords = {Active learning (machine learning), Content analysis, Digital learning, Digital literacy, Digital media, Educational technology, Experiential learning, Instagram, Islam, Islamic Education, Islamic digital literacy, Islamic education, Lifelong learning, Literacy, Mathematics education, Media literacy, Multimedia, Pedagogy, Psychology, Service (business), Service-learning, Social Media, Social media, Student Engagement, Student engagement, Teaching method, YouTube, digital natives, digitalization of education, higher education, social media in education, student engagement, student motivation},
    url = {https://journal.stikescolumbiasiamdn.ac.id/index.php/Sevaka/article/view/572}

}

@article{itsnarusydianaitsna2025strategi,
    title = {STRATEGI PEDAGOGI KREATIF DALAM MENGHADAPI ZERO ATTENTION SPAN PADA SISWA PENGGUNA TIKTOK DAN REELS: KAJIAN LITERATUR TERHADAP PENDEKATAN PEMBELAJARAN ERA DIGITAL},
    author = {Itsna Rusydiana Itsna},
    howpublished = {Available at https://e-journal.staima-alhikam.ac.id/al-mudarris/article/view/4449 (2025/10/30)},
    journal = {Al-Mudarris: Journal Of Education},
    doi = {10.32478/r3pr4a81},
    publisher = {STAI Mahad Aly Al-Hikam Malang},
    year = {2025},
    pages = {313–350},
    abstract = {The rapid evolution of digital technologies has significantly influenced the way students engage with information, particularly with the widespread use of short video applications such as TikTok and Instagram Reels. These platforms, while offering entertainment and easily digestible content, also contribute to the phenomenon of "zero attention span," wherein students' ability to concentrate on lengthy, complex educational tasks diminishes. This literature review explores the pedagogical strategies that can be employed to address the challenges posed by this phenomenon in the context of modern education. By examining the intersection of digital media consumption and learning behaviors, the study identifies the potential benefits and drawbacks of integrating platforms like TikTok and Instagram Reels into educational practices. The research highlights the importance of utilizing interactive and visually appealing elements within educational content to maintain student engagement and foster deeper learning. Moreover, the review stresses the need for educators to develop curricula that are both adaptive to the digital-native learning style and capable of enhancing cognitive focus and critical thinking. Strategies such as gamification, multimedia use, and interactive videos are proposed as effective tools to capture students' attention while ensuring academic rigor. The findings underscore the necessity of balancing entertainment with educational depth in the digital learning environment. Ultimately, this study provides valuable insights for educators seeking to navigate the complexities of modern attention spans and utilize technology in a manner that enhances, rather than detracts from, educational outcomes.},
    keywords = {Cognition, Cognitive load, Cognitive reframing, Cognitive style, Consumption (sociology), Context (archaeology), Curriculum, Digital content, Digital learning, Digital media, E learning, Educational research, Educational technology, Electronic publishing, Emerging technologies, Entertainment, Experiential learning, Focus (optics), Instagram Reels, Instagram Reels; Education Technology, Intersection (aeronautics), Learning styles, Mathematics education, Multimedia, Pedagogy, Phenomenon, Psychology, Sociology, Style (visual arts), Teaching method, TikTok, Zero Attention Span; Pedagogical Strategies; TikTok, critical thinking, gamification, interactive video, multimedia in education, online learning, short video platforms, student attention, student engagement},
    url = {https://e-journal.staima-alhikam.ac.id/al-mudarris/article/view/4449}

}

@article{drsaimajabeen2025from,
    title = {From Reels to Robots: Exploring the Influence of Social Media on Student Engagement and Interest in STEAM Fields in Pakistan},
    author = {Dr Saima Jabeen},
    howpublished = {Available at https://jssrp.org.pk/index.php/jssrp/article/view/181 (2025/10/22)},
    journal = {Journal of Social Sciences Research \&amp; Policy},
    doi = {10.71327/jssrp.34.207-219},
    publisher = {Global Institute of Social Sciences Research},
    year = {2025},
    pages = {207–207},
    abstract = {In the digital age, social media platforms like YouTube, TikTok, and Instagram have become powerful tools for shaping student perceptions, learning behaviors, and career interests. This research investigates the impact of social media on student engagement and interest in STEAM (Science, Technology, Engineering, Arts, and Mathematics) disciplines among Pakistani students aged 14 to 25. This research employs a mixed-methods approach, integrating quantitative data from online surveys (n=300) with qualitative insights derived from focus group discussions and semi-structured interviews (n=15). The research examines platform preferences, varieties of STEAM content engaged with, and the perceived influence on motivation and career decisions. Initial findings indicate that short-form video content, particularly in local languages and featuring relatable creators, markedly increases student curiosity and engagement in STEAM disciplines. But worries about false information and not enough help still exist. The study seeks to furnish practical insights for educators, content developers, and policymakers to formulate effective digital outreach strategies that advance STEAM education in Pakistan.},
    keywords = {Content analysis, Curiosity, Curriculum, Digital media, Educational technology, Focus group, Higher education, Instagram, Mathematics education, Multimedia, Online presence management, Outreach, Pakistani students, Pedagogy, Political science, Psychology, Public engagement, Public relations, Qualitative analysis, Qualitative property, Qualitative research, STEAM education, Social media, Sociology, Student engagement, TikTok, User engagement, YouTube, career interest, digital outreach, misinformation, science communication, short-form video, social media, student engagement},
    url = {https://jssrp.org.pk/index.php/jssrp/article/view/181}

}

@article{melatipurbabestari2025prediction,
    title = {Prediction of Student Participation in the Library of the University of Muhammadiyah Malang Based on Social Media Activities Using Decision Tree},
    author = {Melati Purba Bestari and Imam Yuadi},
    howpublished = {Available at https://ejournal.undip.ac.id/index.php/lpustaka/article/view/74771 (2025/10/20)},
    journal = {Lentera Pustaka: Jurnal Kajian Ilmu Perpustakaan, Informasi dan Kearsipan},
    doi = {10.14710/lenpust.v11i2.74771},
    publisher = {Library and Information Science Study Program, Faculty of Humanities, Univ. Diponegoro},
    year = {2025},
    pages = {29–42},
    abstract = {Background:  Social media has become an effective tool in promoting library services. This study uses the Decision Tree algorithm to predict student participation in the University of Muhammadiyah Malang library based on their social media activities.   Objective:  The data used included features such as the type of social media (Instagram, TikTok, YouTube, Twitter), the frequency of visits to the library, and the level of social media engagement.   Methods:  The decision tree model is processed using Orange Data Mining, which results in a clear separation between participation and non-participation based on a combination of these features.   Results:  The study results show that social media, especially Instagram and TikTok, significantly influence student participation in the library. The accuracy of the obtained model is about 76.7\%, indicating that decision trees are an effective method for predicting library participation.   Conclusion:  This research provides valuable insights for designing strategies to increase library student engagement based on social media analysis},
    keywords = {Computer science, Data collection, Data science, Decision tree, Decision tree learning, Decision tree model, Instagram, Knowledge management, Mathematics education, Orange (colour), Psychology, Social engagement, Social media, Sociology, Student participation, TikTok, Tree (set theory), academic libraries, decision tree, decision tree prediction, instagram, library marketing, library user engagement, machine learning, social media, social media engagement},
    url = {https://ejournal.undip.ac.id/index.php/lpustaka/article/view/74771}

}

@article{rofiatulmauliddina2025peran,
    title = {Peran Platform Media Sosial dalam Peningkatan Kosakata Bahasa Inggris: Studi Literatur},
    author = {Rofi'atul Mauliddina},
    howpublished = {Available at https://urj.uin-malang.ac.id/index.php/mij/article/download/18541/6502 (2025/10/15)},
    journal = {Maliki Interdisciplinary Journal},
    year = {2025},
    abstract = {This article discusses the role of social media in improving English vocabulary. Using various reliable sources and journals, this article successfully explains how social media can be used effectively to improve English vocabulary among students. In today's digital age, social media platforms such as YouTube, TikTok, Instagram, and others are not only used as a means of entertainment but also as an effective and interesting learning medium. This article employs a literature review method (Library Research) by searching for various journals on Google Scholar or other platforms to establish the theoretical foundation for the topic under discussion. The research findings indicate that social media plays a significant role in enhancing English vocabulary proficiency. Social media also encourages active student engagement and reinforces vocabulary through audio-visual approaches. Platforms like YouTube, TikTok, and Instagram provide authentic, varied, and engaging content. However, their use also faces challenges such as distractions, limited internet access, and the risk of exposure to age-inappropriate content. Therefore, the use of social media in English language learning, particularly for vocabulary enhancement, requires appropriate strategies to support its effectiveness.},
    keywords = {Computer science, Digital media, English as a foreign language, English language, English vocabulary, Entertainment, Foundation (evidence), Instagram, Internet privacy, Multimedia, Psychology, Social media, Sociology, The Internet, TikTok, Vocabulary, World Wide Web, YouTube, audiovisual education, authentic content, internet access barriers, social media, student engagement, vocabulary acquisition},
    url = {https://urj.uin-malang.ac.id/index.php/mij/article/download/18541/6502}

}

@unpublished{ibrahimelassal2025gamifying,
    title = {Gamifying Islamic Archeology through Fantasy football simulation and Interactive Apps to Boost Academic Passion and creative self efficacy},
    author = {Ibrahim Elassal and Mohamed Mohamed Ibrahim Ali Al-Santawi and Mohamed Abdelrahman Abdelmonem Abdelaal and Ahlam Mohamed El-Sayed Abdallah Hindy and Reham Mohamed El-Ghool},
    howpublished = {Available at https://www.researchsquare.com/article/rs-7552816/v1 (2025/10/12)},
    doi = {10.21203/rs.3.rs-7552816/v1},
    year = {2025},
    abstract = {Abstract The research investigates how gamified interactive learning can boost undergraduates’ academic passion and creative self efficacy in the context of Islamic archaeology.  Eighty-one fourth-year students enrolled in the “Islamic Archaeology in Egypt” course at Helwan University’s Faculty of Tourism and Hotels and Misr University for Science and Technology, Faculty of Archaeology and Tourism Guidance participated under the supervision of Dr. Ibrahim Elassal. Employing a quasi-experimental design, the research combined descriptive survey techniques with an applied intervention. The traditional learning experience was transformed into a fantasy football style simulation, augmented by Instagram Reels and TikTok to promote guided discovery and enhance student engagement. Two validated instruments, one assessing academic passion and the other measuring creative self efficacy, were administered post-intervention. The results revealed a statistically significant increase in both academic passion and creative self efficacy. On that basis, the authors advocate for the adoption of similar gamified strategies in other university courses to elevate student motivation, engagement, and creativity. This contribution enriches the field of digital pedagogy and underscores the potential of immersive, game-based learning in heritage education.},
    keywords = {Academic year, Context (archaeology), Creativity, Fantasy, Field research, Football, Heritage tourism, Instagram Reels, Islam, Islamic archaeology, Mathematics education, Passion, Pedagogy, Psychology, Self-efficacy, Sociology, Student engagement, Teaching method, TikTok, Tourism, Visual arts, academic passion, creative self-efficacy, digital pedagogy, game-based learning, gamification, heritage education, interactive applications, student engagement, university students},
    url = {https://www.researchsquare.com/article/rs-7552816/v1},
    note = {Available at https://www.researchsquare.com/article/rs-7552816/v1 (2025/10/12)}

}

@article{marcelafabianarivarola2025transformando,
    title = {Transformando el aula de inglés: el uso de Instagram en el contexto universitario},
    author = {Marcela Fabiana Rivarola and Cecilia Alejandra Aguirre Céliz and Deolinda Yuliana Quiroga},
    howpublished = {Available at https://revistas.unlp.edu.ar/TrayectoriasUniversitarias/article/view/18631 (2025/09/24)},
    journal = {Trayectorias Universitarias},
    doi = {10.24215/24690090e186},
    publisher = {Universidad Nacional de La Plata},
    year = {2025},
    pages = {e186–e186},
    abstract = {El uso de las redes sociales como herramientas de apoyo en los procesos de enseñanza y aprendizaje cada vez cobra mayor popularidad debido a que ofrecen una alternativa innovadora y motivadora para docentes y estudiantes. Este trabajo se enfoca en prácticas tecno-pedagógicas llevadas a cabo a través de la red social Instagram en la asignatura Inglés para las carreras de Abogacía y Tecnicatura en Gestión Financiera de la Facultad de Ciencias Económicas, Jurídicas y Sociales de la Universidad Nacional de San Luis. Elegimos esta red social porque es una plataforma visual altamente popular entre los jóvenes y permite complementar la enseñanza del idioma en un contexto dinámico y atrayente que motiva la participación e interés de los usuarios. El objetivo de este trabajo es comentar acerca de las actividades que se llevaron a cabo a través de Instagram como complemento de las clases de inglés presenciales y conocer y analizar el involucramiento de los estudiantes y sus percepciones acerca de las actividades propuestas.},
    keywords = {Chose, Complement (music), Context (archaeology), English class, English language, English language teaching, Instagram, Media studies, Pedagogy, Perception, Psychology, Public relations, Social Education, Social environment, Social network (sociolinguistics), Social practice, Sociology, Subject (documents), Technician, clase de inglés, financial management students, law students, prácticas tecno-pedagógicas, social networks in education, student engagement, student perceptions, techno-pedagogical practices, universidad, university, university students, visual media in language learning},
    url = {https://revistas.unlp.edu.ar/TrayectoriasUniversitarias/article/view/18631}

}

@article{gyanimalla2025social,
    title = {Social Media Usage Among Students: Engagement and Performance},
    author = {Gyani Malla},
    howpublished = {Available at https://www.nepjol.info/index.php/swarnadwar/article/view/83548 (2025/09/01)},
    journal = {Swarnadwar.},
    doi = {10.3126/swarnadwar.v5i1.83548},
    publisher = {Nepal Journals Online (JOL)},
    year = {2025},
    pages = {52–65},
    abstract = {Social Media (SM) has become integral part of everyone life, it is inevitable in this global era. Influence of social media on everyone’s life can be positive or negative or both that depends on the how much time students spends on social media and for what purpose or activities do they use social medias. This study has set three research objectives: first one is to study which of the channel of social media is most preferred by the students second is to figure out how much time students spend on social media and third is to assess the significance of social media usage on students’ academic and non-academic performance, with a focus on gender differences. The population of this study is students of BBA (Bachelor in Business Administration) and BBM (Bachelor of Business Management) program of different campuses of Bhaktapur district which are running under TU (Tribhuvan University), Nepal. This study has taken 205 respondents for sample from BBA and BBM programs through using Purposive sampling method. Primary data are used and they are collected from well-structured questionnaire that has included close ended and five Likert scale (1=strongly disagree, to 5=Strongly agree) questions to meet the research objectives. Mean, frequency, percentage and t-test are used to analyze the data. This study has found that Instagram is highly preferred social media and highest size of students spent their time more than 7 hours in a day. It has found that most of students have used social medias for non-academic performance. This study has found significant difference between male and female students regarding the use social medias for academic performance, but there is no significance difference between male and female students regarding the use social medias for non- academic performance.},
    keywords = {Academic performance, BBA and BBM Program, Computer science, Instagram, Psychology, Social Media, Social media, Students’ engagement, Tribhuvan University, World Wide Web, academic performance, business administration students, gender differences, social media use, university students},
    url = {https://www.nepjol.info/index.php/swarnadwar/article/view/83548}

}

@article{maryannchinwendirika2025utilization,
    title = {Utilization of Social Media in the Digital Age as Academic Resources Among Biology Education Students' in Abia State, Nigeria},
    author = {Maryann Chinwe Ndirika and Izunna Shedrack Nwuba and Stella C. Obasi},
    howpublished = {Available at https://zenodo.org/records/18921577 (2025/08/31)},
    journal = {Zenodo (CERN European Organization for Nuclear Research)},
    doi = {10.5281/zenodo.18921576},
    year = {2025},
    abstract = {The study investigated the utilization of social media (SM) as academic resources among biology education students in Abia State Universities, adopting a descriptive survey research design. 123 students randomly drawn from, the 1500 biology education students in, the two universities served as the sample. A self-developed Questionnaire, face validated by experts with reliability coefficient of 0.76 established using Cronbach Alpha, was used for data collection. Data collected were analyzed using descriptive statistics and t-test. Results revealed that MOUAU students indicated that Tiktok, Whatsapp and facebook are highly useful SM platforms, Snapchat, Instagram and Youtube are moderately useful, while the other stated SM platforms are just useful. ABSU students, on the other hand, indicated that Whatsapp and Facebook are highly useful, Tiktok and Youtube are moderately useful while Flickr, Tumblr, Spotify, Yelp, TripAdvisor, Angel list and Crunchbase are not useful. For frequency of usage; MOUAU students use Tiktok, Whatsapp and Facebook daily, Snapchat, Instagram, Twitter, Telegram and Youtube several times in a week while other SM platforms are used occasionally. ABSU students indicated that Tiktok and Whatsapp are used daily, Snapchat and facebook, several times a week, Flickr is never used and other platforms are used occasionally. Respondents, from both schools, indicated that Whatsapp and Facebook are utilized (Very High Extent), Tiktok, Snap chat and Youtube (High Extent) and Other SM platforms (Low extent). Also, a non-significant statistical difference was found in the extent of utilization of SM platforms as academic resources between students in the two universities. Recommendations were made among which is the need for educators to incorporate SM platforms usage into their instructional methods to enhance student engagement and academic achievement.},
    keywords = {Abia, Abia State University, Academic Resources, Academic year, Biology Education Students, Cronbach's alpha, Data collection, Descriptive research, Descriptive statistics, Digital Age, Digital media, Educational technology, Face (sociological concept), Facebook, Instant messaging, Medical education, Psychology, Reliability (semiconductor), Significant difference, Social Media, Social media, Sociology, Statistical analysis, The Internet, TikTok, WhatsApp, biology education students, scholarly sources, social media, social media use frequency, social networking sites, student engagement, teaching methods},
    url = {https://zenodo.org/records/18921577}

}

@article{ririkurniawan2025development,
    title = {Development of Physics Learning Media Assisted by Threads Instagram for High School Students},
    author = {Riri Kurniawan and Dzar Fadli El Furqan and Maruf Maruf},
    howpublished = {Available at https://www.macrothink.org/journal/index.php/jet/article/view/22741 (2025/08/25)},
    journal = {Journal of Education and Training},
    doi = {10.5296/jet.v13i1.22741},
    publisher = {Macrothink Institute, Inc.},
    year = {2025},
    pages = {29–29},
    abstract = {Physics learning is often perceived as difficult by students due to limited opportunities to visualize and imagine the concepts being taught, which in turn reduces their engagement and interest in learning. One of the topics that is still delivered using lecture methods and textbooks is optical instruments. Therefore, an innovative learning medium is needed to boost student engagement. This study aims to examine its validity through theoretical and empirical analysis, assess its practicality, and determine its effectiveness.This research is a development study (Research and Development) using the 4-D model, which consists of four stages: define, design, develop, and disseminate. The developed media utilizes the Threads application on Instagram to support physics learning. The research subjects included media expert validators and eleventh-grade students at SMA PGRI Sungguminasa, Gowa Regency, as respondents. Physics learning is often perceived as difficult by students due to limited opportunities to visualize and imagine the concepts being taught, which in turn reduces their engagement and interest in learning. One of the topics that is still commonly delivered through lectures and textbooks is optical instruments. Therefore, an innovative learning medium is needed to enhance student engagement and understanding. In this context, the study aims to examine the validity of the developed media through theoretical and empirical analysis, as well as to assess its practicality and effectiveness in supporting physics learning.The results indicated that the teachers' responses to the developed media reached a score of 80.65\%, falling within the valid and appropriate category for supporting physics instruction. Categorized as practical, while students' responses were 92.54\%, categorized as highly practical. The N-Gain test on student learning outcomes showed a score of 0.85 in the high category, with an effectiveness percentage of 84.96\%, categorized as effective. Thus, the physics learning media using Threads Instagram is proven to be practical and effective as a supporting tool for physics instruction in the classroom.},
    keywords = {Engineering physics, Mathematics education, Physics, Psychology, high school physics, instructional media development, learning outcomes, optical instruments, physics learning media, social media in education, student engagement, validity and practicality},
    url = {https://www.macrothink.org/journal/index.php/jet/article/view/22741}

}

@article{novaagusmulia2025leveraging,
    title = {LEVERAGING INSTAGRAM FOR ELT: A SYSTEMATIC REVIEW},
    author = {Nova Agus Mulia and Zea Jelika Dewanda and Naf’an Tarihoran},
    howpublished = {Available at http://ojs.unm.ac.id/Eliterate/article/view/73766 (2025/08/21)},
    journal = {ELITERATE : Journal of English Linguistics and Literature Studies},
    doi = {10.26858/eliterate.v4i3.73766},
    publisher = {Universitas Negeri Makassar},
    year = {2025},
    pages = {249–249},
    abstract = {Instagram has emerged as a powerful tool in English Language Teaching (ELT), offering multimedia-based interactive learning experiences that enhance student engagement and instructional delivery. This systematic review examines the role of Instagram in ELT, highlighting its advantages, challenges and implications for language learning. Using the PRISMA method, 15 studies from various academic sources, including Google Scholar, and Mendeley, were analyzed. Findings show that Instagram encourages student participation through features such as Stories, Reels, and IGTV, supports peer collaboration, and facilitates formative assessment. However, challenges such as digital distractions, ethical concerns, and accessibility issues remain significant. This study concludes that while Instagram has the potential to revolutionize ELT, a structured implementation strategy is needed to maximize its benefits while overcoming its limitations. Future research should focus on developing best practices for integrating Instagram into the formal ELT curriculum to ensure its effectiveness as an educational tool.},
    keywords = {Audience participation, Best practice, Computer science, Curriculum, Digital media, Discussion board, Engineering ethics, English language, English language teaching, Ethical issues, Focus (optics), Focus group, Formative assessment, Instagram, Instagram Stories and Reels, Knowledge management, Medical education, Pedagogy, Public relations, Social media, Sociology, Student engagement, Systematic review, Target audience, accessibility, digital distraction, ethical considerations, formative assessment, multimedia learning, peer collaboration, social media in language learning, student engagement},
    url = {http://ojs.unm.ac.id/Eliterate/article/view/73766}

}

@article{shafwanaidinalmaarif2025meme,
    title = {MEME SEBAGAI MEDIA PEMBELAJARAN PAI: ANTARA KREATIVITAS DAN HUMANIORA DIGITAL},
    author = {Shafwan Aidinal Ma’arif},
    howpublished = {Available at https://journal.an-nur.org/index.php/annur/article/view/60 (2025/08/17)},
    journal = {AN-NUR: Jurnal Pendidikan dan Pembelajaran},
    doi = {10.65802/an-nur.v1i2.60},
    publisher = {Yayasan An-Nur Meunara Baro},
    year = {2025},
    pages = {342–354},
    abstract = {The development of digital culture presents both challenges and opportunities for innovation in educational media, particularly in the context of Islamic Religious Education (PAI). This article explores the potential of memes as creative and contextual educational tools for conveying Islamic values to the digital generation. Using a qualitative approach and Roland Barthes’ semiotic analysis, the study examines 50 religion-themed memes collected from Instagram, TikTok, and Twitter, supported by interviews with five PAI teachers who have integrated memes into their teaching practices. The findings reveal three key potentials of memes: first, simplifying abstract or complex religious concepts into more digestible content; second, increasing student engagement through visual and humorous approaches; and third, stimulating critical discussion on the interpretation of religious texts in contemporary contexts. Nevertheless, the use of memes also carries risks, such as excessive simplification of Islamic values, content that may offend the sanctity of religious symbols, and a generational gap in media literacy between teachers (digital immigrants) and students (digital natives). Therefore, the implementation of ethical frameworks and digital literacy strategies in Islamic education is essential, including teacher training and the development of an educational meme repository grounded in wasathiyah (moderate) Islamic values. Through a digital humanities lens, memes can serve not merely as entertainment, but as creative, reflective, and transformative pedagogical bridges.},
    keywords = {Content analysis, Context (archaeology), Critical literacy, Digital literacy, Digital media, E learning, Epistemology, Grounded theory, Instagram, Interpretation (philosophy), Islam, Islamic education, Key (lock), Literacy, Mathematics education, Media literacy, New media, Pedagogy, Perspective (graphical), Psychology, Qualitative research, Religious education, Semiotics, Social semiotics, Sociology, Teacher education, Teaching method, TikTok, Transformative learning, Twitter, Visual literacy, digital culture, digital humanities, digital literacy, instructional media, intergenerational differences, memes, religious moderation, religious semiotics, religious symbols, student engagement, teacher professional development},
    url = {https://journal.an-nur.org/index.php/annur/article/view/60}

}

@article{sitirifatulmilah2025the,
    title = {The Role of Short Videos on Social Media in Increasing Interest in Learning Arabic Among Generation Z: Opportunities and Challenges},
    author = {Siti Rifatul Milah and Siti Mufidatul Azizah and Raudina Rihhadatul ‘Aisy},
    howpublished = {Available at https://ejournal.uin-malang.ac.id/index.php/kitaba/article/view/33246 (2025/08/16)},
    journal = {Kitaba},
    doi = {10.18860/kitaba.v3i2.33246},
    publisher = {Maulana Malik Ibrahim State Islamic University},
    year = {2025},
    pages = {57–65},
    abstract = {The integration of social media into Arabic language learning has become a significant trend in the digital era, particularly among Generation Z, who have grown up as digital natives. This article examines the role of short-form videos on social media platforms—specifically TikTok, Instagram, and YouTube—in enhancing students’ interest in learning Arabic, while identifying the accompanying pedagogical opportunities and challenges. The study employs a Systematic Literature Review (SLR) method based on the PRISMA framework, analyzing 18 scientific studies published between 2019 and 2024 sourced from Google Scholar, ERIC, and DOAJ databases. Data were analyzed thematically to identify patterns of effectiveness, student engagement, and pedagogical implications. The findings indicate that short-form videos on social media significantly increase learning interest through visually engaging, interactive, and contextual content delivery. TikTok excels in fostering creative engagement and active participation, YouTube supports self-directed learning and flexible access, while Instagram proves effective in vocabulary acquisition through visual representation. However, implementation faces serious challenges, including distractions from entertainment content, inconsistent quality of educational materials, privacy risks, and the emergence of a "digital empathy gap." Furthermore, the limited availability of content that promotes spiritual and character development remains a significant drawback. This article provides a comprehensive conceptual map and concrete pedagogical recommendations for educators, researchers, and developers of digital learning media. The findings affirm that social media is not merely a cognitive tool, but also holds potential for socio-spiritual transformation when used strategically.},
    keywords = {Arabic, Arabic language learning, Computer science, Generation Z, Instagram, Linguistics, Philosophy, Political science, Psychology, Social media, Sociology, TikTok, World Wide Web, YouTube, character development, digital learning media, privacy risks, short-form video, social media, student engagement, student interest, vocabulary acquisition},
    url = {https://ejournal.uin-malang.ac.id/index.php/kitaba/article/view/33246}

}

@article{irmanurhasanah2025استفادة,
    title = {استفادة الإنستجرام كوسيلة تعليمية في تعلم المفردات لدى طلاب الصف الثامن بالمدرسة الإسلامية بيضاء الأحكام بيريوك مدينة تانجيرانج},
    author = {Irma Nurhasanah and Moh. As'ad Thoha and Nasrullah Nasrullah},
    howpublished = {Available at https://journal.minhajpustaka.id/index.php/intifa/article/view/197 (2025/08/12)},
    journal = {INTIFA: Journal of Education and Language},
    doi = {10.62083/intifa.v1i3.197},
    publisher = {CV. Minhaj Pustaka},
    year = {2025},
    abstract = {ABSTRACTArabic language learning in schools is often perceived as difficult and less engaging by students. One of the main reasons for this is the limited use of innovative instructional media that align with the advancements of the times. In today’s digital era, social media presents a promising opportunity that can be leveraged as an effective and engaging educational tool. Among the most popular platforms among students is Instagram. Accordingly, this study focuses on Arabic language education, particularly in the area of vocabulary acquisition (mufradat), with the aim of exploring how Instagram can be utilized to support the learning process of eighth-grade students at SMP Islam Baidhaul Ahkam in Tangerang City. It also seeks to identify Instagram’s features that contribute to increasing student engagement and improving learning outcomes.This research adopts a qualitative descriptive approach, employing data collection techniques such as observation, interviews, documentation, and tests using the polling feature in Instagram Stories. The findings reveal that students showed greater interest and became more actively involved in the learning process. The average student score increased from 33.63\% to 90.91\% after using Instagram as a learning medium. Furthermore, features such as feed posts, short videos (reels), and stories proved to be effective in delivering content visually and attractively. ملخّص البحثيعد تعليم اللغة العربية في المدارس غالبا صعب الفهم وقليل الجاذبية بالنسبة للطلاب، ومن أبرز أسبابه قلة استخدام الوسائل التعليمية المبتكرة التي تواكب تطور العصر. وفي هذا العصر الرقمي، أصبحت وسائل التواصل الاجتماعي فرصة واعدة يمكن استغلالها كوسيلة تعليمية فعالة وجذابة. وتعد منصة إنستجرام من أشهر هذه الوسائل لدى فئة الطلاب. لذلك، يركز هذا البحث على تعليم اللغة العربية، وبشكل خاص على جانب المفردات، بهدف معرفة كيفية توظيف إنستجرام لدعم عملية التعلم لدى طلاب الصف الثامن في المدرسة الإسلامية بيضاء الأحكام بمدينة تانجيرانج، بالإضافة إلى تحديد الخصائص التي تسهم في تعزيز الاهتمام والنتائج التعليمية. يعتمد هذا البحث على المنهج الوصفي النوعي، باستخدام تقنيات الملاحظة، والمقابلة، والتوثيق، والاختبار من خلال خاصية الاستطلاع (Polling) في قصص إنستجرام. وقد أظهرت نتائج البحث أن الطلاب أصبحوا أكثر اهتماما وتفاعلا خلال عملية التعلم. وقد ارتفع متوسط درجات الطلاب من ‎\%33.63 إلى ‎\%90.91 بعد استخدام إنستجرام كوسيلة تعليمية. كما تبين أن خصائص النشر (Feed)، والمقاطع القصيرة (Reels)، والقصص (Stories) فعالة في تقديم المحتوى بشكل بصري وجذاب.},
    keywords = {Arabic, Arabic Language Learning Media, Arabic as a foreign language, Arabic language learning, Computer science, Data collection, Digital learning, Digital media, Educational technology, Feature (linguistics), Instagram, Instagram Stories, Language acquisition, Mathematics education, Mufradat, Multimedia, Pedagogy, Polling, Process (computing), Psychology, Qualitative property, Qualitative research, Reading (process), Second language, Social media, Tangerang City, Vocabulary, digital learning tools, eighth grade students, instructional media, learning outcomes, madrasah tsanawiyah, social media in education, student engagement, vocabulary acquisition},
    url = {https://journal.minhajpustaka.id/index.php/intifa/article/view/197}

}

@article{profndirikamaryannc2025utilization,
    title = {UTILIZATION OF SOCIAL MEDIA IN THE DIGITAL AGE AS ACADEMIC RESOURCES AMONG BIOLOGY EDUCATION STUDENTS IN ABIA STATE, NIGERIA},
    author = {Prof. Ndirika Maryann C. and Izunna Shedrack Nwuba and Prof. Obasi Stella C.},
    howpublished = {Available at https://journals.unizik.edu.ng/index/article/view/6565 (2025/08/05)},
    journal = {UNIZIK Journal of STM Education},
    year = {2025},
    abstract = {The study investigated the utilization of social media (SM) as academic resources among Biology education students in Abia State Universities, adopting a descriptive survey research design. 123 students randomly drawn from, the 1500 biology education students in, the two universities served as the sample. A self-developed Questionnaire, face validated by experts with reliability coefficient of 0.76 established using Cronbach Alpha, was used for data collection. Data collected were analyzed using descriptive statistics and t-test for significant difference. Results revealed that MOUAU students indicated that Tiktok, Whatsapp and facebook are highly useful SM platforms, Snapchat, Instagram and Youtube are moderately useful, while the other stated SM platforms are just useful. ABSU students, on the other hand, indicated that Whatsapp and Facebook are highly useful, Tiktok and Youtube are moderately useful while Flickr, Tumblr, Spotify, Yelp, TripAdvisor, Angel list and Crunchbase are not useful. For frequency of usage; MOUAU students use Tiktok, Whatsapp and Facebook daily, Snapchat, Instagram, Twitter, Telegram and Youtube several times in a week while other SM platforms are used occasionally. ABSU students indicated that Tiktok and Whatsapp are used daily, Snapchat and facebook, several times a week, Flickr is never used and other platforms are used occasionally. Respondents, from both schools, indicated that Whatsapp and Facebook are utilized (Very High Extent), Tiktok, Snap chat and Youtube (High Extent) and Other SM platforms (Low extent). Also, a non-significant statistical difference was found in the extent of utilization of SM platforms as academic resources between students in the two universities. Recommendations were made among which is the need for educators to incorporate SM platforms usage into their instructional methods to enhance student engagement and academic achievement.},
    keywords = {Abia, Abia State University, Academic year, Computer science, Cronbach's alpha, Data collection, Descriptive research, Descriptive statistics, Digital media, Educational technology, Face (sociological concept), Facebook, Instant messaging, Mathematics education, Medical education, Psychology, Reliability (semiconductor), Significant difference, Social media, Sociology, Statistical analysis, The Internet, TikTok, WhatsApp, biology education students, scholarly sources, social media, social networking sites, student engagement, teaching methods, usage frequency},
    url = {https://journals.unizik.edu.ng/index/article/view/6565}

}

